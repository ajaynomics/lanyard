<% content_for :title, "Sign in" %>

<section class="sign-in">
  <img src="/icons/app.svg" alt="" class="sign-in__mark" width="64" height="64">
  <h1><%= app_name %></h1>
  <% if DurableAssistants::Oidc.configured? %>
    <p>Signing in to the app. When you are done, you go back to it.</p>
    <%# Straight on to the provider, as the button would: OmniAuth's forgery check still applies, and passes as for the button.
        In development a person chooses, as the development sign-in is offered too. -%>
    <%= button_to "Continue with #{DurableAssistants::Oidc.label}", ajent_auth_path, data: { turbo: false }, class: "button",
          form: { data: { controller: ("auto-submit" unless Rails.env.development?) } } %>
  <% elsif !Rails.env.development? %>
    <p>Sign-in is not set up here, so nobody can get in.</p>
  <% end %>
  <% if Rails.env.development? %>
    <%= button_to "Sign in as a local developer", development_session_path, data: { turbo: false, variant: "outline" }, class: "button" %>
  <% end %>
</section>
