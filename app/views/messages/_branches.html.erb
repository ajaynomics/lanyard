<%# Branches already taken after this message, linked to the tree. Always shown, unlike the actions. -%>
<%# locals: (message:) -%>
<% if (count = message.conversation.branch_counts[message.entry_id]) %>
  <%= link_to "#{pluralize(count, "branch")} from here", conversation_tree_path(message.conversation), class: "message__branches" %>
<% end %>
