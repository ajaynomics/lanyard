<% content_for :title, "Agents" %>
<% content_for :head, stylesheet_link_tag("list") %>
<%= turbo_stream_from Current.user, :conversations %>

<section class="page">
  <header class="page__header">
    <h1>Agents</h1>
    <div class="page__actions">
      <%= link_to "Connectors", connectors_path, class: "button", data: { variant: "ghost" } %>
      <%= link_to "New agent", new_agent_path, id: "new_agent", class: "button" %>
    </div>
  </header>

  <%= render "conversations/filters", list: @list %>

  <%# Thirty at a time. Each page ends with a frame that loads the next as it scrolls into view. -%>
  <%# Live, a changed row takes its place (sidebar_order_controller); a new agent joins only the list of every active one. -%>
  <% live = @list[:filter].in?([ nil, "", "active" ]) && @list[:q].blank? %>
  <div id="conversations" class="conversation-list" data-controller="list-nav sidebar-order" data-action="keydown->list-nav#move <%= sidebar_order_actions %>"
       data-sidebar-order-sorted-value="<%= live && @list[:sort].in?([ nil, "", "recent" ]) %>">
    <%= turbo_frame_tag "conversations_page_#{@page.number}", target: "_top" do %>
      <% if @conversations.any? %>
        <%= tag.ul class: "conversation-list__page", id: ("agents_list" if live && @page.first?), data: { sidebar_order_target: ("list" if @page.first?) } do %>
          <%= render partial: "conversations/conversation", collection: @conversations, as: :conversation %>
        <% end %>
        <% unless @page.last? %>
          <%= turbo_frame_tag "conversations_page_#{@page.next_param}", target: "_top", loading: :lazy,
                src: conversations_path(@list.merge(page: @page.next_param)) do %>
            <%= render "ui/skeleton", label: "Loading more agents" %>
          <% end %>
        <% end %>
      <% elsif @page.first? %>
        <%= render "conversations/empty_list", list: @list %>
      <% end %>
    <% end %>
  </div>
</section>
