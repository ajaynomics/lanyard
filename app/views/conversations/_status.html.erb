<%# locals: (conversation:) -%>
<%# What needs the person: waiting on them, or why a run stopped. While the agent works the header says nothing:
    the typing dots and the composer's stop square say it (the composer reads data-status, layout.css). -%>
<div id="<%= dom_id(conversation, :status) %>" class="chat__status" data-status="<%= conversation.status %>">
  <% case conversation.status %>
  <% when "waiting" %>
    <span class="chat__status-text">Waiting for you</span>
    <%= button_to "Stop", conversation_cancellations_path(conversation), params: { request_id: SecureRandom.uuid },
          class: "button", data: { variant: "outline", size: "sm" }, form_class: "inline", id: "stop" %>
  <% when "error" %>
    <span class="chat__status-text">Stopped<%= ": #{failure_text(conversation.failure)}" if conversation.failure.present? %></span>
  <% end %>
</div>
