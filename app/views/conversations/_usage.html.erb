<%# What the whole conversation has used, as of the end of its last run (Conversation#receive_frame),
    and how full the model's context is before the sidecar summarises it. -%>
<%# locals: (conversation:) -%>
<div id="<%= dom_id(conversation, :usage) %>" class="chat__usage">
  <% if (usage = conversation.usage).present? && usage["totalTokens"].to_i.positive? %>
    <p>
      This conversation: <%= number_with_delimiter(usage["totalTokens"]) %> tokens<% if usage["cost"] %>, <%= usage_cost(usage["cost"]) %> at API prices<% end %>.
      <% if usage["cost"] %>An estimate: an API key is billed at these prices; a subscription is not billed per token.<% end %>
    </p>
  <% end %>
  <% if (meter = context_meter(conversation)) %>
    <p class="chat__context" title="When the conversation reaches this size, earlier messages are summarised so it can go on."><%= meter %></p>
  <% end %>
  <% if (bytes = conversation.notes_file_bytes) %>
    <p class="chat__notes"><%= notes_file_line(bytes) %></p>
  <% end %>
</div>
