<% content_for :title, "Tools · #{@agent.name}" %>
<%= turbo_stream_from Current.user, :connectors %>

<header class="settings__header"><h1>Tools</h1></header>
<%= render "agents/cache_warning", agent: @agent %>

<%# What it wants to carry at the start, before loading any searched tools. -%>
<% count = @agent.tool_count %>
<% core_ids = @agent.core_server_ids %>
<% level = count > Agent::TOOL_LIMIT ? "over" : count >= Agent::TOOL_WARNING ? "near" : "ok" %>
<section class="ui-group" id="tool_meter">
  <div class="ui-meter" data-level="<%= level %>">
    <span class="ui-meter__label" id="tool_meter_label"><%= count %> of <%= Agent::TOOL_LIMIT %> tools</span>
    <span class="ui-meter__bar" role="meter" aria-valuemin="0" aria-valuemax="<%= Agent::TOOL_LIMIT %>" aria-valuenow="<%= [ count, Agent::TOOL_LIMIT ].min %>"
          aria-labelledby="tool_meter_label" style="--value: <%= [ count * 100 / Agent::TOOL_LIMIT, 100 ].min %>%"></span>
  </div>
  <p class="ui-group__help">
    <% if level == "ok" %>
      An agent starts with up to <%= Agent::TOOL_LIMIT %> tools, those it brings itself among them. That leaves room to load more during a conversation.
      Only a core connector's tools count; any number looked up count as one, tool_search.
    <% else %>
      <% biggest = @connectors.select { @agent.core?(it, core_ids) }.reject(&:needs_sign_in?).max_by { it.tool_classes.size } %>
      <strong><%= level == "over" ? "Over the limit." : "Close to the limit." %></strong>
      <% if level == "over" %>Tools that don't fit are looked up instead.<% end %>
      <% if biggest %>
        Make <%= link_to biggest.name, biggest.conversation ? conversation_connectors_path(biggest.conversation) : "##{dom_id(biggest, :tools)}" %>
        (<%= pluralize(biggest.tool_classes.size, "tool") %>) looked up rather than core, or turn tools off below.
      <% else %>
        Turn tools off below.
      <% end %>
    <% end %>
  </p>
</section>

<div class="settings__search" data-controller="search-list" data-action="turbo:morph@document->search-list#apply">
  <div class="field">
    <label for="tools_filter" class="visually-hidden">Search <%= @agent.name %>'s tools</label>
    <input type="search" id="tools_filter" class="input" placeholder="Search tools" autocomplete="off"
           data-search-list-target="query" data-action="input->search-list#apply" data-turbo-permanent>
  </div>

  <section class="ui-group" data-search-list-target="group" aria-labelledby="tools_built_in">
    <h2 class="ui-group__title" id="tools_built_in">Built in</h2>
    <ul class="ui-group__rows">
      <% Tool::Catalog::TOOLS.each_value.select { it.available_to?(@agent) }.each do |tool| %>
        <%= render "agents/tools/switch", agent: @agent, name: tool.tool_name,
              on: @agent.tool_names.include?(tool.tool_name) && !@agent.tool_off?(tool.tool_name), label: tool.label,
              search: "#{tool.label} #{tool.description}", detail: [ tool.description, ("Asks you first." if tool.asks) ].compact.join(" ") %>
      <% end %>
      <% (Tool::Catalog::CANVAS + (Tool::Catalog::EMAIL if @agent.sends_email?).to_a).each do |tool| %>
        <%= render "agents/tools/switch", agent: @agent, name: tool.tool_name,
              on: !@agent.tool_off?(tool.tool_name), label: tool.label, search: "#{tool.label} #{tool.description}",
              detail: tool.description.truncate(160) %>
      <% end %>
      <% Agent.capability_names.each do |capability| %>
        <% label, description = Agent::CAPABILITY_DESCRIPTIONS.fetch(capability, [ capability.humanize, nil ]) %>
        <%= render "settings/switch_row", id: "tool_#{capability}", url: agent_tool_path(@agent, capability),
              on: @agent.capabilities.include?(capability), label: label, detail: description, search: "#{label} #{description}" %>
      <% end %>
      <% (@agent.available_own_tools - Tool::Catalog::TOOLS.values - Tool::Catalog::CANVAS - Tool::Catalog::EMAIL).each do |tool| %>
        <% if @agent.workspace.tool_off?(tool.tool_name) %>
          <%= render "agents/tools/switch", agent: @agent, name: tool.tool_name, on: false, label: tool.label,
                search: "#{tool.label} #{tool.description}", detail: tool.description.truncate(160) %>
        <% elsif !@agent.tool_off?(tool.tool_name) %>
          <li class="ui-row" data-search-list-target="item" data-search="<%= tool.label %> <%= tool.description %>">
            <span class="ui-row__label"><%= tool.label %>
              <span class="ui-row__detail"><%= tool.description.truncate(160) %><%= " Asks you first." if tool.asks %></span></span>
            <span class="ui-row__value ui-row__note">Always on</span>
          </li>
        <% end %>
      <% end %>
    </ul>
    <p class="ui-group__help">"Always on" comes with every agent, or with a channel it is on.</p>
  </section>

  <% @connectors.each do |connector| %>
    <% page = connector.conversation ? conversation_connectors_path(connector.conversation) : connector_path(connector) %>
    <%# Signed out, its tools are offered to no agent (Agent#tools): greyed, with the Sign in that brings them back. -%>
    <% signed_out = connector.needs_sign_in? %>
    <section class="ui-group" data-search-list-target="group" aria-labelledby="<%= dom_id(connector, :tools) %>">
      <div class="ui-group__title">
        <h2 id="<%= dom_id(connector, :tools) %>"><%= link_to connector.name, page %> <%= connector_status connector, @agent.conversation %></h2>
        <%= render "connectors/fix", connector: connector, conversation: @agent.conversation %>
      </div>
      <ul class="ui-group__rows">
        <% core = @agent.core?(connector, core_ids) %>
        <% if connector.conversation_id.nil? %>
          <%# Core or looked up, for this agent alone (Agent::CoreConnector); an office connector the install decides for has no switch. -%>
          <% fixed = connector.install_entry&.key?(:loaded) %>
          <%= render "settings/switch_row", id: dom_id(connector, :core), url: agent_core_connector_path(@agent, connector), on: core, disabled: fixed,
                note: ("Set by the install" if fixed), label: "Core for #{@agent.name}", search: "#{connector.name} core lookup",
                detail: (core ? "Its tools are in every message #{@agent.name} reads." : "Looked up when needed: #{@agent.name} finds its tools first, which saves room.") %>
        <% end %>
        <% connector.listed_tools.each do |tool| %>
          <% everyone_off = connector.tool_off?(tool.listing["name"]) %>
          <%= render "agents/tools/switch", agent: @agent, name: tool.tool_name,
                on: !everyone_off && !@agent.tool_off?(tool.tool_name), disabled: everyone_off || signed_out, unavailable: signed_out,
                note: (if signed_out then "Needs sign-in"
                       elsif everyone_off then "Off for every agent"
                       elsif @agent.tool_off?(tool.tool_name) then "Off for #{@agent.name} only"
                       end),
                label: tool.listing["name"], search: "#{tool.listing["name"]} #{connector.name} #{tool.description}",
                detail: [ tool.description.truncate(160), (tool.asks ? "Asks you first." : "Runs at once.") ].join(" ") %>
        <% end %>
        <% if connector.listed_tools.none? %>
          <li class="ui-row"><span class="ui-row__label ui-row__detail"><%= if signed_out then "Sign in to list its tools."
            elsif connector.refreshing? then "Listing its tools…" else "It offers no tools." end %></span></li>
        <% end %>
      </ul>
      <p class="ui-group__help">
        <%= "#{@agent.name} gets these once you sign in." if signed_out %>
        <% if connector.conversation_id %>
          <%= core ? "Core: every message carries its tools." : "Looked up when needed: #{@agent.name} searches its tools, which saves room." %>
        <% end %>
        A switch here is for <%= @agent.name %> only; <%= link_to "its page", page %> turns a tool off for every agent.
      </p>
    </section>
  <% end %>

  <%# Tools looked up: how it reaches them, and the connectors that moved there by themselves. -%>
  <section class="ui-group" data-search-list-target="group" aria-labelledby="tools_lookup" id="tools_lookup_group">
    <h2 class="ui-group__title" id="tools_lookup">Looked up</h2>
    <ul class="ui-group__rows">
      <% @agent.connector_moves.newest_first.includes(:mcp_server).limit(10).each do |move| %>
        <li class="ui-row" data-search-list-target="item" data-search="<%= move.connector_name %> moved lookup">
          <span class="ui-row__label">
            <%= move.mcp_server ? link_to(move.connector_name, "##{dom_id(move.mcp_server, :tools)}") : move.connector_name %> moved to looked up
            <span class="ui-row__detail"><%= move.reason %></span>
          </span>
          <span class="ui-row__value ui-row__note"><%= time_tag move.created_at, l(move.created_at.in_time_zone(@agent.time_zone), format: :short) %></span>
        </li>
      <% end %>
    </ul>
    <p class="ui-group__help">
      <%= @agent.name %> finds a looked-up connector's tools with tool_search and calls them by name<%= ", or from a script" if @agent.codemode? %>,
      with the same approvals and switches as its own.
      A connector that no longer fits beside its other tools moves here by itself, for <%= @agent.name %> only, and is listed above.
    </p>
  </section>

  <section class="ui-group" data-search-list-target="group" aria-labelledby="tools_skills">
    <h2 class="ui-group__title" id="tools_skills">Skills</h2>
    <ul class="ui-group__rows">
      <% @agent.skills.each do |skill| %>
        <li class="ui-row" data-search-list-target="item" data-search="<%= skill.name %> <%= skill.description %>">
          <span class="ui-row__label"><%= skill.name %><span class="ui-row__detail"><%= skill.description.truncate(160) %></span></span>
          <span class="ui-row__value ui-row__note"><%= skill.ready? ? "Read when needed" : skill_state(skill) %></span>
        </li>
      <% end %>
    </ul>
    <% if @agent.skills.none? %>
      <p class="ui-group__help">No skills yet. <%= link_to "Add a skill", new_agent_skill_path(@agent) %> to teach <%= @agent.name %> how to do something.</p>
    <% else %>
      <p class="ui-group__help"><%= link_to "Skills", agent_skills_path(@agent) %> are instructions it opens when a task calls for one.</p>
    <% end %>
  </section>
  <p class="muted" data-search-list-target="empty" hidden>No tools match.</p>
</div>

<p class="muted">
  <%= link_to "Connectors", workspace_connectors_path(@agent.workspace) %> are for every agent; <%= link_to "#{@agent.name}'s own connectors", conversation_connectors_path(@agent.conversation) %>
  add to these or switch one off for it.
</p>
