<% content_for :title, @conversation %>
<% content_for :back, link_to("‹ #{@bot}", bot_conversations_path(@bot), class: "app-header__back") %>

<%= turbo_stream_from @conversation %>
<div class="chat" data-controller="message-scroller stream-guard">
  <header class="chat__header">
    <h1 class="chat__title"><%= @conversation %></h1>
    <%= render "conversations/status", conversation: @conversation %>
  </header>

  <div class="chat__viewport" role="log" aria-live="polite" data-message-scroller-target="viewport">
    <div id="messages" class="chat__messages">
      <% if @messages.empty? %>
        <%= render "ui/marker", variant: :separator, class: "chat__empty" do %>Say hello to <%= @bot %>.<% end %>
      <% end %>
      <%= render partial: "messages/message", collection: @messages, as: :message %>
    </div>
    <%= render "conversations/live", conversation: @conversation %>
  </div>

  <button type="button" class="chat__jump button" data-variant="outline" data-size="sm" hidden
          data-message-scroller-target="jump" data-action="message-scroller#jump">Jump to latest</button>

  <%= render "conversations/composer", conversation: @conversation %>
</div>
