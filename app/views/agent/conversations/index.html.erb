<% content_for :title, "Agent conversations" %>

<h1>Agent conversations</h1>

<%= button_to "New conversation", workspace_agent_conversations_path(@access.workspace_id),
      params: { request_id: SecureRandom.uuid }, id: "new_agent_conversation" %>

<ul id="agent_conversations">
  <% @conversations.each do |conversation| %>
    <li><%= link_to "Conversation #{conversation.id}", workspace_agent_conversation_path(@access.workspace_id, conversation) %></li>
  <% end %>
</ul>
