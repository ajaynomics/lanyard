<%# One workspace in the agents list (Workspace::Group), in the index and beside a thread: its name, a link to its page,
    whose it is, how many cards wait there and its menu, then its agents' rows. Each group is live on its own
    workspace's stream, and keeps its rows in order by itself (sidebar_order_controller). -%>
<%# locals: (group:, list: {}, current: nil) -%>
<% workspace = group.workspace %>
<%= tag.section class: "agent-group", id: dom_id(workspace, :group), aria: { labelledby: dom_id(workspace, :group_title) },
      data: { controller: "reporting-tree", reporting_tree_url_value: conversations_path(list.merge(workspace_id: workspace.id)) } do %>
  <%= turbo_stream_from workspace, :conversations, channel: WorkspaceStreamsChannel %>
  <h2 class="agent-group__title" id="<%= dom_id(workspace, :group_title) %>">
    <% own_list = list.key?(:lens) && workspace.personal? %>
    <%= link_to (own_list ? "Yours" : workspace), workspace_path(workspace), class: "agent-group__name", title: "#{workspace} settings" %>
    <%# One piece that never wraps, so a long name gives way to it rather than the counts breaking across lines (#267). -%>
    <span class="agent-group__counts">
      <% unless own_list %><span class="agent-group__detail"><%= workspace.personal? ? "Yours" : pluralize(workspace.memberships.size, "person") %></span><% end %>
      <%= tag.span "#{group.waiting} waiting", class: "conversation-row__badge agent-group__waiting" if group.waiting.positive? %>
    </span>
    <%= tag.button type: "button", class: "button agent-group__more", popovertarget: dom_id(workspace, :menu), style: "anchor-name: --#{dom_id(workspace)}",
          data: { variant: "ghost", size: "icon" }, aria: { label: "#{workspace} menu" }, title: "#{workspace}: new agent, connectors, helpers" do %>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
    <% end %>
  </h2>
  <%# Keep each link scoped to this workspace, regardless of which was used last. -%>
  <%= tag.div class: "chat__actions", id: dom_id(workspace, :menu), popover: "auto", style: "position-anchor: --#{dom_id(workspace)}",
        aria: { label: "#{workspace} menu" } do %>
    <div class="chat__actions-group">
      <%= link_to "New agent here", new_agent_path(workspace_id: workspace.id), class: "button", data: { variant: "outline", size: "sm" } %>
      <%= link_to "Connectors", workspace_connectors_path(workspace), class: "button", data: { variant: "outline", size: "sm" } %>
      <%= link_to "Helpers", workspace_helpers_path(workspace), class: "button", data: { variant: "outline", size: "sm" } %>
      <% if workspace.invites_from?(Current.user) %>
        <%= link_to "Invite people…", workspace_path(workspace, anchor: "invitations_title"), class: "button", data: { variant: "outline", size: "sm" } %>
      <% end %>
      <%= link_to "Workspace settings", workspace_path(workspace), class: "button", data: { variant: "outline", size: "sm" } %>
    </div>
    <button type="button" class="button chat__actions-cancel" popovertarget="<%= dom_id(workspace, :menu) %>" popovertargetaction="hide">Cancel</button>
  <% end %>
  <%= tag.div id: dom_id(workspace, :tree_revision), hidden: true %>
  <div class="conversation-list" data-controller="sidebar-order" data-action="<%= sidebar_order_actions %>"
       data-sidebar-order-sorted-value="<%= group.sorted? %>">
    <%= render "conversations/tree", group: group, list: list, current: current %>
  </div>
<% end %>
