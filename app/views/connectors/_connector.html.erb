<%# locals: (connector:, conversation: nil) -%>
<%# On a conversation's page, one of the person's connectors may be replaced or switched off by the conversation's own entry. -%>
<% override = conversation && connector.conversation_id.nil? ? conversation.mcp_servers.find { it.name == connector.name } : nil %>
<article id="<%= dom_id(connector) %>" class="mcp-server">
  <header class="mcp-server__header">
    <span><strong><%= connector.name %></strong> <span class="muted"><%= connector.command? ? [ connector.command, *connector.args ].join(" ").truncate(120) : connector.url %></span></span>
    <span>
      <% if override %>
        <% if !override.switch_off? %>
          <span class="muted">This agent uses its own <%= connector.name %>.</span>
        <% else %>
          <span class="muted">Off for this agent.</span>
          <%= button_to "Switch back on", connector_path(override), method: :delete, class: "button", data: { variant: "outline", size: "sm" }, form_class: "inline" %>
        <% end %>
      <% elsif connector.gmail_grant? %>
        <% if connector.gmail_grant_owner?(Current.user) %>
          <% if connector.gmail_grant["revoked_at"] %>
            <%= button_to "Remove", connector_path(connector), method: :delete, class: "button", data: { variant: "ghost", size: "sm" }, form_class: "inline" %>
          <% else %>
            <%= button_to "Revoke Gmail access", connector_sign_in_path(connector), method: :delete, class: "button",
                  data: { variant: "outline", size: "sm" }, form_class: "inline" %>
          <% end %>
        <% end %>
      <% else %>
        <% if connector.signed_in? %>
          <span class="muted">Signed in <%= l connector.signed_in_at.to_date, format: :long %> ·</span>
          <%= button_to "Sign out", connector_sign_in_path(connector), method: :delete, class: "button", data: { variant: "ghost", size: "sm" }, form_class: "inline" %>
        <% end %>
        <% unless conversation && connector.conversation_id.nil? %>
          <%= button_to connector.enabled? ? "Turn off" : "Turn on", connector_path(connector), method: :patch, params: { connector: { enabled: !connector.enabled? } },
                class: "button", data: { variant: "outline", size: "sm" }, form_class: "inline" %>
        <% end %>
        <%# Only a conversation's own: a person's is core or looked up for each agent, on its Tools. -%>
        <% if connector.conversation_id %>
          <%= button_to connector.loaded? ? "Look up when needed" : "Make always ready", connector_path(connector), method: :patch,
                params: { connector: { loaded: !connector.loaded? } }, class: "button", data: { variant: "outline", size: "sm" }, form_class: "inline" %>
        <% end %>
        <% if McpClientSecretSetup.may_issue?(connector, by: Current.user) %>
          <%= button_to "Set client secret", connector_client_secret_setup_path(connector), class: "button",
                data: { variant: "outline", size: "sm" }, form_class: "inline", form: { data: { turbo: false } } %>
        <% end %>
        <% if (conversation || !connector.command?) && connector.status(conversation) != "failing" %>
          <%= button_to "Refresh tools", connector_refresh_path(connector), params: { conversation_id: conversation&.id }.compact,
                class: "button", data: { variant: "outline", size: "sm" }, form_class: "inline" %>
        <% end %>
        <% if conversation && connector.conversation_id.nil? %>
          <%= button_to "Switch off for this agent", connectors_path, params: { workspace_id: Current.workspace.id, connector: { name: connector.name, enabled: false, conversation_id: conversation.id } },
                class: "button", data: { variant: "ghost", size: "sm" }, form_class: "inline" %>
        <% elsif connector.install %>
          <span class="muted">The install's.</span>
        <% else %>
          <%= button_to "Remove", connector_path(connector), method: :delete, class: "button",
                data: { variant: "ghost", size: "sm", turbo_confirm: "Remove #{connector.name}? Its tools go from the next message." }, form_class: "inline" %>
        <% end %>
      <% end %>
    </span>
  </header>
  <% unless override %>
    <% if connector.gmail_grant? %>
      <%= render "connectors/gmail_grant", connector: connector %>
    <% else %>
      <p class="connector-status"><%= connector_status connector, conversation %><%= render "connectors/fix", connector: connector, conversation: conversation %></p>
    <% end %>
    <% if GoogleAccountStart.may_issue?(connector, by: Current.user) %>
      <%= form_with url: connector_google_account_start_path(connector), namespace: dom_id(connector), class: "field", data: { turbo: false } do |form| %>
        <%= form.label :expected_email, "Expected Google account email" %>
        <%= form.email_field :expected_email, class: "input", size: 32, maxlength: 254, autocomplete: "off", required: true %>
        <div>
          <%= form.submit "Create Google sign-in link", class: "button" %>
          <%= form.button "Text me this link", name: "delivery", value: "text", class: "button", data: { variant: "outline" } %>
        </div>
      <% end %>
    <% end %>
    <% if GoogleAccountStart.may_bind_agent?(connector, by: Current.user) %>
      <%= form_with url: connector_google_account_start_path(connector), namespace: "#{dom_id(connector)}_grant", class: "field", data: { turbo: false } do |form| %>
        <%= form.hidden_field :agent_id, value: connector.conversation.agent_id %>
        <%= form.label :expected_email, "Gmail address to grant to this agent" %>
        <%= form.email_field :expected_email, class: "input", size: 32, maxlength: 254, autocomplete: "off", required: true %>
        <div><%= form.submit "Create Gmail access link", class: "button" %></div>
      <% end %>
    <% end %>
  <% end %>
  <% if connector.command? && !override %>
    <p class="muted">Runs on the agent's own computer, with the agent's files and logins<%= ", once for each agent that uses it" unless connector.conversation %>.</p>
    <% if conversation && !connector.usable_by?(conversation) %>
      <p class="flash" data-kind="alert">This agent has no computer switched on, so it gets none of these tools. Switch one on in <%= link_to "#{conversation.agent}'s settings", agent_computer_path(conversation.agent) %>.</p>
    <% end %>
  <% end %>
  <% if !override && connector.enabled? %>
    <% if connector.tool_classes.any? %>
      <% unless connector.conversation_id ? connector.loaded? : conversation&.agent&.core?(connector) %>
        <p class="muted">Looked up when needed: the agent searches these instead of carrying them in every message, which leaves room for more.</p>
      <% end %>
      <ul class="list">
        <% connector.tool_classes.each do |tool| %>
          <li class="list__item">
            <span><strong><%= tool.listing["name"] %></strong><br><span class="muted"><%= tool.description.truncate(240) %></span></span>
            <span class="list__meta"><%= tool.asks ? "Asks you first" : "Runs at once" %></span>
          </li>
        <% end %>
      </ul>
    <% elsif connector.status(conversation) == "listing" %>
      <%= render "ui/skeleton", rows: 2, label: "Listing its tools" %>
    <% elsif connector.status(conversation) == "ok" %>
      <p class="muted">It offers no tools.</p>
    <% end %>
  <% end %>
</article>
