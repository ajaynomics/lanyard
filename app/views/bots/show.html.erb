<% content_for :title, @bot.name %>
<% content_for :back, link_to("‹ Agents", bot_conversations_path(@bot), class: "app-header__back") %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @bot %>

<section class="page">
  <header class="page__header">
    <h1><%= @bot.name %></h1>
    <div class="page__actions"><%= link_to "Edit", edit_bot_path(@bot), class: "button" %></div>
  </header>
  <dl class="details">
    <dt>Model</dt><dd><%= @bot.model %><% if @bot.model.start_with?("anthropic/", "anthropic-api/", "openai-codex/") %> · <%= link_to "Subscriptions", subscriptions_path %><% end %></dd>
    <dt>Thinking</dt><dd><%= Bot::THINKING_LEVEL_NAMES.fetch(@bot.thinking_level, @bot.thinking_level) %></dd>
    <dt>Time zone</dt><dd><%= @bot.time_zone %></dd>
    <dt>Abilities</dt><dd><%= @bot.capabilities.map { Bot::CAPABILITY_DESCRIPTIONS.dig(it, 0) || it.humanize }.to_sentence.presence || "None" %></dd>
    <dt>Tools</dt><dd><%= @bot.tool_names.map(&:humanize).to_sentence.presence || "None" %></dd>
  </dl>
  <%= render "bots/computer", bot: @bot %>
  <%= render "bots/mcp_servers", bot: @bot %>
  <%= render "bots/skills", bot: @bot %>
  <%= render "bots/prompts", bot: @bot %>

  <h2>Instructions</h2>
  <%= render "ui/markdown", text: @bot.instructions %>
  <p class="muted"><%= pluralize(@bot.revisions.count, "revision") %> kept.</p>
</section>
