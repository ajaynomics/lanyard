<%# A status broadcast only morphs this part, not its menu or branch. -%>
<%# locals: (conversation:, current: nil, waiting: 0) -%>
<% active_at = conversation.listed_at %>
<% standing = conversation.standing %>
<%= tag.div id: dom_id(conversation, :row), class: "conversation-row",
      data: { standing: standing, at: active_at.utc.iso8601(6), waiting: waiting } do %>
  <%= link_to conversation, class: "conversation-row__link",
        aria: { current: ("page" if conversation == current) }, data: { list_nav_target: "link" } do %>
    <%= tag.span class: "conversation-row__marker", title: standing_title(conversation, standing), role: ("img" unless standing == "idle"),
          aria: { label: (standing_title(conversation, standing) unless standing == "idle"), hidden: (true if standing == "idle") } do %>
      <% if standing == "working" %><i></i><i></i><i></i><% elsif standing.in?(%w[ needs_you error ]) %>!<% end %>
    <% end %>
    <%= agent_avatar conversation.agent %>
    <span class="conversation-row__text">
      <span class="conversation-row__name"><%= conversation %></span>
      <%= tag.time list_time(active_at), datetime: active_at.iso8601, class: "conversation-row__time",
            title: l(active_at, format: :long),
            data: { controller: "local-time", local_time_format_value: "short", action: "turbo:morph-element->local-time#render" } %>
      <% if (title = conversation.agent.title) %><span class="conversation-row__title"><%= title %></span><% end %>
      <%# In the row's words, so the sidebar, which shows nothing else of the row, says it too. -%>
      <% if conversation.agent.paused? %><span class="conversation-row__badge">Paused</span><% end %>
      <% if conversation.archived? %><span class="conversation-row__badge">Archived</span><% end %>
      <span class="conversation-row__preview"><%= standing_line(conversation, standing) %></span>
      <%= tag.span "#{waiting} need#{'s' if waiting == 1} you", class: "conversation-row__waiting" if waiting.positive? %>
    </span>
  <% end %>
<% end %>
