[
  { "name": "private_key", "pattern": "(-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----)[\\s\\S]*?(?:-----END [A-Z0-9 ]*PRIVATE KEY-----|(?![\\s\\S]))", "keep": true },
  { "name": "authorization_header", "pattern": "((?:Proxy-)?(?:Authorization|authorization|AUTHORIZATION)[\"']?[ \\t]*(?:=>|[:=])[ \\t]*[\"']?(?:Bearer|bearer|BEARER|Basic|basic|BASIC|Token|token|Bot)[ \\t]+)[A-Za-z0-9._~+/=-]+", "keep": true },
  { "name": "quoted_assignment", "pattern": "(\\b(?:(?:[A-Za-z0-9]{1,64}[_.-]){1,6}(?:key|pass)|(?:[A-Za-z0-9]{1,64}[_.-]){0,6}(?:[a-z0-9]{0,64}(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD|PASS|PWD|Key|Token|Secret|Password|Passwd|Pass)|token|secret|password|passwd|pwd|apikey))(?:[_-](?:BASE|base))?[\"']?[ \\t]*(?:=>|[:=])[ \\t]*([\"']))(?!\\$)(?:(?!\\2)[^\\n])+(?=\\2)", "keep": true },
  { "name": "assignment", "pattern": "(\\b(?:(?:[A-Za-z0-9]{1,64}[_.-]){1,6}(?:key|pass)|(?:[A-Za-z0-9]{1,64}[_.-]){0,6}(?:[a-z0-9]{0,64}(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD|PASS|PWD|Key|Token|Secret|Password|Passwd|Pass)|token|secret|password|passwd|pwd|apikey))(?:[_-](?:BASE|base))?[\"']?[ \\t]*(?:=>|[:=])[ \\t]*)(?!\\$|(?:true|false|null|nil|none|undefined)\\b)[^\\s\"'&,;<>\\[\\]{}()]{6,}", "keep": true },
  { "name": "anthropic", "pattern": "\\b(sk-ant-)[A-Za-z0-9_-]{16,}", "keep": true },
  { "name": "openai_project", "pattern": "\\b(sk-proj-)[A-Za-z0-9_-]{16,}", "keep": true },
  { "name": "openai", "pattern": "\\b(sk-)(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{20,}", "keep": true },
  { "name": "github", "pattern": "\\b(ghp_|gho_|ghs_|ghu_|ghr_|github_pat_)[A-Za-z0-9_]{20,}", "keep": true },
  { "name": "slack", "pattern": "\\b(xox[abpr]-)[A-Za-z0-9-]{10,}", "keep": true },
  { "name": "aws_access_key", "pattern": "\\b(AKIA|ASIA)[A-Z0-9]{16}\\b", "keep": true },
  { "name": "duffel", "pattern": "\\b(duffel_(?:live|test)_)[A-Za-z0-9_-]{10,}", "keep": true },
  { "name": "sendgrid", "pattern": "\\b(SG\\.)[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}", "keep": true },
  { "name": "gitlab", "pattern": "\\b(glpat-)[A-Za-z0-9_-]{20,}", "keep": true },
  { "name": "google", "pattern": "\\b(AIza)[A-Za-z0-9_-]{35}", "keep": true },
  { "name": "bearer", "pattern": "\\b((?:Bearer|bearer|BEARER)[ \\t]+)(?=[A-Za-z._~+/=-]*[0-9])[A-Za-z0-9._~+/=-]{16,}", "keep": true },
  { "name": "high_entropy", "pattern": "[A-Za-z0-9+/_-]{32,}={0,2}", "keep": false, "entropy": 4 }
]
