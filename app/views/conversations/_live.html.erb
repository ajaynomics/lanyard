<%# The reply being written, whole (Conversation#receive_frame): the thinking so
    far, then the answer so far, each in blocks that frames between append to
    (conversations/_live_frame). Once it commits it arrives as a message and
    this clears. -%>
<%# working: the agent is at work with nothing written yet: the typing dots, which the reply replaces.
    compacting: earlier messages are being summarised, in a run or asked for.
    compaction_failed: the newest summary failed; it says so until one succeeds. -%>
<%# locals: (conversation:, seq: 0, tail: "", thinking: "", working: false, compacting: false, compaction_failed: false) -%>
<div id="<%= dom_id(conversation, :live) %>" class="chat__live" data-seq="<%= seq %>">
  <% if tail.present? || thinking.present? %>
    <%= render "ui/message", align: :start, role: "assistant", avatar: conversation.agent, data: { streaming: true } do %>
      <% if thinking.present? %>
        <%= render("ui/reasoning", streaming: tail.blank?) { render "conversations/live_text", conversation: conversation, part: :thinking, text: thinking, seq: seq } %>
      <% end %>
      <%= render("ui/bubble") { render "conversations/live_text", conversation: conversation, part: :reply, text: tail, seq: seq } if tail.present? %>
    <% end %>
  <% elsif working || compacting %>
    <%= render "ui/message", align: :start, role: "assistant", avatar: conversation.agent do %>
      <% if compacting %>
        <%= render "ui/shimmer", text: "Summarising earlier messages…" %>
      <% else %>
        <%= render "ui/typing" %>
      <% end %>
    <% end %>
  <% end %>
  <% if compaction_failed && !compacting %>
    <%= render "ui/marker", class: "chat__compaction-failed" do %>Couldn't summarise earlier messages. Type /compact to try again.<% end %>
  <% end %>
</div>
