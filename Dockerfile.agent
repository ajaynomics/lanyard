# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# check=error=true

# An agent's computer: the image of its Sprite on a Sprites platform
# (docs/agent.md). Published
# as <repository>-agent:<sha> (.github/workflows/ci.yml, publish). The platform runs the
# ENTRYPOINT once the Sprite is ready; Dockerfile ENV is not sourced there, so
# everything the guest needs arrives in the create-time env or is defaulted
# by the entrypoint.
#
# It holds the pi-env daemon the sidecar talks to, the relay that starts it
# for an authenticated connection, and the screen: a browser desktop
# stack (Xvfb, openbox, Chromium with CDP, x11vnc, websockify) and its desktop
# control server (agent/guest/server.js, vendored verbatim). The relay also starts the
# agent's command connectors (docs/connectors.md). No Rails, no app code, no
# secrets. Everything runs as `agent`.

FROM docker.io/library/node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS daemon
ARG TARGETARCH
WORKDIR /agent
COPY agent/package.json agent/package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund && \
    arch=$([ "$TARGETARCH" = arm64 ] && echo arm64 || echo x64) && \
    cp "node_modules/@earendil-works/pi-env/bin/pi-env-linux-$arch/pi-env" /pi-env && chmod 755 /pi-env

# The platform lays the image over its Alpine base, so the image is Alpine
# too, at the base's release: a Debian
# image's merged-/usr symlinks cannot be laid over Alpine's directories. The
# daemon is a static binary and needs no libc of its own.
FROM docker.io/library/alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
# npm brings npx, which most command connectors' entries start with.
RUN apk add --no-cache nodejs npm chromium xvfb openbox x11vnc websockify scrot xdotool xclip xterm \
      font-liberation font-dejavu font-noto-emoji tzdata ca-certificates && \
    adduser -D -s /bin/sh agent && \
    mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix
COPY --from=daemon /pi-env /usr/local/bin/pi-env
# One desktop; no Alt+F4, desktop switching or lowering, which let an agent
# lose the screen (the openbox config it was adapted from).
COPY agent/guest/openbox-rc.xml /etc/xdg/openbox/rc.xml
COPY agent/sprite-relay.mjs agent/guest/server.js agent/guest/visit.mjs agent/guest/desk.mjs agent/guest/fill.mjs /opt/agent/
COPY --chmod=755 agent/guest/entrypoint.sh /opt/agent/entrypoint.sh
# server.js is an ES module with a .js name.
RUN echo '{"type":"module"}' > /opt/agent/package.json && \
    chmod 644 /etc/xdg/openbox/rc.xml /opt/agent/*.js /opt/agent/*.mjs /opt/agent/package.json && fc-cache -f >/dev/null
USER agent
WORKDIR /home/agent
EXPOSE 8080
ENTRYPOINT ["/opt/agent/entrypoint.sh"]
