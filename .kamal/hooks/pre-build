#!/bin/sh
# Runs before Kamal builds anything. Refusals first, in the order that makes
# each of them cheap, then one warning.
set -eu

# A destination is not optional: config/deploy.yml sets require_destination,
# and a build with none named would produce an image for nowhere. Nor is one
# without its file, which Kamal would refuse later, after work.
#
# This file lives in .kamal/hooks/ because that is the only place Kamal looks
# (hooks_path in kamal-2.12.0 lib/kamal/configuration.rb); at .kamal/pre-build
# it never ran and the gate was decoration.
if [ -z "${KAMAL_DESTINATION:-}" ]; then
  echo "pre-build: KAMAL_DESTINATION is unset; deploys must name a destination" >&2
  exit 1
fi
file="config/deploy.${KAMAL_DESTINATION}.yml"
if [ ! -f "$file" ]; then
  echo "pre-build: unknown destination '${KAMAL_DESTINATION}': there is no $file" >&2
  exit 1
fi

# Refuse an express-only build before any image work happens: pre-deploy fires
# only after Kamal has built and pushed, so gating there alone would pay for a
# full build before refusing. A destination is express-only when its file
# names the variable that allows it (`x-express: NAME`). Same rule as
# pre-deploy's gate (rollback exempt -- it never builds). Kept as a literal
# copy because hooks are standalone executables with nothing to share a file
# with.
express=$(sed -n 's/^x-express:[[:space:]]*\([A-Z][A-Z0-9_]*\)[[:space:]]*$/\1/p' "$file")
if [ -n "$express" ] \
   && [ "$(printenv "$express" || true)" != "1" ] \
   && [ "${KAMAL_COMMAND:-}" != "rollback" ]; then
  echo "pre-build: ${KAMAL_DESTINATION} is express only and is gated; an everyday" >&2
  echo "pre-build: deploy goes elsewhere. For an express release, re-run as:" >&2
  echo "pre-build:   ${express}=1 bin/kamal deploy -d ${KAMAL_DESTINATION}" >&2
  exit 1
fi

# Kamal clones this working copy to build it, keeps that clone between deploys,
# and brings it up to date with `fetch origin` + `reset --hard <sha>`. A clone
# of a local path copies refs/heads and nothing else, so on a detached HEAD the
# commit being deployed is named by no branch the fetch can see, and Kamal
# answers with
#
#   ERROR Error preparing clone: ... fatal: Could not parse object '<sha>'.
#
# then deletes the clone and re-clones, which works. So this is noise, not
# damage -- warned about rather than refused, because deploying a specific
# commit on purpose is legitimate. An ERROR that is not one, on every deploy
# from a worktree, is how people learn to read past errors. Outside a
# repository there is nothing to be detached from, and `symbolic-ref` fails
# there for a different reason, so silence is right then.
if git rev-parse --git-dir >/dev/null 2>&1 && ! git symbolic-ref -q HEAD >/dev/null 2>&1; then
  echo "pre-build: HEAD is detached at $(git rev-parse --short HEAD)." >&2
  echo "pre-build: Kamal's cached clone cannot resolve a commit no branch names," >&2
  echo "pre-build: so expect one 'Error preparing clone' below. It re-clones and" >&2
  echo "pre-build: the deploy is correct; the image is built from this commit." >&2
  echo "pre-build: To skip the noise, name it first:  git checkout -B <name> HEAD" >&2
fi

echo "pre-build: ${KAMAL_DESTINATION} is a known destination"
