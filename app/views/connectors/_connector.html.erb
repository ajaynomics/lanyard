<%# locals: (connector:, conversation: nil) -%>
<%# On an agent's page, one of the person's connectors may be replaced or switched off by the agent's own entry. -%>
<% override = conversation && connector.conversation_id.nil? ? conversation.mcp_servers.find { it.name == connector.name } : nil %>
<article id="<%= dom_id(connector) %>" class="mcp-server">
  <header class="mcp-server__header">
    <span><strong><%= connector.name %></strong> <span class="muted"><%= connector.command? ? [ connector.command, *connector.args ].join(" ").truncate(120) : connector.url %></span></span>
    <span>
      <% if override %>
        <% if !override.switch_off? %>
          <span class="muted">This agent uses its own <%= connector.name %>.</span>
        <% else %>
          <span class="muted">Off for this agent.</span>
          <%= button_to "Switch back on", connector_path(override), method: :delete, class: "button", data: { variant: "outline", size: "sm" }, form_class: "inline" %>
        <% end %>
      <% else %>
        <% if connector.signed_in? %>
          <span class="muted">Signed in <%= l connector.signed_in_at.to_date, format: :long %> ·</span>
          <%= button_to "Sign out", connector_sign_in_path(connector), method: :delete, class: "button", data: { variant: "ghost", size: "sm" }, form_class: "inline" %>
        <% end %>
        <% unless conversation && connector.conversation_id.nil? %>
          <%= button_to connector.enabled? ? "Turn off" : "Turn on", connector_path(connector), method: :patch, params: { connector: { enabled: !connector.enabled? } },
                class: "button", data: { variant: "outline", size: "sm" }, form_class: "inline" %>
        <% end %>
        <% if (conversation || !connector.command?) && connector.status(conversation) != "failing" %>
          <%= button_to "Refresh tools", connector_refresh_path(connector), params: { agent_id: conversation&.id }.compact,
                class: "button", data: { variant: "outline", size: "sm" }, form_class: "inline" %>
        <% end %>
        <% if conversation && connector.conversation_id.nil? %>
          <%= button_to "Switch off for this agent", connectors_path, params: { connector: { name: connector.name, enabled: false, conversation_id: conversation.id } },
                class: "button", data: { variant: "ghost", size: "sm" }, form_class: "inline" %>
        <% else %>
          <%= button_to "Remove", connector_path(connector), method: :delete, class: "button",
                data: { variant: "ghost", size: "sm", turbo_confirm: "Remove #{connector.name}? Its tools go from the next message." }, form_class: "inline" %>
        <% end %>
      <% end %>
    </span>
  </header>
  <% unless override %>
    <%= render "connectors/status", connector: connector, conversation: conversation %>
  <% end %>
  <% if connector.command? && !override %>
    <p class="muted">Runs on the agent's own computer, with the agent's files and logins<%= ", once for each agent that uses it" unless connector.conversation %>.</p>
    <% if conversation && !connector.usable_by?(conversation) %>
      <p class="flash" data-kind="alert">This agent has no computer switched on, so it gets none of these tools. Switch one on in <%= link_to "#{conversation.bot}'s settings", bot_path(conversation.bot, anchor: "computer") %>.</p>
    <% end %>
  <% end %>
  <% if !override && connector.enabled? %>
    <% if connector.tool_classes.any? %>
      <ul class="list">
        <% connector.tool_classes.each do |tool| %>
          <li class="list__item">
            <span><strong><%= tool.listing["name"] %></strong><br><span class="muted"><%= tool.description.truncate(240) %></span></span>
            <span class="list__meta"><%= tool.asks ? "Asks you first" : "Runs at once" %></span>
          </li>
        <% end %>
      </ul>
    <% elsif connector.status == "ok" %>
      <p class="muted">It offers no tools.</p>
    <% end %>
  <% end %>
</article>
