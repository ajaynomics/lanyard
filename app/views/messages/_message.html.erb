<%# A page passes its conversation's ledger calls, tool results by call id and the call ids its replies made,
    once; a broadcast looks them up. Each turn carries when it was made (data-at): the thread's times, day
    separators and runs are drawn from it in the reader's own zone (thread_times_controller). -%>
<%# locals: (message:, invocations: message.conversation.invocations.index_by(&:call_id),
             results: message.conversation.messages.where(role: "toolResult", tool_call_id: message.tool_calls.pluck("id")).index_by(&:tool_call_id),
             placed: Set.new([ message.placed_call&.dig("id") ].compact)) -%>
<%# Someone else's words through a channel come in as the person's turn; they show as their sender's. -%>
<% incoming = message.incoming %>
<% case incoming ? "incoming" : message.role %>
<% when "incoming" %>
  <%= render "ui/incoming", sender: incoming.sender, channel: incoming.channel, trusted: incoming.trusted, id: dom_id(message), data: { entry_id: message.entry_id, at: message.created_at.iso8601 } do %>
    <%= render "messages/incoming_body", incoming: incoming %>
    <%= message_time message %>
  <% end %>
<% when "user" %>
  <%# A skill the person invoked shows as its name and their words, not the skill's whole text. -%>
  <% skill = message.skill_name %>
  <%= render "ui/message", align: :end, role: "user", id: dom_id(message), data: { entry_id: message.entry_id, at: message.created_at.iso8601, typed: (message.typed if skill) } do %>
    <%= render "ui/images", images: message.images, alt: "Picture you sent" if message.images.attached? %>
    <%= tag.p "Skill: #{skill}", class: "message__skill" if skill %>
    <% words = skill ? message.skill_arguments : message.said %>
    <%= render("ui/bubble", variant: :primary) { tag.p(linked(words), class: "ui-bubble__text") } if words.present? %>
    <%= tag.p "With your edits to the canvas", class: "message__skill" if message.document_changes? %>
    <%= message_time message %>
  <% end %>
<% when "assistant" %>
  <% text = message.content.gsub(/\[tool: [\w-]+\]/, "").strip %>
  <%# A run that failed before its first word leaves an empty reply: nothing to show; the status says why. -%>
  <% if text.present? || message.thinking.present? || message.tool_calls.any? %>
    <%= render "ui/message", align: :start, role: "assistant", avatar: message.conversation.agent, id: dom_id(message), data: { entry_id: message.entry_id, at: message.created_at.iso8601 } do %>
      <%= render "ui/reasoning", text: message.thinking if message.thinking.present? %>
      <%= render("ui/bubble") { render "ui/markdown", text: text } if text.present? %>
      <% message.tool_calls.each do |call| %>
        <% if (invocation = invocations[call["id"]]) %>
          <%# Named, not `render invocation`: from a Conversations:: controller Rails would look under conversations/. -%>
          <%= render "invocations/invocation", invocation: invocation %>
        <% else %>
          <%= render "messages/tool_call", call: call, result: results[call["id"]], invocations: invocations %>
        <% end %>
      <% end %>
      <% if (miss = cache_miss_line(message)) %>
        <p class="message__cache-miss" role="note"><%= miss %></p>
      <% end %>
      <%# The time leads the usage line, so a reply ends in one quiet line. -%>
      <% if (usage = usage_line(message.usage)) %>
        <p class="message__usage" title="Cost is an estimate at API prices: an API key is billed this way; a subscription is not billed per token."><%= message_time message %><span><%= usage %></span></p>
      <% else %>
        <%= message_time message %>
      <% end %>
      <% if text.present? || message.answer? %>
        <div class="message__actions">
          <%= render "messages/copy", text: text if text.present? %>
          <%= render "messages/new_agent", message: message if message.answer? %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% when "toolResult" %>
  <%# A result shows in its call's place; on its own only when that call is not on the page. -%>
  <% unless invocations.key?(message.tool_call_id) || placed.include?(message.tool_call_id) %>
    <%= render "ui/message", align: :start, role: "tool", id: dom_id(message), data: { entry_id: message.entry_id } do %>
      <%= render "ui/trace", title: "#{message.error ? 'Failed' : 'Ran'} #{message.tool_name.to_s.humanize(capitalize: false)}", status: (:error if message.error) do %>
        <%= render "ui/code_block", code: message.content.truncate(4_000) %>
      <% end %>
      <%= render "ui/images", images: message.images, alt: "What #{message.tool_name.to_s.humanize(capitalize: false)} saw" if message.images.attached? %>
    <% end %>
  <% end %>
<% when "summary" %>
  <%= render "messages/summary", message: message %>
<% end %>
