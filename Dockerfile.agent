# syntax=docker/dockerfile:1
# check=error=true

# A bot's computer: the image of its Sprite on Ajay's Sprites platform
# (docs/agent.md; an existing docs/sprites-developer-cheatsheet.md). Published
# as gitea.example.com/ajaynomics/durable-assistants-agent:<sha>. The platform runs the
# ENTRYPOINT once the Sprite is ready; Dockerfile ENV is not sourced there, so
# everything the relay needs arrives in the create-time env.
#
# It holds the pi-env daemon the sidecar talks to, the relay that starts it
# for an authenticated connection, and Chromium for visit_website. No Rails,
# no app code, no secrets.

FROM docker.io/library/node:24.20.0-bookworm-slim AS daemon
ARG TARGETARCH
WORKDIR /agent
COPY agent/package.json agent/package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund && \
    arch=$([ "$TARGETARCH" = arm64 ] && echo arm64 || echo x64) && \
    cp "node_modules/@earendil-works/pi-env/bin/pi-env-linux-$arch/pi-env" /pi-env && chmod 755 /pi-env

FROM docker.io/library/node:24.20.0-bookworm-slim
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y chromium fonts-liberation ca-certificates && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives
COPY --from=daemon /pi-env /usr/local/bin/pi-env
COPY agent/sprite-relay.mjs /opt/avery/sprite-relay.mjs
WORKDIR /root
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/node", "/opt/avery/sprite-relay.mjs"]
