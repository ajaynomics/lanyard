<%# One tool call and where it stands (shadcn: Tool, Confirmation). -%>
<%# locals: (invocation:) -%>
<% name = invocation.tool_name == "use_tool" ? tool_label("use_tool", invocation.arguments) : invocation.tool_name.humanize(capitalize: false) %>
<div id="<%= invocation.dom_target %>" class="tool-call" data-state="<%= invocation.state %>">
  <% if invocation.answerable? && invocation.asks == :approval %>
    <%= render "ui/card", title: "Allow #{name}?", class: "approval" do %>
      <%= render "ui/fields", values: invocation.tool_name == "use_tool" ? invocation.arguments["arguments"] : invocation.arguments %>
      <% if (description = (invocation.tool_class.try(:target, invocation.arguments["name"]) || invocation.tool_class)&.description.presence) %>
        <details class="ui-card__more"><summary>What it does</summary><p class="muted"><%= description %></p></details>
      <% end %>
      <%# As pi asks: once, always (Permission, listed on the agent's page), or not. -%>
      <% path = conversation_invocation_approval_path(invocation.conversation, invocation) %>
      <% choices = invocation.always_choices %>
      <div class="ui-card__actions">
        <%= button_to "Allow once", path, params: { decision: "approve" }, class: "button", form_class: "inline" %>
        <% if choices.include?("agent") %>
          <%= button_to "Always for this agent", path, params: { decision: "approve", always: "agent" }, class: "button", form_class: "inline",
                data: { variant: "outline" }, title: "Allow every #{name} from now on, without asking" %>
        <% end %>
        <% if choices.include?("recipient") %>
          <%= button_to "Always with #{invocation.recipients.to_sentence}", path, params: { decision: "approve", always: "recipient" },
                class: "button", form_class: "inline", data: { variant: "outline" }, title: "Allow #{name} to these from now on, without asking" %>
        <% end %>
        <%= button_to "Deny", path, params: { decision: "deny" }, class: "button", data: { variant: "outline" }, form_class: "inline" %>
      </div>
    <% end %>
  <% elsif invocation.answerable? && invocation.asks == :question %>
    <%= render "invocations/question", invocation: invocation %>
  <% elsif invocation.answerable? && invocation.asks == :sign_in %>
    <%= render "invocations/sign_in", invocation: invocation %>
  <% elsif invocation.succeeded? && (document = invocation_document(invocation)) %>
    <%= render "conversations/documents/card", document: document, conversation: invocation.conversation,
          verb: invocation.tool_name == "edit_document" ? "Edited" : "Wrote" %>
  <% else %>
    <% title = case invocation.state
         when "succeeded" then "Ran #{name}"
         when "failed" then "Failed to run #{name}"
         when "denied" then "Declined #{name}"
         when "awaiting_person" then "Waited too long to run #{name}"
         else "Running #{name}…"
       end %>
    <%= render "ui/trace", title: title, status: invocation.trace_status.then { it == "done" ? nil : it } do %>
      <% if invocation.arguments.present? %>
        <%= render "ui/code_block", code: JSON.pretty_generate(invocation.arguments), label: "Input" %>
      <% end %>
      <% if invocation.succeeded? %>
        <%= render "ui/code_block", code: JSON.pretty_generate(invocation.result), label: "Result" %>
      <% elsif invocation.error.present? %>
        <%= render "ui/code_block", code: invocation.error, label: "Error" %>
      <% end %>
    <% end %>
  <% end %>
</div>
