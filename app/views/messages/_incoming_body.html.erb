<%# Someone else's words, in the thread and while they wait in the queue alike. A peer agent writes Markdown,
    so Concourse mail is rendered (sanitized, as a reply is); an email or a text is shown as it was typed. -%>
<%# locals: (incoming:) -%>
<%= render("ui/bubble") do %>
  <% if incoming.markdown? %>
    <%= render "ui/markdown", text: incoming.body %>
  <% else %>
    <%= tag.p linked(incoming.body), class: "ui-bubble__text" %>
  <% end %>
<% end %>
