<%# locals: (agent:) -%>
<% providers = Computer.providers %>
<% if providers.any? || agent.computer %>
  <section id="computer" class="computer">
    <h2>Computer</h2>
    <% computer = agent.computer || agent.build_computer(provider: providers.first) %>
    <p class="muted">
      <% if computer.persisted? && computer.on? %>
        On: <%= Computer::LABELS.fetch(computer.provider, computer.provider) %>. <%= agent %> can read and write files and run commands; each agent gets its own computer.
      <% else %>
        Off. <%= agent %> has no files or shell.
      <% end %>
    </p>
    <%= form_with model: computer, url: agent_computer_path(agent), method: :patch, class: "form" do |form| %>
      <div class="field-row">
        <div class="field">
          <%= form.label :provider, "Kind" %>
          <%= form.select :provider, providers.map { [ Computer::LABELS.fetch(it, it), it ] }, {}, class: "input", aria: { describedby: "computer_kinds" } %>
          <p class="field__hint" id="computer_kinds"><%= safe_join(providers.map { "#{Computer::LABELS.fetch(it, it)}: #{Computer::NOTES[it]}." }, " ") %></p>
        </div>
        <div class="field">
          <%= form.label :state, "Power" %>
          <%= form.select :state, [ [ "Off", "off" ], [ "On", "on" ] ], {}, class: "input" %>
        </div>
      </div>
      <label class="choice">
        <%= form.check_box :notes_file %>
        <span><strong>Notes file (AGENTS.md)</strong><br><span class="muted">Read at the start of each reply, up to 32 KB.</span></span>
      </label>
      <div class="form__actions"><%= form.submit "Save computer", class: "button", data: { variant: "outline" } %></div>
    <% end %>
  </section>
<% end %>
