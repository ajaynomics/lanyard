<%# "Branch from here" on a reply, "Edit" on a person's message: either starts a new conversation (Conversations::ForksController).
    It sits in the message's .message__actions, quiet: shown on hover with a mouse, always there on a touch screen.
    Branches already taken after the message show apart, always (messages/_branches). -%>
<%# locals: (message:, label:, title:) -%>
  <%= button_to conversation_forks_path(message.conversation), params: { message_id: message.id, request_id: SecureRandom.uuid },
        class: "button message__action", title: title, form_class: "inline", data: { variant: "ghost", size: "sm" } do %>
    <% if message.from_person? %>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
    <% else %>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="8" r="2"/><path d="M6 8v8"/><path d="M18 10c0 4-6 3-10.5 6.5"/></svg>
    <% end %>
    <span class="message__label"><%= label %></span>
  <% end %>
