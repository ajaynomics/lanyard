<%# What the model thought before answering (shadcn: Reasoning). Open while it
    streams; closed once the answer is there. -%>
<%# locals: (text: nil, streaming: false) -%>
<%= tag.details class: "ui-reasoning", open: streaming, data: { streaming: streaming } do %>
  <summary class="ui-reasoning__summary"><%= streaming ? "Thinking…" : "Thought process" %></summary>
  <div class="ui-reasoning__content"><%= text ? render("ui/markdown", text: text) : yield %></div>
<% end %>
