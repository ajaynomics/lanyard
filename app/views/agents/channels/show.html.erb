<% content_for :title, "Channels · #{@agent.name}" %>

<header class="settings__header"><h1>Channels</h1></header>
<p class="muted">How people and other agents reach <%= @agent.name %>, besides you here.</p>

<% if DurableAssistants::Email.configured? %>
  <section class="ui-group" aria-labelledby="channel_email">
    <h2 class="ui-group__title" id="channel_email">Email</h2>
    <ul class="ui-group__rows">
      <li class="ui-row">
        <span class="ui-row__label">Address</span>
        <span class="ui-row__value"><%= @agent.email_address %></span>
      </li>
    </ul>
    <p class="ui-group__help">Mail to this address reaches <%= @agent.name %>. Sending mail asks you first, unless you allowed it "Always".</p>
  </section>
<% end %>
<% if DurableAssistants::Voipms.configured? %>
  <%= form_with model: @agent, url: agent_phone_number_path(@agent), method: :patch, id: "phone_number",
        data: { controller: "autosave", action: "change->autosave#save" } do |form| %>
    <section class="ui-group" aria-labelledby="channel_phone">
      <h2 class="ui-group__title" id="channel_phone">Phone</h2>
      <ul class="ui-group__rows">
        <li class="ui-row">
          <%= form.label :phone_number, "Number", class: "ui-row__label" %>
          <span class="ui-row__value"><%= form.telephone_field :phone_number, value: @agent.phone_label, class: "input", placeholder: "None", autocomplete: "off" %></span>
        </li>
      </ul>
      <p class="ui-group__help">
        <% if @agent.phone_number %>
          <%= @agent.name %> texts from this number. Each text asks you first, unless you allowed it "Always", and it sends at most <%= Tool::SendText::DAILY_LIMIT %> a day. Texts to the number reach <%= @agent.name %> as email, once the number forwards them<%= " to #{@agent.email_address}" if @agent.email_address %>. Clear it to stop.
        <% else %>
          One of the install's voip.ms numbers, for <%= @agent.name %> to send texts from.
        <% end %>
      </p>
    </section>
  <% end %>
<% end %>
<% if DurableAssistants::Caldav.configured? %>
  <%= form_with model: @agent, url: agent_calendar_account_path(@agent), method: :patch, id: "calendar_account",
        data: { controller: "autosave", action: "change->autosave#save" } do |form| %>
    <section class="ui-group" aria-labelledby="channel_calendar">
      <h2 class="ui-group__title" id="channel_calendar">Calendar</h2>
      <ul class="ui-group__rows">
        <li class="ui-row">
          <%= form.label :caldav_username, "Account", class: "ui-row__label" %>
          <span class="ui-row__value"><%= form.text_field :caldav_username, class: "input", placeholder: "None", autocomplete: "off", spellcheck: false %></span>
        </li>
        <li class="ui-row">
          <%= form.label :caldav_password, "App password", class: "ui-row__label" %>
          <span class="ui-row__value"><%= form.password_field :caldav_password, value: nil, class: "input", autocomplete: "new-password",
                placeholder: @agent.caldav_password ? "Saved" : "None" %></span>
        </li>
      </ul>
      <p class="ui-group__help">
        <% if @agent.calendar? %>
          <%= @agent.name %> reads and changes the calendars and task lists of this account, and any shared with it. Inviting someone asks you first, unless you allowed it "Always". Clear the account to stop.
        <% else %>
          <%= @agent.name %>'s own account on <%= URI(DurableAssistants::Caldav.url).host %>, and its app password, for its calendars and task lists.
        <% end %>
      </p>
    </section>
  <% end %>
<% end %>
<% if DurableAssistants::Concourse.configured? || CampfireBot.configured? %>
  <%# How the agent talks to others: Concourse's agents and Campfire's rooms, side by side; stacked on a phone. -%>
  <section class="channels" aria-labelledby="channels_others">
    <h2 class="ui-group__title" id="channels_others">Other agents and rooms</h2>
    <div class="channels__pair">
      <%= render "agents/concourse_agent", agent: @agent if DurableAssistants::Concourse.configured? %>
      <%= render "agents/campfire_bot", agent: @agent %>
    </div>
  </section>
<% end %>
<% unless channels? %>
  <div class="settings__empty"><p>This install has no channels set up: no email, phone, Concourse or Campfire.</p></div>
<% end %>
