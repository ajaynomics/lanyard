<%# What an empty list says: why it is empty, for the search or filter the person chose. -%>
<%# locals: (list:) -%>
<%= render "ui/marker", variant: :separator do %>
  <% if list[:q].present? %>
    Nothing matches "<%= list[:q] %>". <%= link_to "Clear", conversations_path(list.except(:q)) %>
  <% else %>
    <%= { "waiting" => "Nothing is waiting for you.", "branched" => "No branches yet. Branch from any reply.",
          "archived" => "Nothing archived." }.fetch(list[:filter]) { safe_join([ "No agents yet. ", link_to("Make your first", new_agent_path), "." ]) } %>
  <% end %>
<% end %>
