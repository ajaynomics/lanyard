<% content_for :title, "Agents" %>
<% content_for :head, stylesheet_link_tag("list") %>
<%# Back from a thread asks again: a copy kept from before would show it unread, as it was when left. -%>
<% turbo_exempts_page_from_cache %>
<%= turbo_stream_from Current.user, :conversations %>

<section class="page">
  <header class="page__header">
    <h1>Agents</h1>
    <div class="page__actions">
      <%= link_to "Connectors", connectors_path, class: "button page__connectors", data: { variant: "ghost" } %>
      <%# A phone has no bar above the list: Settings sits beside the title, and New agent is a round button at the
          foot, beside the search, where a thumb is (list.css). -%>
      <%= link_to settings_path, class: "button page__settings", data: { variant: "ghost", size: "icon" }, aria: { label: "Settings" }, title: "Settings" do %>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      <% end %>
      <%= link_to new_agent_path, id: "new_agent", class: "button page__compose" do %>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        <span>New agent</span>
      <% end %>
    </div>
  </header>

  <%= render "conversations/filters", list: @list %>

  <%# Thirty at a time. Each page ends with a frame that loads the next as it scrolls into view. -%>
  <%# Live, a changed row takes its place (sidebar_order_controller); a new agent joins only the list of every active one. -%>
  <% live = @list[:filter].in?([ nil, "", "active" ]) && @list[:q].blank? %>
  <div id="conversations" class="conversation-list" data-controller="list-nav sidebar-order" data-action="keydown->list-nav#move <%= sidebar_order_actions %>"
       data-sidebar-order-sorted-value="<%= live && @list[:sort].in?([ nil, "", "recent" ]) %>">
    <%= turbo_frame_tag "conversations_page_#{@page.number}", target: "_top" do %>
      <% if @conversations.any? %>
        <%= tag.ul class: "conversation-list__page", id: ("agents_list" if live && @page.first?), data: { sidebar_order_target: ("list" if @page.first?) } do %>
          <%= render partial: "conversations/conversation", collection: @conversations, as: :conversation %>
        <% end %>
        <% unless @page.last? %>
          <%= turbo_frame_tag "conversations_page_#{@page.next_param}", target: "_top", loading: :lazy,
                src: conversations_path(@list.merge(page: @page.next_param)) do %>
            <%= render "ui/skeleton", label: "Loading more agents" %>
          <% end %>
        <% end %>
      <% elsif @page.first? %>
        <%= render "conversations/empty_list", list: @list %>
      <% end %>
    <% end %>
  </div>
</section>
