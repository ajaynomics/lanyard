<%# locals: (agent:) -%>
<section id="prompts" class="agent-records">
  <header class="page__header">
    <h2>Saved prompts</h2>
    <%= link_to "Add a prompt", new_agent_prompt_path(agent), class: "button", data: { variant: "outline", size: "sm" } %>
  </header>
  <p class="muted">
    Words you send often. Type <code>/</code> and the prompt's name in a conversation, with anything to add after it.
  </p>
  <% if agent.prompts.any? %>
    <ul class="list">
      <% agent.prompts.each do |prompt| %>
        <li class="list__item" id="<%= dom_id(prompt) %>">
          <span><strong><%= prompt %></strong><br><span class="muted"><%= prompt.hint %></span></span>
          <span class="list__meta">
            <%= link_to "Edit", edit_agent_prompt_path(agent, prompt), class: "button", data: { variant: "ghost", size: "sm" } %>
            <%= button_to "Remove", agent_prompt_path(agent, prompt), method: :delete, class: "button", form_class: "inline",
                  data: { variant: "ghost", size: "sm", turbo_confirm: "Remove #{prompt}?" } %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
