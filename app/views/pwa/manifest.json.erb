{
  "id": "/",
  "name": <%= raw app_name.to_json %>,
  "short_name": <%= raw app_name.to_json %>,
  "description": "Your agents, each with its own computer, connectors and notes.",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icons/app-192.png", "type": "image/png", "sizes": "192x192" },
    { "src": "/icons/app.png", "type": "image/png", "sizes": "512x512" },
    { "src": "/icons/maskable.png", "type": "image/png", "sizes": "512x512", "purpose": "maskable" },
    { "src": "/icons/app.svg", "type": "image/svg+xml", "sizes": "any" }
  ],
  <%# Taken by test/system/install_screenshots_test.rb. -%>
  "screenshots": [
    { "src": "/screenshots/wide.png", "type": "image/png", "sizes": "1280x800", "form_factor": "wide", "label": "An agent's thread beside the list of agents" },
    { "src": "/screenshots/narrow.png", "type": "image/png", "sizes": "390x844", "form_factor": "narrow", "label": "An agent's thread on a phone" }
  ],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "shortcuts": [
    { "name": "New agent", "url": "/agents/new", "icons": [{ "src": "/icons/app-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "theme_color": "#ffffff",
  "background_color": "#ffffff"
}
