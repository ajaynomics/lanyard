#!/usr/bin/env bash
# Report a deployment's backup run to Uptime Kuma. The systemd units call this with
# `finish` after a successful run and with `fail` from their OnFailure unit,
# so a backup that stops running pages instead of going quietly stale.
#
# The push URL lives in a root-only file because a URL in the unit or the
# checkout is a credential in version control. The Kuma push monitor has a
# heartbeat just over 24 hours: the backup runs daily, so a missed heartbeat
# means the timer, the script, or the host stopped.
set -euo pipefail

STATE="${1:-}"
SERVICE="${BACKUP_SERVICE:-durable_assistants}"
SECRET_FILE="${BACKUP_MONITOR_SECRET_FILE:-/etc/${SERVICE}-backup-uptime-kuma-url}"
CURL_BIN="${CURL_BIN:-/usr/bin/curl}"

case "$STATE" in
  finish)
    STATUS="up"
    ;;
  fail)
    STATUS="down"
    ;;
  *)
    printf 'usage: %s {finish|fail}\n' "${0##*/}" >&2
    exit 64
    ;;
esac

if [[ ! -r "$SECRET_FILE" ]] || ! IFS= read -r PUSH_URL < "$SECRET_FILE" || [[ -z "$PUSH_URL" ]]; then
  printf '%s backup monitor URL is unavailable\n' "$SERVICE" >&2
  exit 78
fi

if [[ ! "$PUSH_URL" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?/api/push/[A-Za-z0-9_-]+$ ]]; then
  printf '%s backup monitor URL is invalid\n' "$SERVICE" >&2
  exit 78
fi

"$CURL_BIN" --fail --silent --show-error --config - >/dev/null <<CURL_CONFIG
url = "$PUSH_URL"
get
data-urlencode = "status=$STATUS"
data-urlencode = "msg=$STATE"
CURL_CONFIG
