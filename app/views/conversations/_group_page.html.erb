<%# A page of one group's rows, thirty at a time. Each page ends with a frame that loads that group's next as it scrolls
    into view; a new agent joins the first page of the list as it stands (Conversation::Standing). -%>
<%# locals: (group:, list:, current:) -%>
<% workspace, page = group.workspace, group.page %>
<%= turbo_frame_tag dom_id(workspace, "page_#{page.number}"), target: "_top" do %>
  <%= tag.ul class: "conversation-list__page", id: (dom_id(workspace, :agents) if group.live? && page.first?),
        data: { sidebar_order_target: ("list" if page.first?) } do %>
    <%= render partial: "conversations/conversation", collection: group.conversations, as: :conversation, locals: { current: current } %>
  <% end %>
  <% unless page.last? %>
    <%= turbo_frame_tag dom_id(workspace, "page_#{page.next_param}"), target: "_top", loading: :lazy,
          src: conversations_path(list.merge(page: page.next_param, workspace_id: workspace.id)) do %>
      <%= render "ui/skeleton", label: "Loading more agents" %>
    <% end %>
  <% end %>
<% end %>
