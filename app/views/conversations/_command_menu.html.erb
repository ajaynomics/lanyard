<%# The composer's list (command_menu_controller). Rendered with the page, so a Turbo morph refreshes it:
    the built-ins, the agent's saved prompts and skills, and the choices /model and /thinking take. -%>
<%# locals: (conversation:) -%>
<% agent = conversation.agent %>
<% choices = ModelCatalog.choices(including: agent.model) %>
<% levels = (choices.find { it.id == agent.model }&.thinking_levels || Agent::THINKING_LEVELS) %>
<% options = built_in_commands.map { |command| { name: command.name, hint: command.hint, kind: "command", label: command.label,
      form: command.form, run: command.run, missing: command.missing } } +
    agent.prompts.map { { name: it.name, hint: it.hint, kind: "prompt", label: "/#{it.name}" } } +
    agent.skills.map { { name: "skill:#{it.name}", hint: it.description.truncate(100), kind: "skill", label: "/skill:#{it.name}" } } +
    choices.map { { name: it.id, hint: it.label, kind: "argument", command: "model", label: it.id } } +
    levels.map { { name: it, hint: Agent::THINKING_LEVEL_NAMES[it], kind: "argument", command: "thinking", label: it } } %>
<ul id="command_menu" class="command-menu" role="listbox" aria-label="Commands" hidden data-command-menu-target="list">
  <% options.each_with_index do |option, index| %>
    <%= tag.li id: "command_option_#{index}", role: "option", class: "command-menu__option", aria: { selected: "false" },
          data: { name: option[:name], hint: option[:hint], kind: option[:kind], command: option[:command], form: option[:form],
                  run: option[:run], missing: option[:missing], command_menu_target: "option",
                  action: "mousedown->command-menu#hold click->command-menu#pick" } do %>
      <span class="command-menu__name"><%= option[:label] %></span>
      <span class="command-menu__hint"><%= option[:hint] %></span>
    <% end %>
  <% end %>
</ul>
