<% content_for :title, "Components" %>
<% content_for :head, stylesheet_link_tag("settings") %>

<section class="page components">
  <header class="page__header"><h1>Components</h1></header>
  <p class="muted">Every shared piece, in each state (app/views/ui, components.css). Development only. Switch the system's dark mode to check the other theme.</p>

  <h2 id="button">Button</h2>
  <div class="components__row">
    <button class="button">Primary</button>
    <button class="button" data-variant="outline">Outline</button>
    <button class="button" data-variant="ghost">Ghost</button>
    <button class="button" data-variant="destructive">Destructive</button>
    <button class="button" disabled>Disabled</button>
  </div>
  <div class="components__row">
    <button class="button" data-size="sm">Small</button>
    <button class="button" data-variant="outline" data-size="sm">Small outline</button>
    <button class="button" data-variant="ghost" data-size="icon" aria-label="Close" title="Close">×</button>
    <%= button_to "Confirms first", components_path, method: :get, class: "button", form_class: "inline",
          data: { variant: "outline", turbo_confirm: "Remove this? It can't be undone." } %>
  </div>

  <h2 id="form">Input, Textarea, Select, Label and Form messages</h2>
  <%= form_with model: @invalid, url: components_path, method: :get, class: "form" do |form| %>
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, class: "input" %>
      <p class="field__hint">An invalid field: marked, its message under it, tied by aria-describedby.</p>
    </div>
    <div class="field">
      <%= label_tag "components_text", "Textarea" %>
      <%= text_area_tag "components_text", nil, rows: 3, class: "input", placeholder: "A placeholder." %>
    </div>
    <div class="field-row">
      <div class="field">
        <%= label_tag "components_select", "Select" %>
        <%= select_tag "components_select", options_for_select([ "One", "Two" ]), class: "input" %>
      </div>
      <fieldset class="field">
        <legend>Choice</legend>
        <label class="choice"><%= radio_button_tag "components_choice", "a", true %> A choice</label>
        <label class="choice"><%= check_box_tag "components_check", "1", true %> A check box</label>
      </fieldset>
    </div>
    <div class="form__actions"><%= form.submit "Submit", class: "button" %></div>
  <% end %>

  <h2 id="alert">Alert and Toast</h2>
  <p class="flash" data-kind="alert" role="alert">An alert in the page.</p>
  <p class="flash">A note in the page.</p>
  <div class="components__toasts">
    <div class="toasts"><%= render "layouts/flash", messages: { "notice" => "A notice: it goes by itself.", "alert" => "An alert: it stays until closed." } %></div>
  </div>

  <h2 id="card">Card, with the details of a call</h2>
  <%= render "ui/card", title: "Allow send email?" do %>
    <%= render "ui/fields", values: { "to" => [ "someone@example.com" ], "subject" => "Friday", "body" => "Please confirm Friday.\n\nThanks", "options" => { "cc" => [] } } %>
    <details class="ui-card__more"><summary>What it does</summary><p class="muted">Send an email from your own address.</p></details>
    <div class="ui-card__actions"><button class="button">Allow once</button><button class="button" data-variant="outline">Always with someone@example.com</button><button class="button" data-variant="outline">Always for this agent</button><button class="button" data-variant="outline">Deny</button></div>
  <% end %>

  <h2 id="message">Message, Bubble, Time, Typing, Markdown, Reasoning and Marker</h2>
  <%# A run of each side's bubbles: only the last of a run has a tail; the time breaks runs an hour apart. -%>
  <div class="chat__messages components__thread">
    <%= render "ui/time", at: Time.utc(2026, 11, 2, 9, 41) %>
    <%= render "ui/message", align: :end, role: "user" do %>
      <%= render("ui/bubble", variant: :primary) { tag.p("A person's message.", class: "ui-bubble__text") } %>
    <% end %>
    <%= render "ui/message", align: :end, role: "user" do %>
      <%= render("ui/bubble", variant: :primary) { tag.p("And another, straight after: the run's last, with the tail.", class: "ui-bubble__text") } %>
    <% end %>
    <%= render "ui/message", align: :start, role: "assistant", avatar: @agents.first do %>
      <%= render "ui/reasoning", text: "First, check the notes." %>
      <%= render("ui/bubble") { render "ui/markdown", text: "**An answer** with `code`, a [link](#), and a list:\n\n1. one\n2. two\n\n```ruby\ndef greet(name) = \"Hello, \#{name}\" # a comment that runs on, and scrolls sideways rather than wrapping\n```\n\n| a | b |\n|---|---|\n| 1 | 2 |" } %>
    <% end %>
    <%= render "ui/message", align: :start, role: "assistant", avatar: @agents.first do %>
      <%= render("ui/bubble") { render "ui/markdown", text: "A second reply in the same run." } %>
    <% end %>
    <%= render "ui/time", at: Time.utc(2026, 11, 2, 14, 5) %>
    <%= render("ui/message", align: :start, role: "assistant", avatar: @agents.first) { render "ui/typing" } %>
  </div>
  <%= render "ui/marker" do %>An inline marker.<% end %>
  <%= render "ui/marker", variant: :separator do %>A separator marker<% end %>
  <%= render "ui/shimmer", text: "Summarising earlier messages…" %>

  <h2 id="avatar">Avatar and Skeleton</h2>
  <p class="components__row"><% @agents.each do |agent| %><%= agent_avatar agent %><% end %> <%= agent_avatar @agents.first, size: :sm %></p>
  <%= render "ui/skeleton" %>

  <h2 id="trace">Trace and Code block</h2>
  <% [ [ "Ran remember note", nil ], [ "Running search (wiki)…", :running ], [ "Waiting for you", :pending ], [ "Failed to run send email", :error ] ].each do |title, status| %>
    <%= render "ui/trace", title: title, status: status, open: status == :error do %>
      <%= render "ui/code_block", code: "{\n  \"key\": \"plan\"\n}", label: "Input" %>
    <% end %>
  <% end %>

  <h2 id="list">List, Details and Badge</h2>
  <ul class="list">
    <li class="list__item"><a class="list__link" href="#">A row</a><span class="list__meta">Meta</span></li>
    <li class="list__item"><a class="list__link" href="#">Another row</a><span class="conversation-row__badge">Waiting for you</span></li>
  </ul>
  <dl class="details"><dt>Model</dt><dd>Claude Sonnet</dd><dt>Status</dt><dd>Connected</dd></dl>

  <h2 id="settings">Settings: Group, Row, Switch, Status, Meter and Tile</h2>
  <p class="components__row">
    <% { "Connected" => "connected", "Needs sign-in" => "attention", "Error" => "error", "Off" => "off" }.each do |text, kind| %>
      <%= render "ui/status", text: text, kind: kind %>
    <% end %>
  </p>
  <p class="components__row"><%= settings_tile "models" %> <%= settings_tile "connectors" %> <%= connector_tile "wiki" %> <%= connector_tile "Gmail" %></p>
  <section class="ui-group" aria-labelledby="components_group">
    <h2 class="ui-group__title" id="components_group">A group</h2>
    <ul class="ui-group__rows">
      <li class="ui-row"><span class="ui-row__label">A value<span class="ui-row__detail">A line about it.</span></span><span class="ui-row__value">Value</span></li>
      <li><a class="ui-row" data-kind="link" href="#settings"><span class="ui-row__label">A row that drills in</span></a></li>
      <li class="ui-row">
        <label class="ui-row__label" for="components_switch">A switch<span class="ui-row__detail">Saves as it changes.</span></label>
        <span class="ui-row__value"><span class="ui-row__note">Off for one agent only</span><input type="checkbox" id="components_switch" role="switch" class="ui-switch" checked></span>
      </li>
      <li class="ui-row">
        <label class="ui-row__label" for="components_menu">A menu</label>
        <span class="ui-row__value"><select id="components_menu" class="ui-row__select"><option>Always ready</option><option>Looked up when needed</option></select></span>
      </li>
      <li class="ui-row"><span class="ui-row__label">A status</span><span class="ui-row__value"><%= render "ui/status", text: "Connected", kind: "connected" %></span></li>
    </ul>
    <p class="ui-group__help">One line of help under the group.</p>
  </section>
  <% [ [ 38, "ok" ], [ 58, "near" ], [ 70, "over" ] ].each do |count, level| %>
    <div class="ui-meter" data-level="<%= level %>">
      <span class="ui-meter__label" id="components_meter_<%= level %>"><%= count %> of 64 tools</span>
      <span class="ui-meter__bar" role="meter" aria-valuemin="0" aria-valuemax="64" aria-valuenow="<%= count %>"
            aria-labelledby="components_meter_<%= level %>" style="--value: <%= [ count * 100 / 64, 100 ].min %>%"></span>
    </div>
  <% end %>
  <div class="settings__empty"><p>An empty state teaches the next step.</p><a class="button" href="#settings">One primary action</a></div>

  <h2 id="canvas">Canvas: Document card, Canvas and History</h2>
  <p class="muted">A document the agent wrote, as its card in the thread, open in the canvas (View, Edit, History), and its history.</p>
  <div class="components__row">
    <%= render "conversations/documents/card", document: @document, conversation: @conversation %>
    <%= render "conversations/documents/card", document: @code, conversation: @conversation, verb: "Edited" %>
  </div>
  <div class="components__canvas">
    <%= render "conversations/documents/canvas", document: @document, conversation: @conversation, focus: false %>
  </div>
  <div class="components__canvas">
    <%= render "conversations/documents/canvas", document: @code, conversation: @conversation, focus: false,
          draft: "#{@code.body}# Unsaved: still in the box.\n", problem: "Trip planner changed this while you were editing. Your words are still here." %>
  </div>
  <%= render "conversations/documents/versions", document: @document, conversation: @conversation, versions: @document.versions.reverse %>
</section>
