<% content_for :title, "Apple Watch · Settings" %>
<%# The Apple Watches that have a token of their own (Watch), each with when it last asked, and Revoke; with none,
    that there is none. The phone's app makes a token when its Watch asks, so connecting one starts on the iPhone. -%>
<header class="settings__header"><h1>Apple Watch</h1></header>

<section class="ui-group" id="watches" aria-labelledby="watches_title">
  <h2 class="ui-group__title" id="watches_title">Apple Watch</h2>
  <ul class="ui-group__rows">
    <% @watches.each do |watch| %>
      <li class="ui-row">
        <span class="ui-row__label">
          <%= watch.name %>
          <span class="ui-row__detail">
            <% if watch.last_used_at %>
              Last used <%= tag.time "#{time_ago_in_words(watch.last_used_at)} ago", datetime: watch.last_used_at.iso8601 %>
            <% else %>
              Not used yet
            <% end %>
            · Added <%= tag.time "#{time_ago_in_words(watch.created_at)} ago", datetime: watch.created_at.iso8601 %>
          </span>
        </span>
        <span class="ui-row__value">
          <%= button_to "Revoke", watch_path(watch), method: :delete, class: "button", form_class: "inline",
                data: { variant: "ghost", size: "sm", turbo_confirm: "Revoke #{watch.name}? It stops at once. A Watch still paired with your iPhone connects again, with a new token, when the iPhone app opens." },
                aria: { label: "Revoke #{watch.name}" } %>
        </span>
      </li>
    <% end %>
    <% if @watches.none? %>
      <li class="ui-row"><span class="ui-row__label">No Apple Watch is connected.</span></li>
    <% end %>
  </ul>
  <p class="ui-group__help" id="watches_help">
    To connect one, install the app on the Watch, then open this app on the iPhone it is paired with: the iPhone
    gives the Watch a token of its own. Revoke one that is lost or no longer yours.
  </p>
</section>
