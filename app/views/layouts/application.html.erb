<!DOCTYPE html>
<%# The accent's hue (APP__ACCENT_HUE), from which tokens.css derives every shade of it. A Hotwire Native app
    draws its own bar, so its pages say so and the web's header steps aside (layout.css). -%>
<%= tag.html lang: "en", style: "--accent-hue: #{DurableAssistants.accent_hue}", data: { native_app: ("" if hotwire_native_app?) } do %>
  <head>
    <title><%= [ content_for(:title), app_name ].compact_blank.uniq.join(" · ") %></title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="description" content="<%= app_name %>: your agents.">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= app_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)">
    <%# Turbo moves between pages with a view transition where the browser has them (layout.css times it). -%>
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%# With credentials, as the page itself is fetched. -%>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json), crossorigin: "use-credentials" %>
    <%# The icon in the accent (IconsController). Full bleed for iOS, which rounds the corners itself. -%>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Settings' own pieces load on its pages alone (layouts/settings), as the screen's viewer does: a thread never needs them. -%>
    <%= stylesheet_link_tag(*(app_stylesheets_paths - %w[ settings.css ]), "data-turbo-track": "reload") %>
    <%= javascript_importmap_tags %>
    <%= rybbit_tag %>
  </head>

  <%= tag.body data: ({ controller: "shortcuts", action: "keydown@document->shortcuts#press", shortcuts_new_agent_value: new_agent_path,
        shortcuts_settings_value: settings_path } if signed_in?) do %>
    <% if signed_in? %>
      <header class="app-header">
        <%= content_for(:back) || link_to(root_path, class: "app-header__brand") { image_tag("/icons/favicon.svg", alt: "", width: 22, height: 22) + app_name } %>
        <%# Settings has its own way out, and You signs out. -%>
        <% unless content_for?(:settings) %>
          <div class="app-header__actions">
            <%= link_to "Settings", settings_path, class: "button", data: { variant: "ghost", size: "sm" }, title: "Settings (⌘,)" %>
            <%= button_to "Sign out", sign_out_path, method: :delete, class: "button", data: { variant: "ghost", size: "sm" }, form_class: "inline",
                  form: { data: { controller: "drafts", action: "submit->drafts#clear" } } %>
          </div>
        <% end %>
      </header>
    <% end %>
    <main class="app-main">
      <%= render "layouts/confirm" if signed_in? %>
      <%# "Saved" is the settings' own quiet word (layouts/settings), not a toast. -%>
      <div id="flash" class="toasts"><%= render "layouts/flash", messages: flash.to_hash.except("saved") %></div>
      <%= content_for?(:settings) ? yield(:settings) : yield %>
    </main>
  <% end %>
<% end %>
