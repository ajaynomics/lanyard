<% content_for :title, "New agent" %>
<% content_for :back, link_to("‹ Agents", conversations_path, class: "app-header__back") %>

<section class="page">
  <header class="page__header"><h1>New agent</h1></header>

  <%= form_with model: @agent || Agent.new, class: "form" do |form| %>
    <% if @from %>
      <%# A new request id each time the form shows: a double submit makes one copy, and a retry after a
          failure is a new request, since the sidecar ties an id to the agent it was for, which was not kept. -%>
      <%= hidden_field_tag :from, @from.id %>
      <%= hidden_field_tag :request_id, SecureRandom.uuid %>
      <p class="field__hint" id="agent_from">
        Starts with a copy of <%= @from.conversation.agent %>'s thread up to its reply from
        <%= tag.time l(@from.created_at, format: :long), datetime: @from.created_at.iso8601, data: { controller: "local-time" } %>,
        and its instructions, skills and notes.
      </p>
    <% end %>
    <div class="field" data-controller="address-preview" data-address-preview-url-value="<%= agents_address_path %>">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, maxlength: 200, autofocus: true, class: "input", autocomplete: "off",
            aria: { describedby: "agent_address_hint" }, data: { address_preview_target: "name", action: "input->address-preview#preview" } %>
      <%= render "agents/address", name: form.object.name.to_s %>
    </div>
    <div class="field">
      <%= label_tag "agent_purpose", "What it is for (optional)" %>
      <%= text_area_tag "agent[purpose]", params.dig(:agent, :purpose), id: "agent_purpose", rows: 4, maxlength: 4000, class: "input",
            placeholder: "Plans our trips: flights, hotels and the calendar." %>
      <p class="field__hint">It starts its instructions. Or tell it in your first message. Each agent has its own memory and computer.</p>
    </div>
    <% if (last = Current.user.model_source) %>
      <% model = ModelCatalog.choices(including: last.model).find { it.id == last.model } %>
      <p class="field__hint">Uses <%= model&.label || last.model %>, like <%= last %>. Change it later in its settings, or with /model in its thread.</p>
    <% end %>
    <div class="form__actions"><%= form.submit "Start", class: "button" %></div>
  <% end %>
</section>
<%= javascript_import_module_tag "settings" %>
