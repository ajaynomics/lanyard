<%# A new agent whose thread starts as a copy of this one up to this reply (AgentsController#new, from). A GET to the
    form, so nothing is made until the person names it. Quiet, as Copy is: on hover with a mouse, on a tap on a touch screen. -%>
<%# locals: (message:) -%>
<%= link_to new_agent_path(from: message.id), class: "button message__action", title: "Start a new agent with a copy of this thread up to here",
      data: { variant: "ghost", size: "sm" } do %>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/></svg>
  <span class="message__label">New agent from here</span>
<% end %>
