<%# An outside contact and the agent that answers them, with Remove for the owner. -%>
<li class="ui-row" id="<%= dom_id(contact_route) %>">
  <span class="ui-row__label">
    <%= contact_route %>
    <span class="ui-row__detail">Answered by <%= contact_route.agent %></span>
  </span>
  <% if contact_route.workspace.owner == Current.user %>
    <span class="ui-row__value">
      <%= button_to "Remove", workspace_contact_route_path(contact_route.workspace, contact_route), method: :delete,
            class: "button", form_class: "inline", data: { variant: "ghost", size: "sm", turbo_confirm: "Stop routing #{contact_route} to #{contact_route.agent}?" } %>
    </span>
  <% end %>
</li>
