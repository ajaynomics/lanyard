<% content_for :title, "Edit #{@bot.name}" %>
<% content_for :back, link_to("‹ #{@bot.name}", @bot, class: "app-header__back") %>

<section class="page">
  <header class="page__header"><h1>Edit <%= @bot.name %></h1></header>

  <%= form_with model: @bot, class: "form" do |form| %>
    <% if @bot.errors.any? %>
      <p class="flash" data-kind="alert" role="alert"><%= @bot.errors.full_messages.to_sentence %></p>
    <% end %>
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, class: "input" %>
    </div>
    <div class="field">
      <%= form.label :instructions %>
      <%= form.text_area :instructions, rows: 14, required: true, class: "input" %>
      <p class="field__hint">Markdown. Applies from the next message; every saved version is kept.</p>
    </div>
    <div class="field-row">
      <div class="field">
        <%= form.label :model %>
        <%= form.select :model, Bot.models, {}, class: "input" %>
      </div>
      <div class="field">
        <%= form.label :thinking_level, "Thinking" %>
        <%= form.select :thinking_level, Bot::THINKING_LEVELS, {}, class: "input" %>
      </div>
      <div class="field">
        <%= form.label :time_zone %>
        <%= form.time_zone_select :time_zone, nil, {}, class: "input" %>
      </div>
    </div>
    <fieldset class="field">
      <legend>Tools</legend>
      <%= hidden_field_tag "bot[tool_names][]", "", id: nil %>
      <% Tool::Catalog::TOOLS.each_value do |tool| %>
        <label class="choice">
          <%= check_box_tag "bot[tool_names][]", tool.tool_name, @bot.tool_names.include?(tool.tool_name), id: "tool_#{tool.tool_name}" %>
          <span><strong><%= tool.tool_name.humanize %></strong><%= " (asks you first)" if tool.asks %><br><span class="muted"><%= tool.description %></span></span>
        </label>
      <% end %>
    </fieldset>
    <div class="form__actions"><%= form.submit "Save", class: "button" %></div>
  <% end %>
</section>
