<%# Where the agent's own calendars live, for the workspace's owner alone (Agents::CalendarServersController). No password: only the vault entry's name. -%>
<% server = @calendar_server || agent.calendar_server || Agent::CalendarServer.new %>
<section class="ui-group" id="calendar_server" aria-labelledby="channel_calendar_server">
  <h2 class="ui-group__title" id="channel_calendar_server">Calendar server</h2>
  <%= form_with model: server, scope: :calendar_server, url: agent_calendar_server_path(agent), method: :patch, class: "ui-group" do |form| %>
    <% if server.errors.any? %>
      <p class="flash" data-kind="alert" role="alert"><%= server.errors.full_messages.to_sentence %></p>
    <% end %>
    <ul class="ui-group__rows">
      <li class="ui-row">
        <%= form.label :url, "Server", class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.url_field :url, class: "input", placeholder: "https://caldav.example.com/calendars/agent/", autocomplete: "off", spellcheck: false %></span>
      </li>
      <li class="ui-row">
        <%= form.label :vault_entry, "Saved sign-in", class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.text_field :vault_entry, class: "input", placeholder: "Its name in the password manager", autocomplete: "off", spellcheck: false %></span>
      </li>
    </ul>
    <div class="form__actions"><%= form.submit "Save calendar server", class: "button" %></div>
  <% end %>
  <p class="ui-group__help">
    <% if server.persisted? && server.errors.none? %>
      <%= agent.name %> keeps its calendars and task lists on <%= server.host %>, signing in with the saved username and password, which it never sees<%= ", in place of its account on #{URI(DurableAssistants::Caldav.url).host}" if DurableAssistants::Caldav.configured? %>.
      Remove it to use <%= DurableAssistants::Caldav.configured? ? "the account above" : "no calendar of its own" %> again.
    <% else %>
      The address of its calendars on a CalDAV server of its own, the home that holds them (not the server's top), for its own calendars and task lists. The account's username and password are saved in the password manager, with the server's address, and shared with <%= agent.name %>. Only you see this.
    <% end %>
  </p>
  <% if server.persisted? %>
    <div class="page__actions">
      <%= button_to "Remove", agent_calendar_server_path(agent), method: :delete, class: "button", form_class: "inline",
            data: { variant: "outline", turbo_confirm: "Stop #{agent.name} using its calendars on #{URI(server.url_in_database).host}?" } %>
    </div>
  <% end %>
</section>
