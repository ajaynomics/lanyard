<%# The settings' sidebar, and on a phone the list /settings starts from: the places (settings_groups), then every
    agent; the open agent's sections under it. In the phone app it is the Settings tab: Notifications and the Watch
    say their status, and Version and Sign out follow. -%>
<%# locals: (agent:) -%>
<ul class="settings-nav">
  <% settings_groups.first(3).flat_map(&:last).each do |id, name, path| %>
    <li>
      <%= link_to (hotwire_native_app? ? settings_native_path(id, path) : path), class: "settings-nav__link", aria: { current: ("page" if settings_current?(path)) } do %>
        <% if id == "account" %>
          <%= person_avatar Current.user %>
          <span class="settings-nav__label"><%= name %> <span class="settings-nav__detail"><%= Current.user.email %></span></span>
        <% else %>
          <%= settings_tile id %><span class="settings-nav__label"><%= name %></span>
          <% if hotwire_native_app? && (value = settings_value(id)) %><span class="settings-nav__value"><%= value %></span><% end %>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>

<h2 class="settings-nav__title" id="settings_agents">Agents</h2>
<ul class="settings-nav" aria-labelledby="settings_agents">
  <% Current.workspace.agents.order(:name, :id).each do |each| %>
    <li>
      <%= link_to agent_path(each), class: "settings-nav__link", aria: { current: ("page" if settings_current?(agent_path(each), exact: true)) } do %>
        <%= agent_avatar each %><span class="settings-nav__label"><%= each %></span>
      <% end %>
      <% if each == agent %>
        <ul class="settings-nav__sections" aria-label="<%= each %>">
          <% agent_sections(each).drop(1).each do |label, path| %>
            <li><%= link_to label, path, class: "settings-nav__section", aria: { current: ("page" if settings_current?(path)) } %></li>
          <% end %>
        </ul>
      <% end %>
    </li>
  <% end %>
</ul>

<%= render "settings/native_rows" if hotwire_native_app? && settings_index? %>
