<%# One conversation in the tree, with its branches nested under it. Columns only: the family is strict_loading. -%>
<%# locals: (node:, tree:) -%>
<% active_at = node.last_message_at || node.created_at %>
<li class="tree__node">
  <%= link_to node, node, class: "tree__title", aria: { current: ("page" if node == tree.current) } %>
  <div class="tree__meta">
    <% if node.parent_id && node.forked_at_entry_id.nil? %>
      <span>From the start</span>
    <% elsif (message = tree.fork_point(node)) %>
      <%= link_to "after: #{message.said.squish.truncate(60)}", conversation_path(message.conversation_id, anchor: dom_id(message)) %>
    <% end %>
    <%= tag.time "#{time_ago_in_words(active_at)} ago", datetime: active_at.iso8601, title: l(active_at, format: :long) %>
    <span><%= pluralize(tree.message_count(node), "message") %></span>
    <% if node.archived? %>
      <span class="conversation-row__badge">Archived</span>
    <% end %>
  </div>
  <% if (children = tree.children(node)).any? %>
    <ul class="tree__children">
      <%= render partial: "conversations/trees/node", collection: children, as: :node, locals: { tree: tree } %>
    </ul>
  <% end %>
</li>
