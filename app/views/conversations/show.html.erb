<% content_for :title, @conversation %>
<%# Answering a card redirects back here: the page morphs in place, keeping the scroll and any panel the person opened. -%>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%# Below the sidebar's width, Agents opens it as a side panel. Wider, the sidebar is the way back, and the
    header gives the window its title bar and nothing else (layout.css). -%>
<% content_for :back do %>
  <button type="button" class="button app-header__back chat-panel__open" data-variant="ghost" data-size="sm"
          aria-haspopup="dialog" aria-controls="agents_panel"
          data-controller="panel" data-action="panel#open click@window->panel#closeOnBackdrop turbo:before-cache@document->panel#close">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/></svg>
    Agents
  </button>
<% end %>

<%= turbo_stream_from @conversation %>
<%# A connector that breaks or recovers redraws the Connectors button. -%>
<%= turbo_stream_from Current.user, :connectors %>
<div class="chat-layout">
  <dialog id="agents_panel" class="chat-panel" aria-label="Agents">
    <%= render "conversations/sidebar", agent: @agent, conversations: @conversations, current: @conversation.root || @conversation %>
  </dialog>

  <div class="chat" data-controller="message-scroller stream-guard echo"
       data-action="turbo:submit-start->echo#show turbo:before-frame-render->message-scroller#hold turbo:frame-render->message-scroller#restore">
    <header class="chat__header">
      <div class="chat__heading">
        <%= agent_avatar @agent %>
        <h1 class="chat__title" id="<%= dom_id(@conversation, :title) %>"><%= @conversation %></h1>
        <%# The pencil and /name share this form. A morph after saving closes it. -%>
        <details class="chat__rename">
          <summary class="button" data-variant="ghost" data-size="icon" aria-label="Rename" title="<%= @conversation.parent_id ? "Rename this branch" : "Rename this agent" %>">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          </summary>
          <%= form_with model: @conversation, id: "rename_form", class: "chat__rename-form" do |form| %>
            <%= form.text_field :title, value: @conversation.to_s, required: true, maxlength: 200, class: "input",
                  aria: { label: @conversation.parent_id ? "Branch name" : "Agent name" }, data: { command_argument: true } %>
            <%= form.submit "Rename", class: "button", data: { size: "sm" } %>
          <% end %>
        </details>
      </div>
      <%= render "conversations/status", conversation: @conversation %>
      <%# The agent's other doings fold into one menu (shadcn: DropdownMenu), a native popover, so the header keeps one line. -%>
      <button type="button" class="button chat__more" data-variant="ghost" data-size="icon" popovertarget="chat_actions" aria-label="More" title="More: Connectors, the screen, settings, archiving">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
      </button>
      <div class="chat__actions" id="chat_actions" popover>
        <% attention = @conversation.connectors_needing_attention %>
        <%= link_to agent_tools_path(@agent), id: "connectors_button", class: "button", data: { variant: "outline", size: "sm" } do %>
          Connectors<% if attention.positive? %> <span class="connectors-badge">· <%= attention %> <%= attention == 1 ? "needs" : "need" %> you</span><% end %>
        <% end %>
        <%= link_to "Open screen", conversation_screen_path(@conversation), class: "button", data: { variant: "outline", size: "sm" } if @conversation.screen? %>
        <%= link_to "New agent", new_agent_path, class: "button chat__new", data: { variant: "outline", size: "sm" } %>
        <%= link_to "#{@agent} settings", @agent, class: "button", data: { variant: "outline", size: "sm" } %>
        <% archivable = @conversation.root || @conversation %>
        <% if archivable.archived? %>
          <%= button_to "Unarchive agent", conversation_archive_path(archivable), method: :delete, class: "button", data: { variant: "outline", size: "sm" } %>
        <% else %>
          <%= button_to "Archive agent", conversation_archive_path(archivable), class: "button", data: { variant: "outline", size: "sm" } %>
        <% end %>
      </div>
    </header>

    <div class="chat__viewport" role="log" aria-live="polite" data-message-scroller-target="viewport"
         data-controller="clean-copy" data-action="copy->clean-copy#copy">
      <% if (parent = @conversation.parent) %>
        <p class="chat__branch">
          Branched from <%= link_to parent, parent %>. <%= link_to "See all branches", conversation_tree_path(@conversation) %>.
          <%= "It has its own computer, which starts empty." if @agent.computer&.on? %>
        </p>
      <% end %>
      <div id="messages" class="chat__messages" data-controller="reveal" data-action="click->reveal#toggle">
        <% if @page.messages.empty? %>
          <%= render "conversations/empty", conversation: @conversation %>
        <% end %>
        <%= render "conversations/page", page: @page %>
      </div>
      <%= render "conversations/live", conversation: @conversation, working: @conversation.status == "running",
            compacting: @conversation.compacting?, compaction_failed: @conversation.compaction_failed? %>
      <%= render "conversations/usage", conversation: @conversation %>
    </div>

    <button type="button" class="chat__jump button" data-variant="outline" data-size="sm" hidden
            data-message-scroller-target="jump" data-action="message-scroller#jump">Jump to latest</button>

    <%= render "conversations/composer", conversation: @conversation, draft: @draft %>

    <%= render "conversations/help", agent: @agent %>

    <%# What the echo controller shows the moment a message is sent. It sorts after every committed entry. -%>
    <template data-echo-target="message">
      <%= render "ui/message", align: :end, role: "user", data: { pending: true, entry_id: 2**53 - 1 } do %>
        <%= render("ui/bubble", variant: :primary) { tag.p(class: "ui-bubble__text") } %>
      <% end %>
    </template>
    <template data-echo-target="working">
      <%= render("ui/message", align: :start, role: "assistant", avatar: @agent) { render "ui/typing" } %>
    </template>
  </div>
</div>
