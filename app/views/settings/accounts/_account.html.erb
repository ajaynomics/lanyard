<%# You: who is signed in, the name the app calls them by (saved as it changes; blank goes back to the part of
    their email before the @), and signing out. -%>
<header class="settings__header">
  <%= person_avatar Current.user, size: :lg %>
  <h1>You</h1>
</header>

<section class="ui-group">
  <%= form_with model: Current.user, url: settings_account_path, method: :patch, id: "user_name_form",
        data: { controller: "autosave", action: "change->autosave#save" } do |form| %>
    <ul class="ui-group__rows">
      <li class="ui-row">
        <%= form.label :name, class: "ui-row__label" %>
        <span class="ui-row__value">
          <%= form.text_field :name, value: (Current.user.name if Current.user.named?), maxlength: User::NAME_LIMIT,
                class: "ui-row__input", autocomplete: "name", placeholder: Current.user.to_s,
                aria: { describedby: "user_name_help", invalid: (Current.user.errors[:name].any? || nil) } %>
        </span>
      </li>
      <li class="ui-row"><span class="ui-row__label">Email</span><span class="ui-row__value"><%= Current.user.email %></span></li>
    </ul>
  <% end %>
  <p class="ui-group__help" id="user_name_help">What this app calls you. Your email comes from your <%= DurableAssistants::Oidc.label %> account; change it there.</p>
</section>

<%= render "settings/accounts/notifications", subscriptions: Push.configured? ? Current.user.push_subscriptions.order(:created_at) : [] %>

<section class="ui-group">
  <ul class="ui-group__rows">
    <li class="ui-row">
      <%= button_to "Sign out", sign_out_path, method: :delete, class: "button", data: { variant: "ghost" }, form_class: "inline",
            form: { data: { controller: "drafts", action: "submit->drafts#clear" } } %>
    </li>
  </ul>
  <p class="ui-group__help">Signing out forgets messages you had started but not sent on this device.</p>
</section>
