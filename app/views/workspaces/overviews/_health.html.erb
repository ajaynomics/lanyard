<%# One workspace on the Overview (Workspace::Health): its agents and how each stands, the cards waiting, what failed in the last day and
    its held Campfire rooms, each a link to the page that deals with it. Every section shows, empty or not, so each block reads the same.
    A link into another workspace opens it there. -%>
<%# locals: (health:) -%>
<% workspace = health.workspace %>
<section class="workspace-health" id="workspace_health_<%= workspace.id %>" aria-labelledby="workspace_health_<%= workspace.id %>_title">
  <h2 class="workspace-health__title" id="workspace_health_<%= workspace.id %>_title">
    <%= link_to workspace, workspace_path(workspace) %>
    <span class="workspace-health__detail">· <%= workspace.personal? ? "Yours" : pluralize(workspace.memberships.size, "person") %></span>
  </h2>

  <section class="ui-group" aria-label="Agents in <%= workspace %>">
    <h3 class="ui-group__title">Agents</h3>
    <ul class="ui-group__rows">
      <% health.agents.each do |agent| %>
        <li>
          <%= link_to agent.conversation ? conversation_path(agent.conversation) : agent_path(agent), class: "ui-row", data: { kind: "link" } do %>
            <%= agent_avatar(agent) %>
            <span class="ui-row__label"><%= agent %></span>
            <span class="ui-row__value"><% health.states(agent).each do |state| %><%= agent_state(state) %><% end %></span>
          <% end %>
        </li>
      <% end %>
      <% if health.agents.none? %>
        <li><div class="ui-row"><span class="ui-row__label">No agents yet</span></div></li>
      <% end %>
    </ul>
  </section>

  <section class="ui-group" aria-label="Waiting in <%= workspace %>">
    <h3 class="ui-group__title">Waiting for you<%= " · #{health.cards.size}" if health.cards.any? %></h3>
    <ul class="ui-group__rows">
      <% health.cards.each do |card| %>
        <li>
          <%= link_to approval_path(card), class: "ui-row", data: { kind: "link" } do %>
            <%= agent_avatar(card.agent) %>
            <span class="ui-row__label">
              <%= card.approval_title || card.card_title %>
              <span class="ui-row__detail"><%= card.agent %> · waiting <%= time_ago_in_words(card.created_at) %></span>
            </span>
            <span class="ui-row__value">
              <%= health.stuck?(card) ? render("ui/status", text: "Stuck", kind: "error") : render("ui/status", text: "Waiting", kind: "attention") %>
            </span>
          <% end %>
        </li>
      <% end %>
      <% if health.cards.none? %>
        <li><div class="ui-row"><span class="ui-row__label">Nothing is waiting</span></div></li>
      <% end %>
    </ul>
    <%= tag.p "Stuck: waiting over an hour, or expiring within the hour.", class: "ui-group__help" if health.cards.any? %>
  </section>

  <section class="ui-group" aria-label="Errors in <%= workspace %>">
    <h3 class="ui-group__title">Recent errors</h3>
    <ul class="ui-group__rows">
      <% health.in_error.each do |agent| %>
        <li>
          <%= link_to conversation_path(agent.conversation), class: "ui-row", data: { kind: "link" } do %>
            <%= agent_avatar(agent) %>
            <span class="ui-row__label">
              Couldn't finish its last run
              <span class="ui-row__detail"><%= [ agent, ("#{time_ago_in_words(agent.conversation.error_told_at)} ago" if agent.conversation.error_told_at),
                truncate(failure_text(agent.conversation.failure).presence || "Its last run ended in an error.", length: 160) ].compact.join(" · ") %></span>
            </span>
            <span class="ui-row__value"><%= render "ui/status", text: "Error", kind: "error" %></span>
          <% end %>
        </li>
      <% end %>
      <% health.failed_calls.each do |call| %>
        <li>
          <%= link_to conversation_path(call.conversation), class: "ui-row", data: { kind: "link" } do %>
            <%= agent_avatar(call.agent) %>
            <span class="ui-row__label">
              <%= tool_label(call.tool_name, call.arguments).upcase_first %> failed
              <span class="ui-row__detail"><%= call.agent %> · <%= time_ago_in_words(call.updated_at) %> ago · <%= truncate(call.error.to_s, length: 160) %></span>
            </span>
            <span class="ui-row__value"><%= render "ui/status", text: "Error", kind: "error" %></span>
          <% end %>
        </li>
      <% end %>
      <% if health.in_error.none? && health.failed_calls.none? %>
        <li><div class="ui-row"><span class="ui-row__label">None in the last 24 hours</span></div></li>
      <% end %>
    </ul>
  </section>

  <section class="ui-group" aria-label="Held rooms in <%= workspace %>">
    <h3 class="ui-group__title">Held rooms</h3>
    <ul class="ui-group__rows">
      <% health.held_rooms.each do |room| %>
        <li>
          <%= link_to workspace_path(workspace, anchor: "campfire"), class: "ui-row", data: { kind: "link" } do %>
            <span class="ui-row__label">
              <%= health.room_name(room) %>
              <span class="ui-row__detail">Held after a reply loop, <%= Workspace::CampfireRoom::SPINNING %> messages in a minute ·
                <%= tag.time "#{time_ago_in_words(room.held_at)} ago", datetime: room.held_at.iso8601 %></span>
            </span>
            <span class="ui-row__value"><%= render "ui/status", text: "Held", kind: "attention" %></span>
          <% end %>
        </li>
      <% end %>
      <% if health.held_rooms.none? %>
        <li><div class="ui-row"><span class="ui-row__label">None</span></div></li>
      <% end %>
    </ul>
    <%= tag.p "A person's next message to any of its agents starts a held room again.", class: "ui-group__help" if health.held_rooms.any? %>
  </section>
</section>
