<% content_for :title, @conversation %>
<%# Answering a card redirects back here: the page morphs in place, keeping the scroll and any panel the person opened. -%>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% content_for :back, link_to("‹ #{@agent}", agent_conversations_path(@agent), class: "app-header__back") %>

<%= turbo_stream_from @conversation %>
<%# A connector that breaks or recovers redraws the Connectors button. -%>
<%= turbo_stream_from Current.user, :connectors %>
<div class="chat-layout">
  <%= render "conversations/sidebar", agent: @agent, conversations: @conversations, current: @conversation %>

  <div class="chat" data-controller="message-scroller stream-guard echo" data-action="turbo:submit-start->echo#show">
    <header class="chat__header">
      <div class="chat__heading">
        <h1 class="chat__title" id="<%= dom_id(@conversation, :title) %>"><%= @conversation %></h1>
        <%# The pencil and /name share this form. A morph after saving closes it. -%>
        <details class="chat__rename">
          <summary class="button" data-variant="ghost" data-size="icon" title="Rename this conversation">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
            <span class="visually-hidden">Rename</span>
          </summary>
          <%= form_with model: @conversation, id: "rename_form", class: "chat__rename-form" do |form| %>
            <%= form.text_field :title, value: @conversation.title, required: true, maxlength: 200, class: "input",
                  aria: { label: "Conversation name" }, data: { command_argument: true } %>
            <%= form.submit "Rename", class: "button", data: { size: "sm" } %>
          <% end %>
        </details>
      </div>
      <%= render "conversations/status", conversation: @conversation %>
      <div class="chat__actions">
        <% attention = @conversation.connectors_needing_attention %>
        <%= link_to conversation_connectors_path(@conversation), id: "connectors_button", class: "button", data: { variant: "outline", size: "sm" } do %>
          Connectors<% if attention.positive? %> <span class="connectors-badge">· <%= attention %> <%= attention == 1 ? "needs" : "need" %> you</span><% end %>
        <% end %>
        <%= link_to "Open screen", conversation_screen_path(@conversation), class: "button", data: { variant: "outline", size: "sm" } if @conversation.screen? %>
        <%= button_to "New conversation", agent_conversations_path(@agent), params: { request_id: SecureRandom.uuid },
              class: "button chat__new", data: { variant: "outline", size: "sm" }, form_class: "inline" %>
      </div>
    </header>

    <div class="chat__viewport" role="log" aria-live="polite" data-message-scroller-target="viewport">
      <% if (parent = @conversation.parent) %>
        <p class="chat__branch">
          Branched from <%= link_to parent, parent %>. <%= link_to "See all branches", conversation_tree_path(@conversation) %>.
          <%= "It has its own computer, which starts empty." if @agent.computer&.on? %>
        </p>
      <% end %>
      <div id="messages" class="chat__messages">
        <% if @messages.empty? %>
          <%= render "conversations/empty", conversation: @conversation %>
        <% end %>
        <%= render partial: "messages/message", collection: @messages, as: :message, locals: { invocations: @invocations, results: @results, placed: @placed } %>
      </div>
      <%= render "conversations/live", conversation: @conversation, working: @conversation.status == "running",
            compacting: @conversation.compacting?, compaction_failed: @conversation.compaction_failed? %>
      <%= render "conversations/usage", conversation: @conversation %>
    </div>

    <button type="button" class="chat__jump button" data-variant="outline" data-size="sm" hidden
            data-message-scroller-target="jump" data-action="message-scroller#jump">Jump to latest</button>

    <%= render "conversations/composer", conversation: @conversation, draft: @draft %>

    <%= render "conversations/help", agent: @agent %>

    <%# What the echo controller shows the moment a message is sent. It sorts after every committed entry. -%>
    <template data-echo-target="message">
      <%= render "ui/message", align: :end, role: "user", data: { pending: true, entry_id: 2**53 - 1 } do %>
        <%= render("ui/bubble") { tag.p(class: "ui-bubble__text") } %>
      <% end %>
    </template>
    <template data-echo-target="working">
      <%= render("ui/message", align: :start, role: "assistant") { render "ui/shimmer", text: "Working…" } %>
    </template>
  </div>
</div>
