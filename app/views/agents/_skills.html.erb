<%# locals: (agent:) -%>
<section id="skills" class="agent-records">
  <header class="page__header">
    <h2>Skills</h2>
    <%= link_to "Add a skill", new_agent_skill_path(agent), class: "button", data: { variant: "outline", size: "sm" } %>
  </header>
  <p class="muted">
    Instructions <%= agent %> reads when a task calls for them. It sees each skill's name and description,
    and opens the rest when it needs it. Type <code>/skill:</code> and a name in a conversation to use one yourself.
  </p>
  <% if agent.skills.any? %>
    <ul class="list">
      <% agent.skills.each do |skill| %>
        <li class="list__item" id="<%= dom_id(skill) %>">
          <span><strong><%= skill.name %></strong><br><span class="muted"><%= skill.description.truncate(240) %></span></span>
          <span class="list__meta">
            <%= link_to "Edit", edit_agent_skill_path(agent, skill), class: "button", data: { variant: "ghost", size: "sm" } %>
            <%= button_to "Remove", agent_skill_path(agent, skill), method: :delete, class: "button", form_class: "inline",
                  data: { variant: "ghost", size: "sm", turbo_confirm: "Remove the #{skill.name} skill?" } %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
