<% content_for :title, "Screen of #{@conversation}" %>
<% content_for :head, stylesheet_link_tag("screen") %>
<% content_for :back, link_to(@conversation.to_s, @conversation, class: "app-header__back", data: { up: true }) %>

<div class="screen-page">
  <%= render "conversations/screen_passes/share", conversation: @conversation, passes: @passes, link: nil %>
  <%= render "conversations/screens/screen", held: @held, waking_from_cold: @waking_from_cold %>
</div>
