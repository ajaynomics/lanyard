<section class="ui-group" id="api_key_<%= api_key.provider.underscore %>" aria-labelledby="api_key_<%= api_key.provider.underscore %>_title">
  <h2 class="ui-group__title" id="api_key_<%= api_key.provider.underscore %>_title"><%= api_key.name %></h2>

  <% if !api_key.configured? %>
    <p class="muted">This server isn't set up for a <%= api_key.name %>.</p>
  <% else %>
    <ul class="ui-group__rows">
      <li class="ui-row">
        <span class="ui-row__label">Status
          <span class="ui-row__detail"><%= api_key.set? ? "Key ending #{api_key.hint}" : "No key saved." %></span>
        </span>
        <span class="ui-row__value"><%= render "ui/status", text: api_key.set? ? "Connected" : "Off", kind: api_key.set? ? "connected" : "off" %></span>
      </li>
    </ul>
    <p class="ui-group__help">Billed by Anthropic per token, separately from any subscription. Only agents on an API key model use it; choose one in an agent's settings.</p>
    <details class="settings__advanced">
      <summary>Advanced</summary>
      <p class="muted">The key serves models whose route starts <code><%= api_key.provider %>/</code>; those starting <code><%= api_key.provider.delete_suffix("-api") %>/</code>
        use the subscription. In a thread, <code>/model <%= api_key.provider %></code> switches to it.</p>
    </details>

    <%= form_with scope: :api_key, url: subscription_key_path(api_key), method: :patch, class: "form", data: { turbo: false } do |form| %>
      <%= form.hidden_field :version, value: api_key.version %>
      <div class="field">
        <%= form.label :key, api_key.set? ? "New key" : "Key", for: "api_key_key_#{api_key.provider.underscore}" %>
        <%= form.password_field :key, id: "api_key_key_#{api_key.provider.underscore}", class: "input", autocomplete: "off", spellcheck: false,
              required: true, placeholder: "sk-ant-…" %>
      </div>
      <div class="form__actions"><%= form.submit "Save key", class: "button" %></div>
    <% end %>

    <% if api_key.set? %>
      <div class="page__actions">
        <%= button_to "Remove key", subscription_key_path(api_key), method: :delete, params: { version: api_key.version },
              class: "button", data: { variant: "outline", turbo_confirm: "Remove the #{api_key.name}? Agents on its models stop until a key is saved again." } %>
      </div>
    <% end %>
  <% end %>
</section>
