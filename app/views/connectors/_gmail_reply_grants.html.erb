<%# locals: (connector:) -%>
<% grants = connector.gmail_reply_grants.includes(:agent).order(:address).to_a %>
<% agents = connector.workspace.agents.where.not(id: grants.map(&:agent_id)).order(:name) %>
<section class="ui-group" id="gmail_reply_grants" aria-labelledby="gmail_reply_grants_title">
  <h2 class="ui-group__title" id="gmail_reply_grants_title">Gmail replies without asking</h2>
  <p class="ui-group__help">Allow one address per agent on this connector. It must be the only recipient, appear in To or Cc, and already be in the Gmail thread. New email, drafts, and other writes still follow their usual approval rules.</p>
  <% if grants.any? %>
    <ul class="ui-group__rows">
      <% grants.each do |grant| %>
        <li class="ui-row">
          <span class="ui-row__label"><%= grant.agent.name %><span class="ui-row__detail"><%= grant.address %></span></span>
          <span class="ui-row__value"><%= button_to "Revoke", connector_gmail_reply_grant_path(connector, grant), method: :delete,
              class: "button", data: { variant: "outline" }, aria: { label: "Revoke reply grant for #{grant.agent.name} to #{grant.address}" } %></span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="ui-group__help">No reply grants.</p>
  <% end %>
  <% if !connector.signed_in? %>
    <p class="ui-group__help">Sign in to Gmail before allowing replies.</p>
  <% elsif agents.any? %>
    <%= form_with scope: :gmail_reply_grant, url: connector_gmail_reply_grants_path(connector), class: "ui-group" do |form| %>
      <ul class="ui-group__rows">
        <li class="ui-row">
          <%= form.label :agent_id, "Agent", class: "ui-row__label" %>
          <span class="ui-row__value"><%= form.collection_select :agent_id, agents, :id, :name, { include_blank: "Choose an agent" }, required: true, class: "input ui-row__select" %></span>
        </li>
        <li class="ui-row">
          <%= form.label :address, "Approved address", class: "ui-row__label" %>
          <span class="ui-row__value"><%= form.email_field :address, class: "input ui-row__input", placeholder: "name@example.net",
              required: true, maxlength: 254, autocomplete: "off", spellcheck: false %></span>
        </li>
      </ul>
      <div class="form__actions"><%= form.submit "Allow replies", class: "button" %></div>
    <% end %>
  <% end %>
</section>
