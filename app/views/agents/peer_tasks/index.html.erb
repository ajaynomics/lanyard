<% content_for :title, "Concourse tasks · #{@agent.name}" %>

<header class="settings__header"><h1>Concourse tasks</h1></header>

<% groups = { "outbound" => "Waiting on others", "inbound" => "Waiting on #{@agent.name}" } %>
<% if @tasks.any? %>
  <% groups.each do |direction, heading| %>
    <% next unless (tasks = @tasks[direction]) %>
    <section class="ui-group" aria-labelledby="<%= direction %>_tasks">
      <h2 class="ui-group__title" id="<%= direction %>_tasks"><%= heading %></h2>
      <ul class="ui-group__rows">
        <% tasks.each do |task| %>
          <li class="ui-row" id="<%= dom_id(task) %>">
            <span class="ui-row__label"><%= direction == "outbound" ? "To" : "From" %> <%= task.peer %>
              <span class="ui-row__detail"><%= task.state_words %> · <%= direction == "outbound" ? "sent" : "came in" %> <%= time_ago_in_words(task.created_at) %> ago<% if task.updated_at > task.created_at + 1.minute %>, last news <%= time_ago_in_words(task.updated_at) %> ago<% end %></span>
              <span class="ui-row__detail">Task <%= task.task_id.first(8) %></span>
            </span>
            <span class="ui-row__value">
              <%= link_to task.conversation.parent_id ? "Open branch" : "Open thread", conversation_path(task.conversation), class: "button", data: { variant: "ghost", size: "sm" } %>
            </span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
  <p class="ui-group__help">Tasks drop off this list once they are completed, failed, rejected or cancelled. <%= @agent.name %> settles its own.</p>
<% else %>
  <div class="settings__empty">
    <p>No open tasks. Requests <%= @agent.name %> sends over Concourse, and requests it receives, show here until they are settled.</p>
  </div>
<% end %>
