<% content_for :title, "#{@agent.name} · Settings" %>

<header class="settings__header">
  <%= agent_avatar @agent, size: :lg %>
  <div class="settings__heading">
    <h1><%= @agent.name %></h1>
    <% if @agent.title %><p class="settings__title"><%= @agent.title %></p><% end %>
  </div>
</header>
<%= render "agents/cache_warning", agent: @agent %>

<%# Its name may change; its address only by its workspace's owner (Agents::EmailAddressesController). -%>
<section class="ui-group" id="agent_identity">
  <ul class="ui-group__rows">
    <li class="ui-row">
      <%= form_with model: @agent, id: "agent_rename", class: "ui-row__value", data: { controller: "autosave", action: "change->autosave#save" } do |form| %>
        <%= form.label :name, class: "ui-row__label" %>
        <%= form.text_field :name, maxlength: 200, required: true, class: "ui-row__input", autocomplete: "off",
              aria: { invalid: (@agent.errors[:name].any? || nil), describedby: ("agent_name_error" if @agent.errors[:name].any?) } %>
        <% if @agent.errors[:name].any? %><p class="field__error" id="agent_name_error"><%= @agent.errors.full_messages_for(:name).to_sentence %></p><% end %>
      <% end %>
    </li>
    <% if @agent.own_address %>
      <li class="ui-row">
        <% if @agent.owned_by?(Current.user) && !@agent.mail_primary? && !@agent.email_name_fixed? %>
          <%= form_with model: @agent, url: agent_email_address_path(@agent), method: :patch, id: "agent_email_address", class: "ui-row__value" do |form| %>
            <%= form.label :email_name, "Email address", class: "ui-row__label" %>
            <%# A refusal follows the field (config/initializers/field_errors.rb). -%>
            <%= form.text_field :email_name, value: params.dig(:agent, :email_name) || @agent.email_name, required: true, maxlength: 64, class: "ui-row__input", autocomplete: "off" %>
            <span>@<%= @agent.workspace.agents_mail_domain %></span>
            <%= form.button "Change", class: "button", data: { variant: "outline", size: "sm",
                  turbo_confirm: "Change #{@agent.name}'s address? #{@agent.email_address} stops taking new mail. Replies in threads it started from there still reach it." } %>
          <% end %>
        <% else %>
          <span class="ui-row__label">Email address</span>
          <span class="ui-row__value"><%= @agent.own_address %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
  <p class="ui-group__help">
    <%= if @agent.mail_primary? then "It uses its own mail account alone, which you change in its Channels. A new name keeps its threads."
        elsif @agent.email_address && @agent.email_name_fixed? then "A new name keeps its threads. It keeps its address while its computer is install-managed SSH: the computer's folder is named after the address."
        elsif @agent.email_address then "A new name keeps its threads and its address. Only its workspace's owner changes the address; mail to the old one then reaches nobody, except replies to mail it sent from there."
        else "A new name keeps its threads."
        end %>
  </p>
</section>

<%= render "agents/workspace", agent: @agent %>

<%# Paused, it runs no turn and holds what it is sent; resumed, it reads those in order (Agent::Pausable). -%>
<section class="ui-group" id="agent_pause" aria-label="Pause">
  <ul class="ui-group__rows">
    <li class="ui-row">
      <span class="ui-row__label"><%= @agent.paused? ? "Paused" : @agent.resuming? ? "Resuming" : "Running" %></span>
      <span class="ui-row__value">
        <% if @agent.paused? %>
          <%= button_to "Resume", agent_pause_path(@agent), method: :delete, class: "button", form_class: "inline", data: { variant: "outline", size: "sm" } %>
        <% elsif !@agent.resuming? %>
          <%= button_to "Pause", agent_pause_path(@agent), class: "button", form_class: "inline", data: { variant: "outline", size: "sm" } %>
        <% end %>
      </span>
    </li>
  </ul>
  <p class="ui-group__help">
    <%= @agent.paused? ? "Paused #{time_ago_in_words(@agent.paused_at)} ago. #{@agent.name} runs no turn and spends nothing; what it is sent waits on its thread. Resuming sends it all, in order." :
          @agent.resuming? ? "#{@agent.name} runs again, and is sent what it held, in order, then what came since." :
          "Pausing stops #{@agent.name} at its next step, and holds what anyone sends it until you resume it. Cards waiting on you stay." %>
  </p>
</section>

<%# Whether its cards reach its people as priority notifications, or as regular ones (Push.level). It decides how
    every member is interrupted, so only the workspace's owner changes it; anyone else sees it read-only. -%>
<% owner = @agent.owned_by?(Current.user) %>
<section class="ui-group" id="agent_notifications" aria-labelledby="agent_notifications_title">
  <h2 class="ui-group__title" id="agent_notifications_title">Notifications</h2>
  <ul class="ui-group__rows">
    <%= render "settings/switch_row", id: "agent_priority_notifications", url: agent_priority_notifications_path(@agent),
          param: "agent[priority_notifications]", on: @agent.priority_notifications?, label: "Priority", disabled: !owner,
          detail: [ (@agent.priority_notifications? ? "A card waiting on you makes a sound, reaches your Watch and comes through a Focus." :
            "Its cards go quietly to Notification Centre, as its replies do, grouped by thread."),
            ("Only #{@agent.workspace.owner} changes this." unless owner) ].compact.join(" ") %>
  </ul>
  <p class="ui-group__help">Replies and errors always arrive quietly. Which kinds reach you at all is in your <%= link_to "Notifications", settings_notifications_path %>.</p>
</section>

<% if owner && session[:email].present? && session[:email].casecmp?(Current.user.email) && (invite_review_url = DurableAssistants::Concourse.invite_review_url) %>
  <section class="ui-group" aria-labelledby="agent_concourse_title">
    <h2 class="ui-group__title" id="agent_concourse_title">Concourse</h2>
    <div class="ui-group__body">
      <%= link_to "Add on Concourse", invite_review_url, id: "concourse_invite_review", class: "button", rel: "noreferrer", data: { turbo: false } %>
    </div>
    <p class="ui-group__help">Choose a network on Concourse, then fill out and submit the invitation there.</p>
  </section>
<% end %>

<%# Saved as each field changes; the page morphs in place. Thinking offers only the levels the model has. -%>
<%= form_with model: @agent, id: "agent_general", data: { controller: "autosave thinking-levels", action: "change->autosave#save" } do |form| %>
  <section class="ui-group" aria-label="Title">
    <ul class="ui-group__rows">
      <li class="ui-row">
        <%= form.label :title, class: "ui-row__label" %>
        <span class="ui-row__value">
          <%= form.text_field :title, maxlength: Agent::TITLE_LIMIT, class: "ui-row__input", autocomplete: "off", placeholder: "Personal Assistant",
                aria: { describedby: "agent_title_help", invalid: (@agent.errors[:title].any? || nil) } %>
        </span>
      </li>
    </ul>
    <p class="ui-group__help" id="agent_title_help">What <%= @agent.name %> does, beside its name in your list of agents. It's told its title from the next message.</p>
  </section>
  <% choices = ModelCatalog.choices(including: @agent.model) %>
  <% chosen = choices.find { it.id == @agent.model } || choices.first %>
  <section class="ui-group" aria-label="Model">
    <ul class="ui-group__rows">
      <li class="ui-row">
        <%= form.label :model, class: "ui-row__label" %>
        <span class="ui-row__value">
          <%= form.select :model, choices.map { |choice| [ choice.option_label, choice.id,
                { data: { thinking_levels: choice.thinking_levels.map { [ Agent::THINKING_LEVEL_NAMES[it], it ] }.to_json } } ] },
                {}, class: "ui-row__select", data: { thinking_levels_target: "model", action: "thinking-levels#offer" } %>
        </span>
      </li>
      <li class="ui-row">
        <%= form.label :thinking_level, "Thinking", class: "ui-row__label" %>
        <span class="ui-row__value">
          <%= form.select :thinking_level, options_for_select(chosen.thinking_levels.map { [ Agent::THINKING_LEVEL_NAMES[it], it ] }, chosen.level_for(@agent.thinking_level)),
                {}, class: "ui-row__select", data: { thinking_levels_target: "level" } %>
        </span>
      </li>
      <% if (claude_routes = Agent.claude_routes | [ @agent.claude_route ].compact).any? %>
        <li class="ui-row">
          <%= form.label :claude_route, "Claude account", class: "ui-row__label" %>
          <span class="ui-row__value">
            <%= form.select :claude_route, claude_routes, { include_blank: "The install's order" }, class: "ui-row__select", aria: { describedby: "agent_claude_route_help" } %>
          </span>
        </li>
      <% end %>
      <li class="ui-row">
        <%= form.label :time_zone, class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.time_zone_select :time_zone, nil, {}, class: "ui-row__select" %></span>
      </li>
    </ul>
    <p class="ui-group__help" id="agent_claude_route_help">Thinking is how much the model thinks before it answers: more is slower and costs more.<% if claude_routes.any? %> Claude's models go through the Claude account chosen here first, then the install's others in order when it reaches its usage limit.<% end %><% if @agent.claude_route_dropped? %> <strong id="agent_claude_route_dropped"><%= @agent.claude_route %> is no longer one of this server's Claude accounts, so its calls follow the install's order.</strong><% end %> Each change applies from the next message.</p>
  </section>
<% end %>

<%# On a phone the sections are rows to tap into, as an app's page in iOS Settings; beside the sidebar they are in it. -%>
<section class="ui-group settings__sections" aria-label="<%= @agent %>'s sections">
  <ul class="ui-group__rows">
    <% agent_sections(@agent).drop(1).each do |label, path| %>
      <li><%= link_to path, class: "ui-row", data: { kind: "link" } do %><span class="ui-row__label"><%= label %></span><% end %></li>
    <% end %>
  </ul>
</section>

<%# Agents endure: deleting one asks for its name, typed. -%>
<section class="ui-group" id="delete_agent" aria-labelledby="delete_agent_title">
  <h2 class="ui-group__title" id="delete_agent_title">Delete agent</h2>
  <%= form_with url: agent_path(@agent), method: :delete, class: "ui-group__body form" do |form| %>
    <p>
      Deleting <%= @agent.name %> deletes its thread, notes, routines and documents.
      <%= "Its address, #{@agent.email_address}, stops working. " if @agent.email_address && !@agent.mail_primary? %>
      <%= "Its Campfire bot is removed. " if @agent.campfire_bot %>
      <% if @agent.computer&.ssh? %>
        Its folder on <%= @agent.computer.ssh_host %> is left as it is.
      <% elsif @agent.computer&.configured_ssh? %>
        Its folder on the SSH computer is left as it is.
      <% elsif @agent.computer %>
        Its computer and everything on it are deleted.
      <% end %>
      This can't be undone.
    </p>
    <% if (promotion = @agent.reports_on_departure) %><p><%= promotion %></p><% end %>
    <div class="field">
      <%= form.label :confirm_name, "Type #{@agent.name} to confirm" %>
      <%= form.text_field :confirm_name, value: nil, required: true, autocomplete: "off", spellcheck: false, class: "input",
            aria: { invalid: (@confirm_error.present? || nil), describedby: ("confirm_name_error" if @confirm_error) } %>
      <% if @confirm_error %><p class="field__error" id="confirm_name_error"><%= @confirm_error %></p><% end %>
    </div>
    <div class="form__actions"><%= form.submit "Delete #{@agent.name}", class: "button", data: { variant: "destructive" } %></div>
  <% end %>
</section>

<details class="settings__advanced">
  <summary>Advanced</summary>
  <dl class="details">
    <dt>Model route</dt><dd><code><%= @agent.model %></code></dd>
    <dt>Thinking level</dt><dd><code><%= @agent.thinking_level %></code></dd>
    <dt>Revisions kept</dt><dd><%= @agent.revisions.count %></dd>
  </dl>
</details>
