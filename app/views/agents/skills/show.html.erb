<% content_for :title, "#{@skill.name} · Skills" %>

<header class="settings__header">
  <h1><%= @skill.name %></h1>
  <%= link_to "Edit", edit_agent_skill_path(@agent, @skill), class: "button", data: { variant: "outline", size: "sm" } %>
</header>

<% if @skill.needs_review? %>
  <p class="flash" data-kind="alert" role="status">
    <%= @agent %> can't use this skill yet. It has <%= @skill.review_reason %>, which go on <%= @agent %>'s computer<%= ", where it could run them" if @skill.programs.any? %>.
    Read every file below, then approve or reject it at the bottom.
  </p>
<% elsif @skill.rejected? %>
  <p class="flash" data-kind="alert" role="status">You rejected this skill, so <%= @agent %> doesn't see it. Remove it, or approve it after all at the bottom.</p>
<% end %>

<section class="ui-group" aria-labelledby="skill_about">
  <h2 class="ui-group__title" id="skill_about">About</h2>
  <ul class="ui-group__rows">
    <li class="ui-row"><span class="ui-row__label">Description<span class="ui-row__detail"><%= @skill.description %></span></span></li>
    <li class="ui-row"><span class="ui-row__label">State</span><span class="ui-row__value"><%= skill_state(@skill) %></span></li>
    <li class="ui-row">
      <span class="ui-row__label">Files</span>
      <span class="ui-row__value"><%= pluralize(@skill.files.size + 1, "file") %>, <%= skill_file_size(@skill.to_markdown.bytesize + @skill.files.sum(&:size)) %></span>
    </li>
    <% if @skill.github? %>
      <li class="ui-row" id="skill_source">
        <span class="ui-row__label">From GitHub<span class="ui-row__detail"><%= link_to @skill.github_source, @skill.github_url, target: "_blank", rel: "noopener noreferrer" %></span></span>
        <span class="ui-row__value">
          <code title="<%= @skill.github_sha %>"><%= @skill.github_sha.first(7) %></code>
          <%= link_to "Check for update", agent_skill_update_path(@agent, @skill), class: "button", data: { variant: "outline", size: "sm" } %>
        </span>
      </li>
    <% end %>
  </ul>
  <% if @skill.folder? %>
    <p class="ui-group__help">
      When <%= @agent %> reads this skill, its files go to <code><%= @skill.location %></code> on its computer, if it has one. Without a computer it gets the SKILL.md alone.
    </p>
  <% end %>
</section>

<section class="ui-group" aria-labelledby="skill_files">
  <h2 class="ui-group__title" id="skill_files">Contents</h2>
  <div class="skill-files">
    <details class="skill-file" <%= "open" unless @skill.folder? %>>
      <summary class="skill-file__summary"><code>SKILL.md</code><span class="skill-file__size"><%= skill_file_size(@skill.to_markdown.bytesize) %></span></summary>
      <%= skill_file_contents(Skill::Folder::MARKDOWN, @skill.to_markdown) %>
    </details>
    <% @skill.files.each do |file| %>
      <details class="skill-file" id="<%= dom_id(file) %>" <%= "open" if file.executable && !@skill.ready? %>>
        <summary class="skill-file__summary">
          <code><%= file.path %></code>
          <% if file.executable %><span class="ui-status" data-kind="attention"><span class="ui-status__dot"></span>Program</span><% end %>
          <span class="skill-file__size"><%= skill_file_size(file.size) %></span>
        </summary>
        <%= skill_file_contents(file.path, file.content) %>
      </details>
    <% end %>
  </div>
</section>

<% unless @skill.ready? %>
  <section class="ui-group" aria-labelledby="skill_review">
    <h2 class="ui-group__title" id="skill_review">Review</h2>
    <div class="ui-group__body skill-review">
      <p>
        Approve only if you've read <%= @skill.files.any? ? "its SKILL.md and every file" : "it" %> and are happy for <%= @agent %> to have them on its computer<%= " and run its programs" if @skill.programs.any? %>.
        A change to its SKILL.md or any of its files asks you again.
      </p>
      <div class="form__actions">
        <%= button_to "Approve", agent_skill_approval_path(@agent, @skill), params: { digest: @skill.contents_digest }, class: "button", form_class: "inline" %>
        <% if @skill.needs_review? %>
          <%= button_to "Reject", agent_skill_rejection_path(@agent, @skill), class: "button", form_class: "inline", data: { variant: "outline" } %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<div class="form__actions">
  <%= button_to "Remove", agent_skill_path(@agent, @skill), method: :delete, class: "button", form_class: "inline",
        data: { variant: "ghost", turbo_confirm: "Remove the #{@skill.name} skill?" }, aria: { label: "Remove #{@skill.name}" } %>
</div>
