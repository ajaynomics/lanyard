<% content_for :title, @conversation %>
<%# Answering a card redirects back here: the page morphs in place, keeping the scroll and any panel the person opened. -%>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<%= turbo_stream_from @conversation %>
<%= turbo_stream_from Current.user, :conversations %>
<%# A connector that breaks or recovers redraws the Connectors button. -%>
<%= turbo_stream_from Current.user, :connectors %>
<%= tag.div class: "chat-layout", style: sidebar_width_style, data: { controller: "panel", action: "turbo:before-cache@document->panel#closeNow" } do %>
  <dialog id="agents_panel" class="chat-panel" aria-label="Agents" data-panel-target="dialog"
          data-action="click->panel#closeOnBackdrop cancel->panel#cancel turbo:click->panel#closeNow pointerdown->panel#grab pointermove->panel#drag pointerup->panel#release pointercancel->panel#release">
    <%= render "conversations/sidebar", agent: @agent, conversations: @conversations, current: @conversation.root || @conversation %>
  </dialog>
  <%# The sidebar's edge, on a wide screen: drag it, or focus it and use the arrow keys, to set the sidebar's width. -%>
  <div class="chat-layout__resize" role="separator" aria-orientation="vertical" aria-controls="agents_panel" aria-label="Resize the agents list"
       tabindex="0" title="Drag to resize; double-click to reset" aria-valuemin="<%= sidebar_widths.min * 16 %>" aria-valuemax="<%= sidebar_widths.max * 16 %>"
       data-controller="sidebar-resize" data-sidebar-resize-min-value="<%= sidebar_widths.min %>" data-sidebar-resize-max-value="<%= sidebar_widths.max %>"
       data-action="pointerdown->sidebar-resize#grab pointermove->sidebar-resize#drag pointerup->sidebar-resize#release pointercancel->sidebar-resize#release lostpointercapture->sidebar-resize#release dblclick->sidebar-resize#reset keydown->sidebar-resize#key"></div>

  <div class="chat" data-controller="message-scroller stream-guard echo"
       data-action="turbo:submit-start->echo#show turbo:before-frame-render->message-scroller#hold turbo:frame-render->message-scroller#restore">
    <header class="chat__header">
      <%# A phone goes back to its list, as Messages does. Wider, but below the sidebar's width, Agents opens it as a
          side panel, from the left as a way back does. Wider still, the sidebar is the way back (layout.css). -%>
      <%= link_to "Agents", root_path, class: "app-header__back chat__back", data: { up: true } %>
      <button type="button" class="button chat-panel__open" data-variant="ghost" data-size="sm"
              aria-haspopup="dialog" aria-controls="agents_panel"
              data-action="panel#open">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Agents
      </button>
      <div class="chat__heading">
        <%= agent_avatar @agent %>
        <h1 class="chat__title" id="<%= dom_id(@conversation, :title) %>"><%= @conversation %></h1>
      </div>
      <%= render "conversations/status", conversation: @conversation %>
      <%# The agent's other doings fold into one menu (shadcn: DropdownMenu), a native popover, so the header keeps one line. -%>
      <button type="button" class="button chat__more" data-variant="ghost" data-size="icon" popovertarget="chat_actions" aria-label="More" title="More: tools, the screen, settings, archiving">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
      </button>
      <div class="chat__actions" id="chat_actions" popover>
        <% attention = @conversation.connectors_needing_attention %>
        <%= link_to agent_tools_path(@agent), id: "connectors_button", class: "button", data: { variant: "outline", size: "sm" } do %>
          Tools<% if attention.positive? %> <span class="connectors-badge">· <%= attention %> <%= attention == 1 ? "needs" : "need" %> you</span><% end %>
        <% end %>
        <%= link_to "Open screen", conversation_screen_path(@conversation), class: "button", data: { variant: "outline", size: "sm" } if @conversation.screen? %>
        <%= link_to "New agent", new_agent_path, class: "button chat__new", data: { variant: "outline", size: "sm" } %>
        <% if (latest = @conversation.latest_answer) %>
          <%= link_to "New agent from here", new_agent_path(from: latest.id), class: "button", data: { variant: "outline", size: "sm" },
                title: "A new agent whose thread starts as a copy of this one" %>
        <% end %>
        <%= link_to "#{@agent} settings", @agent, class: "button", data: { variant: "outline", size: "sm" } %>
        <% archivable = @conversation.root || @conversation %>
        <% if archivable.archived? %>
          <%= button_to "Unarchive agent", conversation_archive_path(archivable), method: :delete, class: "button", data: { variant: "outline", size: "sm" } %>
        <% else %>
          <%= button_to "Archive agent", conversation_archive_path(archivable), class: "button", data: { variant: "outline", size: "sm" } %>
        <% end %>
      </div>
    </header>

    <div class="chat__viewport" role="log" aria-live="polite" data-message-scroller-target="viewport"
         data-controller="clean-copy" data-action="copy->clean-copy#copy">
      <div id="messages" class="chat__messages" data-controller="reveal thread-times reading" data-reading-url-value="<%= conversation_reading_path(@conversation) %>" data-reading-unseen-value="<%= @fetched_ahead %>" data-action="click->reveal#toggle">
        <% if @page.messages.empty? %>
          <%= render "conversations/empty", conversation: @conversation %>
        <% end %>
        <%= render "conversations/page", page: @page %>
      </div>
      <%= render "conversations/live", conversation: @conversation, working: @conversation.status == "running",
            compacting: @conversation.compacting?, compaction_failed: @conversation.compaction_failed? %>
      <%= render "conversations/queued", conversation: @conversation, items: @conversation.queued %>
    </div>

    <%# Jump to latest floats just above the status line and composer, so nothing of theirs lies under it. -%>
    <div class="chat__footer">
      <button type="button" class="chat__jump button" data-variant="outline" data-size="sm" hidden
              data-message-scroller-target="jump" data-action="message-scroller#jump">Jump to latest</button>

      <%= render "conversations/status_line", conversation: @conversation %>
      <%= render "conversations/composer", conversation: @conversation, draft: @draft, share: @share %>
    </div>

    <%= render "conversations/help", agent: @agent %>

    <%# What the echo controller shows the moment a message is sent. It sorts after every committed entry. -%>
    <template data-echo-target="message">
      <%= render "ui/message", align: :end, role: "user", data: { pending: true, entry_id: 2**53 - 1 } do %>
        <%= render("ui/bubble", variant: :primary) { tag.p(class: "ui-bubble__text") } %>
      <% end %>
    </template>
    <template data-echo-target="working">
      <%= render("ui/message", align: :start, role: "assistant", avatar: @agent) { render "ui/typing" } %>
    </template>
  </div>

  <%# The canvas opens here, beside the thread (over it on a phone), from a document's card. It stays open as the
      page morphs; its id is the thread's, so another thread never shows it. -%>
  <%= turbo_frame_tag canvas_frame_id(@conversation), class: "canvas-frame", data: { turbo_permanent: true } %>
<% end %>
