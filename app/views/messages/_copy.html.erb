<%# Copies a reply's Markdown, as the model wrote it; /copy presses the last one. A phone shares it instead (clipboard_controller). -%>
<%# locals: (text:) -%>
<button type="button" class="button message__action" data-variant="ghost" data-size="sm" title="Copy this reply"
        data-controller="clipboard" data-clipboard-text-value="<%= text %>" data-action="clipboard#copy" data-copy-reply>
  <svg aria-hidden="true" class="message__copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
  <svg aria-hidden="true" class="message__share" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3m-4 4 4-4 4 4M8 11H6v10h12V11h-2"/></svg>
  <span class="message__label" data-clipboard-target="label">Copy</span>
</button>
