<% content_for :title, @conversation %>

<h1><%= @conversation %></h1>

<div id="<%= dom_id(@conversation, :invocations) %>">
  <%= render @conversation.invocations.order(:id) %>
</div>

<%= form_with url: conversation_submissions_path(@conversation), id: "composer" do |form| %>
  <%= hidden_field_tag :request_id, SecureRandom.uuid, id: nil %>
  <%= form.label :content, "Message" %>
  <%= form.text_area :content, required: true, rows: 3 %>
  <%= form.submit "Send" %>
<% end %>

<%= button_to "Stop", conversation_cancellations_path(@conversation), params: { request_id: SecureRandom.uuid }, id: "stop" %>
