<!DOCTYPE html>
<%# A Hotwire Native app draws its own bar, tab bar and transitions, so its pages say so: no header of the web's, no
    view transitions, and the bridge's controllers (native.js), which hand the page's actions to the app
    (docs/native-app.md). -%>
<%= tag.html lang: "en", data: { native_app: ("" if hotwire_native_app?) } do %>
  <head>
    <title><%= page_title %></title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="description" content="<%= app_name %>: your agents.">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= app_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)">
    <%# Turbo moves between pages with a view transition where the browser has them (layout.css times it); the
        phone app pushes and pops its own screens instead. -%>
    <%= tag.meta name: "view-transition", content: "same-origin" unless hotwire_native_app? %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= tag.meta name: "native-phone-session", content: "true", data: { turbo_track: "dynamic" } if hotwire_native_app? && phone_session? %>
    <%= yield :head %>

    <%# With credentials, as the page itself is fetched. -%>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json), crossorigin: "use-credentials" %>
    <%# The icon in the accent (IconsController). Full bleed for iOS, which rounds the corners itself. -%>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Settings' own pieces load on its pages alone (layouts/settings), the canvas's with the canvas, "Share with…"'s
        and the list of agents' on theirs, and a workspace's pages' with them, as the screen's viewer does: a thread
        never needs them until one opens. -%>
    <%= stylesheet_link_tag(*(app_stylesheets_paths - %w[ settings.css canvas.css share.css list.css native.css workspaces.css screen.css ]), "data-turbo-track": "reload") %>
    <%= stylesheet_link_tag "native", "data-turbo-track": "reload" if hotwire_native_app? %>
    <%# The accent's hue (APP__ACCENT_HUE, or the workspace's own: Brand), from which tokens.css derives every shade of
        it. In the head, after tokens.css, rather than on <html>: Turbo keeps <html> from page to page, but swaps a
        dynamic style, so switching to a workspace of another colour takes its colour at once. -%>
    <style data-turbo-track="dynamic">html:root { --accent-hue: <%= brand.accent_hue.to_i %>; }</style>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "native" if hotwire_native_app? %>
    <%= rybbit_tag %>
  </head>

  <%= tag.body data: ({ controller: "shortcuts", action: "keydown@document->shortcuts#press", shortcuts_new_agent_value: new_agent_path(workspace_id: Current.workspace&.id),
        shortcuts_settings_value: settings_path } if signed_in?) do %>
    <%# Cloudflare would hide every address here behind a script that decodes the page only once, at load, so an
        address in anything fetched later (a frame, an earlier page of a thread) would stay "[email protected]". -%>
    <!--email_off-->
    <% if signed_in? %>
      <%= turbo_stream_from Current.user, :badge %>
      <%= render "layouts/badge", count: Current.user.needs_you_count %>
      <%# The phone app's bar is its own: title, way back and actions (native.js), with Settings a tab. -%>
      <% unless hotwire_native_app? %>
        <header class="app-header">
          <%= content_for(:back) || link_to(root_path, class: "app-header__brand") { image_tag(brand_icon_path, alt: "", width: 22, height: 22) + app_name } %>
          <%# Settings has its own way out, and You signs out. -%>
          <% unless content_for?(:settings) %>
            <div class="app-header__actions">
              <%= link_to "Settings", settings_path, class: "button", data: { variant: "ghost", size: "sm" }, title: "Settings (⌘,)" %>
              <%= button_to "Sign out", sign_out_path, method: :delete, class: "button", data: { variant: "ghost", size: "sm" }, form_class: "inline",
                    form: { data: { controller: "drafts", action: "submit->drafts#clear" } } %>
            </div>
          <% end %>
        </header>
      <% end %>
    <% end %>
    <main class="app-main">
      <%= render "layouts/confirm" if signed_in? %>
      <%# "Saved" is the settings' own quiet word (layouts/settings), not a toast. -%>
      <div id="flash" class="toasts"><%= render "layouts/flash", messages: flash.to_hash.except("saved") %></div>
      <%= content_for?(:settings) ? yield(:settings) : yield %>
    </main>
    <% if content_for?(:reporting_picker) %>
      <%= turbo_frame_tag "reporting_picker" %>
      <div id="reporting_status" class="visually-hidden" role="status" aria-atomic="true"></div>
    <% end %>
    <!--/email_off-->
  <% end %>
<% end %>
