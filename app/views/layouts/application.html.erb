<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,interactive-widget=resizes-content">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= app_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#18181b" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%# With credentials, as the page itself is fetched. -%>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json), crossorigin: "use-credentials" %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= rybbit_tag %>
  </head>

  <body>
    <% if signed_in? %>
      <header class="app-header">
        <%= content_for(:back) || link_to(app_name, root_path, class: "app-header__brand") %>
        <%= button_to "Sign out", sign_out_path, method: :delete, class: "button", data: { variant: "ghost", size: "sm" }, form_class: "inline",
              form: { data: { controller: "drafts", action: "submit->drafts#clear" } } %>
      </header>
    <% end %>
    <main class="app-main">
      <%= render "layouts/confirm" if signed_in? %>
      <div id="flash" class="toasts"><%= render "layouts/flash", messages: flash %></div>
      <%= yield %>
    </main>
  </body>
</html>
