<% content_for :title, "Channels · #{@agent.name}" %>

<header class="settings__header"><h1>Channels</h1></header>
<p class="muted">How people and other agents reach <%= @agent.name %>, besides you here.</p>

<% if DurableAssistants::Email.configured? %>
  <section class="ui-group" aria-labelledby="channel_email">
    <h2 class="ui-group__title" id="channel_email">Email</h2>
    <ul class="ui-group__rows">
      <li class="ui-row">
        <span class="ui-row__label">Address</span>
        <span class="ui-row__value"><%= @agent.email_address %></span>
      </li>
    </ul>
    <p class="ui-group__help">Mail to this address reaches <%= @agent.name %>. Sending mail asks you first, unless you allowed it "Always".</p>
  </section>
<% end %>
<% if DurableAssistants::Concourse.configured? || CampfireBot.configured? %>
  <%# How the agent talks to others: Concourse's agents and Campfire's rooms, side by side; stacked on a phone. -%>
  <section class="channels" aria-labelledby="channels_others">
    <h2 class="ui-group__title" id="channels_others">Other agents and rooms</h2>
    <div class="channels__pair">
      <%= render "agents/concourse_agent", agent: @agent if DurableAssistants::Concourse.configured? %>
      <%= render "agents/campfire_bot", agent: @agent %>
    </div>
  </section>
<% end %>
<% unless channels? %>
  <div class="settings__empty"><p>This install has no channels set up: no email, Concourse or Campfire.</p></div>
<% end %>
