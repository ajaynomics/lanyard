# The example destination's secrets (config/deploy.example.yml). An install
# copies this to .kamal/secrets.<name> and replaces each resource id with its
# own Passbolt resource's id.
#
# Self-resolving: every value comes from Passbolt at deploy time, so
# `bin/kamal deploy -d <name>` needs no environment assembly. Nothing here is a
# stored value. Safe to commit.
#
# There is deliberately no `.kamal/secrets` or `.kamal/secrets-common`: Kamal
# reads those for every destination, and every line is resolved the moment one
# is read, so a shared file would run one destination's lookups during
# another's deploy.
#
# One Passbolt sign-in per file. bin/passbolt-fetch resolves every resource the
# file needs in a single call (NAME=<id> for the password, NAME=<id>:username,
# NAME=<id>:description, or NAME=<id>:description:KEY for one KEY=value line of
# the description); each line below then extracts its value in-process. A
# per-line `passbolt get` would cost a full sign-in each, about 3 s.
#
# If a resource is missing or blank, the fetch prints nothing, extract fails and
# Kamal stops; .kamal/hooks/pre-deploy still refuses a blank value as a second
# guard. A `$` inside a stored value does not survive Kamal's parser, so keep
# `$` out of these secrets.
#
# The ids below are placeholders (all zeros): until each is replaced, the fetch
# fails and Kamal stops, which is the point.

# Every Passbolt resource this destination needs, with one sign-in:
#   KAMAL_REGISTRY_PASSWORD  the registry's password
#   RAILS_MASTER_KEY         config/master.key
#   OIDC__CLIENT_ID/_SECRET  the sign-in client the OpenID Connect provider
#                            registered for this destination's callback address
#                            (web and job): username = client id, password = secret
#   PI_DURABLE__SIDECAR_TOKEN  Pi Durable (docs/agent.md): Rails presents it to the sidecar
#   PI_DURABLE__RAILS_TOKEN    the sidecar presents it to Rails; distinct from the other
#   SUBSCRIPTION_VAULT_KEY   the model-account grants' encryption key, 64 hex (agent role only)
#   SPRITES_TOKEN            the Sprites platform token (agent role only)
# The office (docs/office.md), each service's own:
#   PASSBOLT_DB_PASSWORD     the vault's database (passbolt-db and passbolt)
#   CAMPFIRE_SECRET_KEY_BASE, CAMPFIRE_VAPID_PRIVATE_KEY, CAMPFIRE_VAPID_PUBLIC_KEY
#   CODE_SECRET_KEY, CODE_INTERNAL_TOKEN   Forgejo's
#   CRM_DB_PASSWORD, CRM_DATABASE_URL (postgres://twenty:<password>@<service>-crm-db:5432/twenty),
#   CRM_APP_SECRET, CRM_ENCRYPTION_KEY     Twenty's
#   WIKI_DB_PASSWORD, WIKI_DATABASE_URL (postgres://outline:<password>@<service>-wiki-db:5432/outline),
#   WIKI_SECRET_KEY, WIKI_UTILS_SECRET     Outline's
#   WIKI_OIDC_CLIENT_ID/_SECRET  the wiki's sign-in client: username = id, password = secret
#   WIKI_SMTP_USERNAME/_PASSWORD  the mail account the wiki sends from: username = user (optional, docs/office.md)
# and the office's keys for its agents (web and job), each made after the
# office's first deploy; until one exists, leave it out here and in the
# destination file:
#   CAMPFIRE__ADMIN_EMAIL/_PASSWORD  a Campfire administrator: username = email
#   PASSBOLT__PRIVATE_KEY, PASSBOLT__PASSPHRASE  the agents' Passbolt user's armored key and passphrase
#   WIKI__API_KEY, CRM__API_KEY  each service's API key for the agents
PASSBOLT=$(bin/passbolt-fetch KAMAL_REGISTRY_PASSWORD=00000000-0000-0000-0000-000000000000 RAILS_MASTER_KEY=00000000-0000-0000-0000-000000000000 OIDC__CLIENT_ID=00000000-0000-0000-0000-000000000000:username OIDC__CLIENT_SECRET=00000000-0000-0000-0000-000000000000 PI_DURABLE__SIDECAR_TOKEN=00000000-0000-0000-0000-000000000000 PI_DURABLE__RAILS_TOKEN=00000000-0000-0000-0000-000000000000 SUBSCRIPTION_VAULT_KEY=00000000-0000-0000-0000-000000000000 SPRITES_TOKEN=00000000-0000-0000-0000-000000000000 PASSBOLT_DB_PASSWORD=00000000-0000-0000-0000-000000000000 CAMPFIRE_SECRET_KEY_BASE=00000000-0000-0000-0000-000000000000 CAMPFIRE_VAPID_PRIVATE_KEY=00000000-0000-0000-0000-000000000000 CAMPFIRE_VAPID_PUBLIC_KEY=00000000-0000-0000-0000-000000000000 CODE_SECRET_KEY=00000000-0000-0000-0000-000000000000 CODE_INTERNAL_TOKEN=00000000-0000-0000-0000-000000000000 CRM_DB_PASSWORD=00000000-0000-0000-0000-000000000000 CRM_DATABASE_URL=00000000-0000-0000-0000-000000000000 CRM_APP_SECRET=00000000-0000-0000-0000-000000000000 CRM_ENCRYPTION_KEY=00000000-0000-0000-0000-000000000000 WIKI_DB_PASSWORD=00000000-0000-0000-0000-000000000000 WIKI_DATABASE_URL=00000000-0000-0000-0000-000000000000 WIKI_SECRET_KEY=00000000-0000-0000-0000-000000000000 WIKI_UTILS_SECRET=00000000-0000-0000-0000-000000000000 WIKI_OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000:username WIKI_OIDC_CLIENT_SECRET=00000000-0000-0000-0000-000000000000 WIKI_SMTP_USERNAME=00000000-0000-0000-0000-000000000000:username WIKI_SMTP_PASSWORD=00000000-0000-0000-0000-000000000000 CAMPFIRE__ADMIN_EMAIL=00000000-0000-0000-0000-000000000000:username CAMPFIRE__ADMIN_PASSWORD=00000000-0000-0000-0000-000000000000 PASSBOLT__PRIVATE_KEY=00000000-0000-0000-0000-000000000000 PASSBOLT__PASSPHRASE=00000000-0000-0000-0000-000000000000 WIKI__API_KEY=00000000-0000-0000-0000-000000000000 CRM__API_KEY=00000000-0000-0000-0000-000000000000)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $PASSBOLT)
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY $PASSBOLT)
OIDC__CLIENT_ID=$(kamal secrets extract OIDC__CLIENT_ID $PASSBOLT)
OIDC__CLIENT_SECRET=$(kamal secrets extract OIDC__CLIENT_SECRET $PASSBOLT)
PI_DURABLE__SIDECAR_TOKEN=$(kamal secrets extract PI_DURABLE__SIDECAR_TOKEN $PASSBOLT)
PI_DURABLE__RAILS_TOKEN=$(kamal secrets extract PI_DURABLE__RAILS_TOKEN $PASSBOLT)
SUBSCRIPTION_VAULT_KEY=$(kamal secrets extract SUBSCRIPTION_VAULT_KEY $PASSBOLT)
SPRITES_TOKEN=$(kamal secrets extract SPRITES_TOKEN $PASSBOLT)
PASSBOLT_DB_PASSWORD=$(kamal secrets extract PASSBOLT_DB_PASSWORD $PASSBOLT)
CAMPFIRE_SECRET_KEY_BASE=$(kamal secrets extract CAMPFIRE_SECRET_KEY_BASE $PASSBOLT)
CAMPFIRE_VAPID_PRIVATE_KEY=$(kamal secrets extract CAMPFIRE_VAPID_PRIVATE_KEY $PASSBOLT)
CAMPFIRE_VAPID_PUBLIC_KEY=$(kamal secrets extract CAMPFIRE_VAPID_PUBLIC_KEY $PASSBOLT)
CODE_SECRET_KEY=$(kamal secrets extract CODE_SECRET_KEY $PASSBOLT)
CODE_INTERNAL_TOKEN=$(kamal secrets extract CODE_INTERNAL_TOKEN $PASSBOLT)
CRM_DB_PASSWORD=$(kamal secrets extract CRM_DB_PASSWORD $PASSBOLT)
CRM_DATABASE_URL=$(kamal secrets extract CRM_DATABASE_URL $PASSBOLT)
CRM_APP_SECRET=$(kamal secrets extract CRM_APP_SECRET $PASSBOLT)
CRM_ENCRYPTION_KEY=$(kamal secrets extract CRM_ENCRYPTION_KEY $PASSBOLT)
WIKI_DB_PASSWORD=$(kamal secrets extract WIKI_DB_PASSWORD $PASSBOLT)
WIKI_DATABASE_URL=$(kamal secrets extract WIKI_DATABASE_URL $PASSBOLT)
WIKI_SECRET_KEY=$(kamal secrets extract WIKI_SECRET_KEY $PASSBOLT)
WIKI_UTILS_SECRET=$(kamal secrets extract WIKI_UTILS_SECRET $PASSBOLT)
WIKI_OIDC_CLIENT_ID=$(kamal secrets extract WIKI_OIDC_CLIENT_ID $PASSBOLT)
WIKI_OIDC_CLIENT_SECRET=$(kamal secrets extract WIKI_OIDC_CLIENT_SECRET $PASSBOLT)
WIKI_SMTP_USERNAME=$(kamal secrets extract WIKI_SMTP_USERNAME $PASSBOLT)
WIKI_SMTP_PASSWORD=$(kamal secrets extract WIKI_SMTP_PASSWORD $PASSBOLT)
CAMPFIRE__ADMIN_EMAIL=$(kamal secrets extract CAMPFIRE__ADMIN_EMAIL $PASSBOLT)
CAMPFIRE__ADMIN_PASSWORD=$(kamal secrets extract CAMPFIRE__ADMIN_PASSWORD $PASSBOLT)
PASSBOLT__PRIVATE_KEY=$(kamal secrets extract PASSBOLT__PRIVATE_KEY $PASSBOLT)
PASSBOLT__PASSPHRASE=$(kamal secrets extract PASSBOLT__PASSPHRASE $PASSBOLT)
WIKI__API_KEY=$(kamal secrets extract WIKI__API_KEY $PASSBOLT)
CRM__API_KEY=$(kamal secrets extract CRM__API_KEY $PASSBOLT)
