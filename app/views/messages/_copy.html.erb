<%# Copies a reply's Markdown, as the model wrote it; /copy presses the last one. -%>
<%# locals: (text:) -%>
<button type="button" class="button message__action" data-variant="ghost" data-size="sm" title="Copy this reply"
        data-controller="clipboard" data-clipboard-text-value="<%= text %>" data-action="clipboard#copy" data-copy-reply>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
  <span class="message__label" data-clipboard-target="label">Copy</span>
</button>
