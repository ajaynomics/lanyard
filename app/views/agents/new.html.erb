<% content_for :title, "New agent" %>
<% content_for :back, link_to("‹ Agents", conversations_path, class: "app-header__back") %>

<section class="page">
  <header class="page__header"><h1>New agent</h1></header>

  <%= form_with model: Agent.new, class: "form" do |form| %>
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, maxlength: 200, autofocus: true, class: "input" %>
      <p class="field__hint">Then tell it, in your first message, what it is for. Each agent has its own memory and computer.</p>
    </div>
    <%= form.submit "Start", class: "button" %>
  <% end %>
</section>
