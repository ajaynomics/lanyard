<% content_for :title, "Update #{@skill.name}" %>

<header class="settings__header"><h1>Update <%= @skill.name %></h1></header>

<section class="ui-group" aria-labelledby="update_source">
  <h2 class="ui-group__title" id="update_source">From GitHub</h2>
  <ul class="ui-group__rows">
    <li class="ui-row">
      <span class="ui-row__label">Pinned to<span class="ui-row__detail"><%= link_to @skill.github_source, @skill.github_url, target: "_blank", rel: "noopener noreferrer" %></span></span>
      <span class="ui-row__value"><code title="<%= @skill.github_sha %>"><%= @skill.github_sha.first(7) %></code></span>
    </li>
    <% if @sha && !@error %>
      <li class="ui-row">
        <span class="ui-row__label">Latest<span class="ui-row__detail"><%= @skill.github_ref || "the default branch" %></span></span>
        <span class="ui-row__value"><code title="<%= @sha %>"><%= @sha.first(7) %></code></span>
      </li>
    <% end %>
  </ul>
</section>

<% if @error %>
  <p class="flash" data-kind="alert" role="alert">Couldn't check for an update: <%= @error %></p>
<% elsif @diff.nil? %>
  <p class="muted" id="update_none">This is the latest version. Nothing to update.</p>
<% elsif @diff.empty? %>
  <p class="muted" id="update_none">There's a newer commit, but nothing in this skill changed.</p>
  <%= button_to "Move the pin to #{@sha.first(7)}", agent_skill_update_path(@agent, @skill), params: { sha: @sha }, class: "button", data: { variant: "outline" } %>
<% else %>
  <section class="ui-group" aria-labelledby="update_changes">
    <h2 class="ui-group__title" id="update_changes">What changes (<%= pluralize(@diff.changes.size, "file") %>)</h2>
    <div class="skill-files">
      <% @diff.changes.each do |change| %>
        <details class="skill-file" open>
          <summary class="skill-file__summary">
            <code><%= change.path %></code>
            <span class="ui-status" data-kind="<%= { "added" => "connected", "removed" => "error", "changed" => "attention" }[change.status] %>"><span class="ui-status__dot"></span><%= change.status.capitalize %></span>
            <% if change.note %><span class="skill-file__size"><%= change.note %></span><% end %>
          </summary>
          <% if change.lines %>
            <pre class="skill-diff"><% change.lines.each do |sign, text| %><% if sign == "…" %><span class="skill-diff__line" data-sign="gap">… <%= pluralize(text, "line") %> unchanged</span><% else %><span class="skill-diff__line" data-sign="<%= { "+" => "add", "-" => "remove", " " => "same" }[sign] %>"><%= sign %> <%= text %></span><% end %><% end %></pre>
          <% end %>
        </details>
      <% end %>
    </div>
  </section>
  <p class="muted">
    Applying fetches <code><%= @sha.first(7) %></code> and pins the skill to it.
    If either version has files beside its SKILL.md, <%= @agent %> can't use the skill until you review it again.
  </p>
  <div class="form__actions">
    <%= button_to "Apply update", agent_skill_update_path(@agent, @skill), params: { sha: @sha }, class: "button", form_class: "inline" %>
    <%= link_to "Not now", agent_skill_path(@agent, @skill), class: "button", data: { variant: "ghost" } %>
  </div>
<% end %>
