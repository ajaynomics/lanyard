<% content_for :title, "Sign in" %>

<section class="sign-in">
  <img src="/icons/app.svg" alt="" class="sign-in__mark" width="64" height="64">
  <h1><%= app_name %></h1>
  <% if DurableAssistants::Oidc.configured? %>
    <p>Your agents, each with its own computer. Sign in with your <%= DurableAssistants::Oidc.label %> account.</p>
    <%= button_to "Sign in with #{DurableAssistants::Oidc.label}", ajent_auth_path, data: { turbo: false }, class: "button" %>
  <% elsif !Rails.env.development? %>
    <p>Sign-in is not set up here, so nobody can get in.</p>
  <% end %>
  <% if Rails.env.development? %>
    <%= button_to "Sign in as a local developer", development_session_path, data: { turbo: false, variant: "outline" }, class: "button" %>
  <% end %>
</section>
