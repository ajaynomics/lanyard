<%# Keep recipient grants visible and removable even while a send switch pauses them. -%>
<%# locals: (agent:, tool_name:) -%>
<% what = tool_label(tool_name) %>
<% agent.permissions.where(tool_name: tool_name).select(&:recipient_exception?).each do |permission| %>
  <li class="ui-row" data-kind="grant" id="<%= dom_id(permission, :unasked) %>">
    <span class="ui-row__label"><%= permission.recipient %>
      <span class="ui-row__detail"><%= agent.asks_every_send?(tool_name) ? "Not used while every send asks" : "Sent without asking" %> · added <%= l permission.created_at.to_date, format: :long %></span>
    </span>
    <span class="ui-row__value">
      <%= button_to "Remove", agent_permission_path(agent, permission), method: :delete, class: "button", form_class: "inline",
            data: { variant: "ghost", size: "sm", turbo_confirm: "Ask again before #{what} with #{permission.recipient}?" },
            aria: { label: "Remove: #{what} with #{permission.recipient}" } %>
    </span>
  </li>
<% end %>
