<%# One tool call and where it stands (shadcn: Tool, Confirmation). -%>
<%# locals: (invocation:, sheet: false) -%>
<%# sheet: alone, as the phone app's Needs you opens it (approvals/show). Answered there, the sheet closes and the list
    beneath refreshes; the phone draws Allow and Deny in its own bar (native/approval_controller). In a thread, or on
    the web, the buttons are the page's. A tap on either gives the phone's haptic, where there is one. -%>
<% name = invocation.tool_name == "use_tool" ? tool_label("use_tool", invocation.arguments) : invocation.tool_name.humanize(capitalize: false) %>
<div id="<%= invocation.dom_target %>" class="tool-call" data-state="<%= invocation.state %>">
  <% if invocation.call_name == "pay_by_card" && (payment = invocation.payment_request) %>
    <%= render "invocations/payment", invocation: invocation, payment: payment %>
  <% elsif invocation.answerable? && invocation.asks == :approval %>
    <%= render "ui/card", title: invocation.approval_title || "Allow #{name}?", class: "approval" do %>
      <% if (helper = invocation.helper) %>
        <p class="approval__from">From a helper working on: <%= helper.task.squish.truncate(120) %></p>
      <% end %>
      <% if (note = invocation.note_to_approver) %>
        <%# Set apart from what is approved, and labelled as the agent's, so it is never read as part of it. -%>
        <%= tag.aside class: "approval__note", aria: { label: "Note from #{invocation.agent}" } do %>
          <p class="approval__from">Note from <%= invocation.agent %></p>
          <%= simple_format h(note), {}, sanitize: false %>
        <% end %>
      <% end %>
      <% if !invocation.approvable? %>
        <p class="muted" role="status"><%= invocation.preview&.dig("error").then { it ? "Couldn't fetch the draft, so it can't be allowed: #{it}" : "Fetching the draft…" } %></p>
      <% else %>
        <% if invocation.preview&.dig("changed") %><p role="alert">The draft changed after you allowed it. This is what would go now.</p><% end %>
        <%= render "ui/fields", values: invocation.details %>
      <% end %>
      <% if (note = invocation.approval_note) %>
        <p class="muted"><%= note %></p>
      <% end %>
      <% if (description = (invocation.tool_class.try(:target, invocation.arguments["name"]) || invocation.tool_class)&.description.presence) %>
        <details class="ui-card__more"><summary>What it does</summary><p class="muted"><%= description %></p></details>
      <% end %>
      <%# As pi asks: once, always (Permission, listed on the agent's page), or not. -%>
      <% path = conversation_invocation_approval_path(invocation.conversation, invocation) %>
      <% choices = invocation.always_choices %>
      <% from = ({ from: "approvals" } if sheet) %>
      <% allowed = { controller: "bridge--haptic", action: "submit->bridge--haptic#vibrate", bridge_feedback: "success" } %>
      <%= tag.div class: "ui-card__actions", data: ({ controller: "native--approval", action: "turbo:submit-end->native--approval#failed" } if sheet) do %>
        <% if invocation.approvable? %>
          <%= button_to "Allow once", path, params: { decision: "approve", **from.to_h }, class: "button", form_class: "inline",
                form: { data: allowed }, data: { native__approval_target: "allow" } %>
        <% end %>
        <% if choices.include?("agent") %>
          <%= button_to "Always for this agent", path, params: { decision: "approve", always: "agent", **from.to_h }, class: "button", form_class: "inline",
                form: { data: allowed }, data: { variant: "outline" }, title: "Allow every #{name} from now on, without asking" %>
        <% end %>
        <% if choices.include?("recipient") %>
          <%= button_to invocation.always_label, path, params: { decision: "approve", always: "recipient", **from.to_h },
                class: "button", form_class: "inline", form: { data: allowed }, data: { variant: "outline" }, title: "Allow #{name} to these from now on, without asking" %>
        <% end %>
        <%= button_to "Deny", path, params: { decision: "deny", **from.to_h }, class: "button", form_class: "inline",
              form: { data: allowed.merge(bridge_feedback: "warning") }, data: { variant: "outline", native__approval_target: "deny" } %>
        <%= tag.p role: "alert", hidden: true, data: { native__approval_target: "failure" } if sheet %>
      <% end %>
    <% end %>
  <% elsif invocation.answerable? && invocation.asks == :question %>
    <%= render "invocations/question", invocation: invocation %>
  <% elsif invocation.answerable? && invocation.asks == :sign_in %>
    <%= render "invocations/sign_in", invocation: invocation %>
  <% elsif invocation.succeeded? && (link = invocation.sign_in_link) %>
    <%= render "invocations/sign_in_link", link: link %>
  <% elsif (dispatch = invocation.dispatch) && (dispatch.unknown? || dispatch.closed_by_id) %>
    <%= render "invocations/dispatch", dispatch: dispatch %>
  <% elsif invocation.succeeded? && (held = invocation.held_email) %>
    <%= render "invocations/held_email", held: held %>
  <% elsif (run = invocation.workflow_run) %>
    <%= render "workflow/runs/run", run: run %>
  <% elsif invocation.succeeded? && (document = invocation_document(invocation)) %>
    <%= render "conversations/documents/card", document: document, conversation: invocation.conversation,
          verb: invocation.tool_name == "edit_document" ? "Edited" : "Wrote" %>
  <% else %>
    <% title = case invocation.state
         when "succeeded" then "Ran #{name}"
         when "failed" then invocation.withdrawn? ? (invocation.asked_later? ? "Withdrew the question" : "Withdrew #{name}") :
           invocation.asked_later? ? "Closed the question unanswered" : "Failed to run #{name}"
         when "denied" then "Declined #{name}"
         when "awaiting_person" then "Waited too long to run #{name}"
         else "Running #{name}…"
       end %>
    <%= render "ui/trace", title: title, status: invocation.trace_status.then { it == "done" ? nil : it } do %>
      <% if invocation.arguments.present? %>
        <%= render "ui/code_block", code: JSON.pretty_generate(invocation.arguments), label: "Input" %>
      <% end %>
      <% if invocation.succeeded? %>
        <%= render "ui/code_block", code: JSON.pretty_generate(invocation.result), label: "Result" %>
      <% elsif invocation.error.present? %>
        <%= render "ui/code_block", code: invocation.error, label: invocation.error_label %>
      <% end %>
    <% end %>
  <% end %>
</div>
