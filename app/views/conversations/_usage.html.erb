<%# What the whole conversation has used, as of the end of its last run (Conversation#receive_frame). -%>
<%# locals: (conversation:) -%>
<div id="<%= dom_id(conversation, :usage) %>" class="chat__usage">
  <% if (usage = conversation.usage).present? && usage["totalTokens"].to_i.positive? %>
    <p>
      This conversation: <%= number_with_delimiter(usage["totalTokens"]) %> tokens<% if usage["cost"] %>, <%= usage_cost(usage["cost"]) %> at API prices<% end %>.
      <% if usage["cost"] %>An estimate: a subscription is not billed per token.<% end %>
    </p>
  <% end %>
</div>
