# syntax=docker/dockerfile:1
# check=error=true

# An agent's computer: the image of its Sprite on Ajay's Sprites platform
# (docs/agent.md; an existing docs/sprites-developer-cheatsheet.md). Published
# as <repository>-agent:<sha> (.gitea/workflows/agent-image.yml). The platform runs the
# ENTRYPOINT once the Sprite is ready; Dockerfile ENV is not sourced there, so
# everything the guest needs arrives in the create-time env or is defaulted
# by the entrypoint.
#
# It holds the pi-env daemon the sidecar talks to, the relay that starts it
# for an authenticated connection, and the screen: an existing an existing browser desktop
# stack (Xvfb, openbox, Chromium with CDP, x11vnc, websockify) and its desktop
# control server (agent/guest/server.js, vendored verbatim from an existing
# etc/sprites/desktop/server.js at 3096da3). The relay also starts the
# agent's command connectors (docs/connectors.md). No Rails, no app code, no
# secrets. Everything runs as `avery`, a name running Sprites already have
# (docs/deployments.md).

FROM docker.io/library/node:24.20.0-bookworm-slim AS daemon
ARG TARGETARCH
WORKDIR /agent
COPY agent/package.json agent/package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund && \
    arch=$([ "$TARGETARCH" = arm64 ] && echo arm64 || echo x64) && \
    cp "node_modules/@earendil-works/pi-env/bin/pi-env-linux-$arch/pi-env" /pi-env && chmod 755 /pi-env

# The platform lays the image over its Alpine base, so the image is Alpine
# too, at the base's release, as an existing an existing browser desktop image is: a Debian
# image's merged-/usr symlinks cannot be laid over Alpine's directories. The
# daemon is a static binary and needs no libc of its own.
FROM docker.io/library/alpine:3.24
# npm brings npx, which most command connectors' entries start with.
RUN apk add --no-cache nodejs npm chromium xvfb openbox x11vnc websockify scrot xdotool xclip xterm \
      font-liberation font-dejavu font-noto-emoji tzdata ca-certificates && \
    adduser -D -s /bin/sh avery && \
    mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix
COPY --from=daemon /pi-env /usr/local/bin/pi-env
# One desktop; no Alt+F4, desktop switching or lowering, which let an agent
# lose the screen (an existing browser desktop's openbox-rc.xml).
COPY agent/guest/openbox-rc.xml /etc/xdg/openbox/rc.xml
COPY agent/sprite-relay.mjs agent/guest/server.js agent/guest/visit.mjs agent/guest/desk.mjs /opt/avery/
COPY --chmod=755 agent/guest/entrypoint.sh /opt/avery/entrypoint.sh
# server.js is an ES module with a .js name.
RUN echo '{"type":"module"}' > /opt/avery/package.json && \
    chmod 644 /etc/xdg/openbox/rc.xml /opt/avery/*.js /opt/avery/*.mjs /opt/avery/package.json && fc-cache -f >/dev/null
USER avery
WORKDIR /home/avery
EXPOSE 8080
ENTRYPOINT ["/opt/avery/entrypoint.sh"]
