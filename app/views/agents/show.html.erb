<% content_for :title, "#{@agent.name} · Settings" %>
<%= turbo_stream_from @agent %>

<header class="settings__header">
  <%= agent_avatar @agent, size: :lg %>
  <div class="settings__heading">
    <h1><%= @agent.name %></h1>
    <% if @agent.title %><p class="settings__title"><%= @agent.title %></p><% end %>
  </div>
</header>

<%# Fixed when the agent was made (Agent: attr_readonly). -%>
<section class="ui-group" id="agent_identity">
  <ul class="ui-group__rows">
    <li class="ui-row">
      <span class="ui-row__label">Name</span>
      <span class="ui-row__value"><%= @agent.name %></span>
    </li>
    <% if @agent.email_address %>
      <li class="ui-row">
        <span class="ui-row__label">Email address</span>
        <span class="ui-row__value"><%= @agent.email_address %></span>
      </li>
    <% end %>
  </ul>
  <p class="ui-group__help">
    <%= @agent.email_address ? "Both were set when #{@agent.name} was made, and can't be changed. Mail to this address reaches #{@agent.name}, and it writes from it." :
          "Set when #{@agent.name} was made, and can't be changed." %>
  </p>
</section>

<%# Saved as each field changes; the page morphs in place. Thinking offers only the levels the model has. -%>
<%= form_with model: @agent, id: "agent_general", data: { controller: "autosave thinking-levels", action: "change->autosave#save" } do |form| %>
  <section class="ui-group" aria-labelledby="agent_title_title">
    <h2 class="ui-group__title" id="agent_title_title">Title</h2>
    <ul class="ui-group__rows">
      <li class="ui-row">
        <%= form.label :title, class: "ui-row__label" %>
        <span class="ui-row__value">
          <%= form.text_field :title, maxlength: Agent::TITLE_LIMIT, class: "ui-row__input", autocomplete: "off", placeholder: "Personal Assistant",
                aria: { describedby: "agent_title_help", invalid: (@agent.errors[:title].any? || nil) } %>
        </span>
      </li>
    </ul>
    <p class="ui-group__help" id="agent_title_help">What <%= @agent.name %> does, beside its name in your list of agents. It's told its title from the next message.</p>
  </section>
  <% choices = ModelCatalog.choices(including: @agent.model) %>
  <% chosen = choices.find { it.id == @agent.model } || choices.first %>
  <section class="ui-group" aria-labelledby="agent_model_title">
    <h2 class="ui-group__title" id="agent_model_title">Model</h2>
    <ul class="ui-group__rows">
      <li class="ui-row">
        <%= form.label :model, class: "ui-row__label" %>
        <span class="ui-row__value">
          <%= form.select :model, choices.map { |choice| [ choice.option_label, choice.id,
                { data: { thinking_levels: choice.thinking_levels.map { [ Agent::THINKING_LEVEL_NAMES[it], it ] }.to_json } } ] },
                {}, class: "ui-row__select", data: { thinking_levels_target: "model", action: "thinking-levels#offer" } %>
        </span>
      </li>
      <li class="ui-row">
        <%= form.label :thinking_level, "Thinking", class: "ui-row__label" %>
        <span class="ui-row__value">
          <%= form.select :thinking_level, options_for_select(chosen.thinking_levels.map { [ Agent::THINKING_LEVEL_NAMES[it], it ] }, chosen.level_for(@agent.thinking_level)),
                {}, class: "ui-row__select", data: { thinking_levels_target: "level" } %>
        </span>
      </li>
      <li class="ui-row">
        <%= form.label :time_zone, class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.time_zone_select :time_zone, nil, {}, class: "ui-row__select" %></span>
      </li>
    </ul>
    <p class="ui-group__help">Thinking is how much the model thinks before it answers: more is slower and costs more. Each change applies from the next message.</p>
  </section>
<% end %>

<%# On a phone the sections are rows to tap into, as an app's page in iOS Settings; beside the sidebar they are in it. -%>
<section class="ui-group settings__sections" aria-label="<%= @agent %>'s sections">
  <ul class="ui-group__rows">
    <% agent_sections(@agent).drop(1).each do |label, path| %>
      <li><%= link_to path, class: "ui-row", data: { kind: "link" } do %><span class="ui-row__label"><%= label %></span><% end %></li>
    <% end %>
  </ul>
</section>

<%# Agents endure: deleting one asks for its name, typed. -%>
<section class="ui-group" id="delete_agent" aria-labelledby="delete_agent_title">
  <h2 class="ui-group__title" id="delete_agent_title">Delete agent</h2>
  <%= form_with url: agent_path(@agent), method: :delete, class: "ui-group__body form" do |form| %>
    <p>
      Deleting <%= @agent.name %> deletes its thread, notes, routines and documents.
      <%= "Its address, #{@agent.email_address}, stops working. " if @agent.email_address %><%= "Its Campfire bot is removed. " if @agent.campfire_bot %><%= if @agent.computer&.ssh? then "Its folder on #{@agent.computer.ssh_host} is left as it is. " elsif @agent.computer then "Its computer and everything on it are deleted. " end %>This can't be undone.
    </p>
    <div class="field">
      <%= form.label :confirm_name, "Type #{@agent.name} to confirm" %>
      <%= form.text_field :confirm_name, value: nil, required: true, autocomplete: "off", spellcheck: false, class: "input",
            aria: { invalid: (@confirm_error.present? || nil), describedby: ("confirm_name_error" if @confirm_error) } %>
      <% if @confirm_error %><p class="field__error" id="confirm_name_error"><%= @confirm_error %></p><% end %>
    </div>
    <div class="form__actions"><%= form.submit "Delete #{@agent.name}", class: "button", data: { variant: "destructive" } %></div>
  <% end %>
</section>

<details class="settings__advanced">
  <summary>Advanced</summary>
  <dl class="details">
    <dt>Model route</dt><dd><code><%= @agent.model %></code></dd>
    <dt>Thinking level</dt><dd><code><%= @agent.thinking_level %></code></dd>
    <dt>Revisions kept</dt><dd><%= @agent.revisions.count %></dd>
  </dl>
</details>
