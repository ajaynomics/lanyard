<%# Search, sort and filter, as a GET form: the address holds them. A select sends on change; the box sends on Enter.
    "/" anywhere on the page puts the cursor in the box. -%>
<%# locals: (agent:, list:) -%>
<%= form_with url: agent_conversations_path(agent), method: :get, class: "conversation-filters", role: "search",
      data: { controller: "filters", action: "keydown@document->filters#focusSearch" } do |form| %>
  <%= form.label :q, "Search agents", class: "visually-hidden" %>
  <%= form.search_field :q, value: list[:q], placeholder: "Search agents", class: "input conversation-filters__search",
        data: { filters_target: "search" } %>
  <%= form.label :sort, "Sort", class: "visually-hidden" %>
  <%= form.select :sort, [ [ "Recent activity", "recent" ], [ "Newest first", "created" ], [ "Title", "title" ] ],
        { selected: list[:sort] }, class: "input conversation-filters__select", data: { action: "filters#submit" } %>
  <%= form.label :filter, "Show", class: "visually-hidden" %>
  <%= form.select :filter, [ [ "Active", "active" ], [ "Waiting for you", "waiting" ], [ "With branches", "branched" ], [ "Archived", "archived" ], [ "All", "all" ] ],
        { selected: list[:filter] }, class: "input conversation-filters__select", data: { action: "filters#submit" } %>
<% end %>
