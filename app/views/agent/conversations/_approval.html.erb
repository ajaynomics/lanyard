<%= form_with url: workspace_agent_conversation_input_answer_path(access.workspace_id, conversation, input["id"]),
      class: "agent-approval", data: { input_id: input["id"] } do |form| %>
  <p>
    Allow <code><%= input["tool"] %></code> with
    <code><%= input["arguments"].to_json %></code>?
  </p>
  <% if input["expiresAt"].is_a?(Numeric) %>
    <p>Answer by <%= Time.at(input["expiresAt"] / 1000.0).utc.iso8601 %>.</p>
  <% end %>
  <%= hidden_field_tag "answer[digest]", input["digest"], id: nil %>
  <%= select_tag "answer[scope]", options_for_select([
        [ "Only this call", "once" ],
        [ "Identical calls this session#{" (at most #{input["maxUses"]})" if input["maxUses"].is_a?(Integer)}", "session" ]
      ]), id: nil %>
  <%= button_tag "Allow", name: "answer[decision]", value: "approve" %>
  <%= button_tag "Deny", name: "answer[decision]", value: "deny" %>
<% end %>
