<%# One tool call and where it stands (shadcn: Tool, Confirmation). -%>
<%# locals: (invocation:) -%>
<% name = invocation.tool_name.humanize(capitalize: false) %>
<div id="<%= invocation.dom_target %>" class="tool-call" data-state="<%= invocation.state %>">
  <% if invocation.answerable? && invocation.asks == :approval %>
    <%= render "ui/card", title: "Allow #{name}?", class: "approval" do %>
      <%= render "ui/code_block", code: JSON.pretty_generate(invocation.arguments), label: invocation.tool_class&.description %>
      <div class="ui-card__actions">
        <%= button_to "Allow", conversation_invocation_approval_path(invocation.conversation, invocation), params: { decision: "approve" }, class: "button", form_class: "inline" %>
        <%= button_to "Decline", conversation_invocation_approval_path(invocation.conversation, invocation), params: { decision: "deny" }, class: "button", data: { variant: "outline" }, form_class: "inline" %>
      </div>
    <% end %>
  <% elsif invocation.answerable? && invocation.asks == :question %>
    <%= render "invocations/question", invocation: invocation %>
  <% elsif invocation.answerable? && invocation.asks == :sign_in %>
    <%= render "invocations/sign_in", invocation: invocation %>
  <% else %>
    <% title = case invocation.state
         when "succeeded" then "Ran #{name}"
         when "failed" then "Failed to run #{name}"
         when "denied" then "Declined #{name}"
         when "awaiting_person" then "Waited too long to run #{name}"
         else "Running #{name}…"
       end %>
    <%= render "ui/trace", title: title, status: invocation.trace_status.then { it == "done" ? nil : it } do %>
      <% if invocation.arguments.present? %>
        <%= render "ui/code_block", code: JSON.pretty_generate(invocation.arguments), label: "Input" %>
      <% end %>
      <% if invocation.succeeded? %>
        <%= render "ui/code_block", code: JSON.pretty_generate(invocation.result), label: "Result" %>
      <% elsif invocation.error.present? %>
        <%= render "ui/code_block", code: invocation.error, label: "Error" %>
      <% end %>
    <% end %>
  <% end %>
</div>
