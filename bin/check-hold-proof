#!/bin/bash
# Build from a committed tree; do not start the computer until provenance is printed.
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ $# != 2 || ! ( $1 == baseline || $1 == hold-proof || $1 == identity ) ]]; then
  echo 'Usage: bin/check-hold-proof {baseline|hold-proof|identity} <commit>' >&2
  exit 64
fi
mode=$1
sha=$(git rev-parse --verify "$2^{commit}")
head=$(git rev-parse HEAD)
[[ -z $(git status --porcelain) ]] || { echo 'Use a clean worktree.' >&2; exit 64; }
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

build() {
  local source=$1 image=$2
  shift 2
  if ! git archive "$source" | DOCKER_BUILDKIT=1 docker build --provenance=false \
    -f Dockerfile.agent -t "$image" "$@" - > "$work/build" 2>&1; then
    printf 'git_commit=%s\nimage_id=not_built\n' "$source"
    cat "$work/build"
    return 1
  fi
  local config
  # The classic store identifies the image by its config; containerd uses
  # the manifest as .Id and exposes the config digest in its descriptor.
  config=$(docker image inspect "$image" | python3 -c 'import json, sys
[image] = json.load(sys.stdin)
descriptor = image.get("Descriptor")
print(descriptor["annotations"]["config.digest"] if descriptor else image["Id"])')
  [[ $config =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
  printf 'git_commit=%s\nimage_id=%s\n' "$source" "$config"
}

image="hold-proof-local:$sha-$mode"
if [[ $mode == identity ]]; then
  before="$image-before"
  after="$image-after"
  build "$sha" "$before" > "$work/before" || { cat "$work/before"; exit 1; }
  build "$head" "$after" > "$work/after" || { cat "$work/before" "$work/after"; exit 1; }
  cat "$work/before" "$work/after"
  docker image inspect "$before" --format '{{json .RootFS.Layers}}' | tee "$work/before-layers"
  docker image inspect "$after" --format '{{json .RootFS.Layers}}' | tee "$work/after-layers"
  diff <(grep '^image_id=' "$work/before") <(grep '^image_id=' "$work/after")
  diff "$work/before-layers" "$work/after-layers"
  echo 'PASS: identical image config and layers'
  exit
fi

target=()
[[ $mode != hold-proof ]] || target=(--target hold-proof)
build "$sha" "$image" "${target[@]}"
# Only the synthetic site key is generated on the host. The hold CA is not
# part of this fixture and must be generated by the computer under test.
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -noenc -days 1 \
  -subj /CN=localhost -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1,IP:::1' \
  -keyout "$work/site.key" -out "$work/site.pem" > /dev/null 2>&1
cp agent/test/hold-proof-check.mjs "$work/"

# CI's job runs in a container but talks to the host's Docker, which cannot
# see this job's temporary folder, so nothing is bind-mounted: the files are
# copied into the stopped container through the Docker API, then it starts.
# The extra options are this one container's alone.
container=$(docker create --pull never --network none --cap-add NET_ADMIN --security-opt seccomp=unconfined \
  --entrypoint node "$image" /proof/hold-proof-check.mjs)
trap 'docker rm -f "$container" > /dev/null 2>&1; rm -rf "$work"' EXIT
docker cp "$work/." "$container:/proof"
docker start -a "$container"
