# The example destination's secrets (config/deploy.example.yml). An install
# copies this to .kamal/secrets.<name> and replaces each resource id with its
# own Passbolt resource's id.
#
# Self-resolving: every value comes from Passbolt at deploy time, so
# `bin/kamal deploy -d <name>` needs no environment assembly. Nothing here is a
# stored value. Safe to commit.
#
# There is deliberately no `.kamal/secrets` or `.kamal/secrets-common`: Kamal
# reads those for every destination, and every line is resolved the moment one
# is read, so a shared file would run one destination's lookups during
# another's deploy.
#
# The ids below are placeholders (all zeros), so each lookup resolves blank and
# .kamal/hooks/pre-deploy refuses the deploy, which is the point.

KAMAL_REGISTRY_PASSWORD=$(passbolt get resource --id 00000000-0000-0000-0000-000000000000 -j | jq -r .password)

# config/master.key
RAILS_MASTER_KEY=$(passbolt get resource --id 00000000-0000-0000-0000-000000000000 -j | jq -r .password)

# The sign-in client the OpenID Connect provider registered for this
# destination's callback address (web and job): username = client id,
# password = secret.
OIDC__CLIENT_ID=$(passbolt get resource --id 00000000-0000-0000-0000-000000000000 -j | jq -r .username)
OIDC__CLIENT_SECRET=$(passbolt get resource --id 00000000-0000-0000-0000-000000000000 -j | jq -r .password)

# Pi Durable sidecar (docs/agent.md): two distinct transport tokens.
# Rails presents this one to the sidecar.
PI_DURABLE__SIDECAR_TOKEN=$(passbolt get resource --id 00000000-0000-0000-0000-000000000000 -j | jq -r .password)
# The sidecar presents this one to Rails.
PI_DURABLE__RAILS_TOKEN=$(passbolt get resource --id 00000000-0000-0000-0000-000000000000 -j | jq -r .password)

# The model-account grants' encryption key, 64 hex (the agent role only).
SUBSCRIPTION_VAULT_KEY=$(passbolt get resource --id 00000000-0000-0000-0000-000000000000 -j | jq -r .password)
# The Sprites platform token (the agent role only).
SPRITES_TOKEN=$(passbolt get resource --id 00000000-0000-0000-0000-000000000000 -j | jq -r .password)

# Optional: saved sign-ins (docs/passwords.md). The Passbolt database's
# password (its accessory and Passbolt both), and the agents' Passbolt user's
# armored private key (the recovery kit) and passphrase, for web and job.
# PASSBOLT_DB_PASSWORD=$(passbolt get resource --id 00000000-0000-0000-0000-000000000000 -j | jq -r .password)
# PASSBOLT__PRIVATE_KEY=$(passbolt get resource --id 00000000-0000-0000-0000-000000000000 -j | jq -r .password)
# PASSBOLT__PASSPHRASE=$(passbolt get resource --id 00000000-0000-0000-0000-000000000000 -j | jq -r .password)
