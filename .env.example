# Every setting DurableAssistants reads. Each comes from ENV under Rails' name
# (SERVICE__KEY) or, when unset, from encrypted credentials (service.key).
# Copy this file to .env: in development Rails reads it itself for settings.
# The test suite never reads .env. Under a bare bin/rails, export process
# knobs in the shell. A blank line here hides the credential of the same name,
# so delete the lines you are not setting.
#
# test/env_example_test.rb holds this file against the code that reads it.

# Public origin of this deployment. Production derives config.hosts from it.
APP__NAME=Durable Assistants
APP__URL=http://localhost:3000
# Optional. Other hostnames, comma-separated, that answer every request with a
# redirect to APP__URL, keeping path and query (each also in the proxy's hosts).
APP__REDIRECTS=
APP__MAILER_FROM=durable_assistants@localhost
# The hue of the app's one colour, a whole number from 0 to 360 (oklch).
APP__ACCENT_HUE=255
# The folder under config/agents a new person's first agent is made from.
APP__STARTER_AGENT=assistant
# "allow" runs every call that would ask the person's approval at once, for
# every agent, the ones never "Always" too: like Claude Code's
# --dangerously-skip-permissions. What asks every time (an iMessage from the
# person's own phone) still asks, and questions and sign-ins still wait for
# the person. Anything else asks.
APP__APPROVALS=ask
# "true" goes further than "allow": no call waits for an approval card, not
# even those that ask every time (an iMessage from the person's own phone),
# except sending mail, deleting a draft or an event, and an event with
# guests, through a Gmail or Calendar connector, which always ask. Each call is still recorded in its thread. Questions and sign-ins still wait
# for the person. Off by default.
APP__APPROVE_EVERYTHING=false

# OIDC sign-in, through Ajent. Any OpenID Connect provider works that offers
# discovery, an RS256 ID token, PKCE S256, the openid email profile scopes and
# email_verified: point ISSUER at it and register CALLBACK_URI as the redirect
# address (its path must stay /auth/ajent/callback). NAME is the word the
# sign-in page uses for the provider. Without a client ID and secret nobody can
# sign in.
OIDC__NAME=Ajent
OIDC__ISSUER=
OIDC__CLIENT_ID=
OIDC__CLIENT_SECRET=
OIDC__CALLBACK_URI=http://localhost:3000/auth/ajent/callback

# Who may sign in: the emails the provider has verified, comma-separated. Asked
# on every request, so removing one ends that person's session. Nobody by default.
ACCESS__EMAILS=
# Of those, who may connect, replace and disconnect the model accounts every
# agent shares (/subscriptions). Comma-separated; nobody by default.
ACCESS__ADMINS=
# Optional. The one person the install serves, by email: everyone admitted
# signs in as them, to the same agents, connectors and threads. Admission and
# /subscriptions still go by who signed in. Unset, each person has their own.
ACCESS__OWNER_EMAIL=

# The office (docs/office.md): its services are accessories beside the app,
# and the app reaches each inside the host at http://<service>-<accessory>,
# worked out from what Kamal sets on every app container (with KAMAL_VERSION).
# Each *__URL below is only for a service somewhere else.
# KAMAL_CONTAINER_NAME=
# KAMAL_DESTINATION=

# Saved sign-ins (docs/passwords.md): the office's Passbolt, and the armored
# private key and passphrase of the one Passbolt user its agents share.
# Unset, the agents have no saved sign-ins.
PASSBOLT__URL=
PASSBOLT__PRIVATE_KEY=
PASSBOLT__PASSPHRASE=

# Campfire (docs/campfire.md), the office's chat: where this app posts as an
# agent's bot (the office's, http://<service>-campfire, unless set), and how
# Campfire reaches this app's webhook (http://<service>-web for the office's,
# APP__URL for another, unless set).
CAMPFIRE__URL=
CAMPFIRE__APP_URL=
# A Campfire administrator's sign-in, so each agent's bot is made, pointed and
# removed here instead of pasted by hand.
# Stock ONCE Campfire v1.5.8; on another version it falls back to the paste.
CAMPFIRE__ADMIN_EMAIL=
CAMPFIRE__ADMIN_PASSWORD=

# The office's wiki (Outline) and CRM (Twenty), as connectors every agent has
# (config/install_connectors.yml): each is on once its key is set, the API key
# the service issued to the office's agents. The addresses default to the
# office's accessories (http://<service>-wiki:3000/mcp, -crm likewise).
WIKI__URL=
WIKI__API_KEY=
CRM__URL=
CRM__API_KEY=

# Optional. Email (docs/email.md): each agent's address is <name>@MAIL__DOMAIN.
# Mail for the domain lands in one catch-all mailbox the app reads over IMAP
# (TLS); replies go out through SMTP (STARTTLS). Unset, agents have no email.
MAIL__DOMAIN=
MAIL__SMTP_ADDRESS=
MAIL__SMTP_PORT=587
MAIL__SMTP_USER_NAME=
MAIL__SMTP_PASSWORD=
MAIL__IMAP_ADDRESS=
MAIL__IMAP_PORT=993
MAIL__IMAP_USER_NAME=
MAIL__IMAP_PASSWORD=

# Optional. Texts (docs/phone.md): the voip.ms API user (the account's email)
# and API password. The password is the whole account's, so let the account
# take API calls from this install's address alone. An agent sends texts only
# once its person gives it one of the account's numbers.
VOIPMS__USERNAME=
VOIPMS__PASSWORD=

# Optional. iMessage from the install owner's own phone, through a BlueBubbles
# server on their Mac (docs/imessage.md): its address as this install reaches
# it, and its server password. Each agent the person picks can find and read
# chats, and send, which asks the person every time. Unset, no agent has it.
BLUEBUBBLES__URL=
BLUEBUBBLES__PASSWORD=

# Optional. Calendars and task lists over CalDAV (docs/calendar.md): the
# server's address. Each agent signs in as its own account, set on its
# Channels page. Unset, no agent has calendar tools.
CALDAV__URL=

# Optional. Web Push (docs/deployments.md, "Notifications"): the VAPID key pair that
# signs this install's notifications. Make one pair, once, and keep it: a new
# pair silently ends every device's notifications until it is turned on again.
#   bin/rails runner 'key = WebPush.generate_key; puts key.public_key, key.private_key'
# Unset, push is off and Settings does not offer it.
WEB_PUSH__PUBLIC_KEY=
WEB_PUSH__PRIVATE_KEY=
# How the push services reach whoever runs this install: mailto: or https:.
# Unset, mailto: and APP__MAILER_FROM's address when that is set; keys with neither fail a production boot.
# Anything but a mailto: or https: address leaves push off, since Apple refuses it.
WEB_PUSH__SUBJECT=

# Optional. Error tracking (required in production) and product analytics.
GLITCHTIP__DSN=
RYBBIT__HOST=
RYBBIT__SITE_ID=
# true masks typed input in Rybbit's session replays; unset, replays are full.
# Replay itself is switched on in the Rybbit site's settings, not here.
RYBBIT__REPLAY_MASKING=

# Optional. This instance's own Google OAuth app, for the Gmail, Calendar,
# Drive and Docs connectors (a Web application client; redirect URI
# <APP__URL>/connectors/callback). Unset, those connectors ask each person
# for their own client ID.
CONNECTORS__GOOGLE__CLIENT_ID=
CONNECTORS__GOOGLE__CLIENT_SECRET=

# Optional Pi Durable sidecar (docs/agent.md). Two distinct bearer tokens:
# Rails presents SIDECAR_TOKEN to the sidecar, the sidecar presents
# RAILS_TOKEN to Rails' private callbacks. Blank tokens refuse every call.
PI_DURABLE__SIDECAR_URL=http://127.0.0.1:4397
PI_DURABLE__SIDECAR_TOKEN=
PI_DURABLE__RAILS_TOKEN=
# Kinds of computer an agent may use, comma separated (local, sprites, ssh); see docs/computers.md.
# ssh lets a person point an agent at a folder on a real machine, unisolated.
PI_DURABLE__COMPUTERS=
# The start of each Sprite's name, <prefix>-<environment>-b<agent id>; it
# names this deployment's Sprites on the platform, so it never changes once set.
PI_DURABLE__SPRITE_PREFIX=durable-assistants

# Optional. Concourse, the agents' mail network, and the Ajent token address
# its machine clients use, e.g. https://concourse.example and
# https://id.example/oauth/token. Without both, no agent is offered Concourse.
# Each agent gets its own client id and secret when the person joins it to
# Concourse from its Channels settings, never here. Concourse must name this
# token address when it hands them over, or the join is refused.
CONCOURSE__ORIGIN=
CONCOURSE__TOKEN_URL=

# Process knobs, not settings: they tune how a process runs or where it points
# rather than what DurableAssistants is, so they are read straight from ENV under the
# names Rails, Solid Queue, Falcon and OpenTelemetry already use, never from
# credentials. Commented out; unset means the value shown.
# RAILS_MAX_THREADS=5
# RAILS_LOG_LEVEL=info
# JOB_CONCURRENCY=1
# PORT=3000
# FALCON_BIND=http://0.0.0.0:3000
# FALCON_COUNT=1
# DEPLOYMENT_ENVIRONMENT=development
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=durable_assistants
# Read by bin/agent (the Node sidecar), never by Rails.
# Fixed, not a setting: bin/agent and the computer's entrypoint
# (agent/guest/entrypoint.sh) set PI_TELEMETRY=0, so no pi sends install or
# update telemetry. Neither image runs the pi CLI today; this keeps it so.
# PI_TELEMETRY=0
# AGENT_PORT=4397
# AGENT_STORE=storage/agent/durable.sqlite
# AGENT_RAILS_URL=http://127.0.0.1:3000
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Instead of ANTHROPIC_API_KEY, never with it: Claude through a Claude
# subscription, signed in at /subscriptions (docs/agent.md); the grant
# file is encrypted with the vault key (64 hex), for AGENT_APPLICATION (the
# install's name) and SUBSCRIPTION_VAULT_SCOPE (unset means
# DEPLOYMENT_ENVIRONMENT). Changing either means signing in again, so pin the
# scope before renaming the environment.
# AGENT_APPLICATION=durable-assistants
# SUBSCRIPTION_VAULT_SCOPE=
# CLAUDE_SUBSCRIPTION_FILE=/absolute/path/storage/agent/claude-subscription.json
# OpenAI's Codex models through a ChatGPT subscription, signed in the same way
# and sealed with the same vault key.
# CHATGPT_SUBSCRIPTION_FILE=/absolute/path/storage/agent/chatgpt-subscription.json
# With either file, an Anthropic API key may also be pasted at /subscriptions
# (anthropic-api/* models, beside the subscription, never instead of it); it
# is checked with Anthropic and sealed in the Claude file (else the ChatGPT
# one). No setting here holds it.
# SUBSCRIPTION_VAULT_KEY=
# Two installs on one Claude subscription (docs/agent.md, "Lending the Claude
# subscription"): the install that signed in lends its access token on a socket
# in a folder mounted into both sidecars; the other borrows from it in place
# of a sign-in of its own. Both set the same secret, 32 characters or more.
# CLAUDE_SUBSCRIPTION_LEND_SOCKET=/absolute/path/lending/claude.sock
# CLAUDE_SUBSCRIPTION_BORROW_SOCKET=/absolute/path/lending/claude.sock
# CLAUDE_SUBSCRIPTION_LENDING_SECRET=
# local offers the free scripted model (local/stand-in) beside the paid routes
# whose key is present; unset offers only those. Procfile.dev sets local.
# AGENT_MODEL_MODE=
# Unset means no local computer. trusted-local-single-tenant lets an agent use a
# directory on this machine for one trusted operator; it is not isolation
# (docs/agent.md). Procfile.dev sets it.
# AGENT_EXECUTION_MODE=
# isolated runs a local computer's shells without a network (needs Linux user
# namespaces); host, the default, leaves them on the machine's network.
# AGENT_SHELL_NETWORK=host
# Absolute path to a JSON file of the sidecar's options (agent/server.mjs);
# each environment variable above wins over the same option there.
# AGENT_CONFIG=
# Summarise a conversation's earlier messages once its context reaches about
# this many tokens, whatever the model's window (agent/runtime.mjs).
# AGENT_COMPACT_AT_TOKENS=262144
# A turn has no time limit, as in pi. Its safety stop: the model requests it
# may make, counted from the newest message, in case an agent loops.
# AGENT_MAX_REQUESTS=300
# Give up a model request or web search that sends nothing for this long.
# AGENT_REQUEST_IDLE_MS=300000
# A Sprites platform token (scoped to this deployment) and
# the approved image (Dockerfile.agent) let an agent use a Sprite as its
# computer; unset means none is offered (docs/agent.md).
# SPRITES_TOKEN=
# SPRITES_IMAGE=<registry>/<repository>-agent:<sha>
# SPRITES_URL=https://sprites.example.com
# SPRITES_IDLE_MS=60000
