<%# When the agent's mail to people outside the install may go, for the workspace's owner alone (Agents::SendingHoursController). -%>
<% hours = @sending_hours || agent %>
<section class="ui-group" id="sending_hours" aria-labelledby="channel_sending_hours">
  <h2 class="ui-group__title" id="channel_sending_hours">Sending hours</h2>
  <%= form_with model: hours, scope: :agent, url: agent_sending_hours_path(agent), method: :patch, class: "ui-group" do |form| %>
    <% if hours.errors.any? %>
      <p class="flash" data-kind="alert" role="alert"><%= hours.errors.full_messages.to_sentence %></p>
    <% end %>
    <ul class="ui-group__rows">
      <li class="ui-row">
        <%= form.label :send_from, "From", class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.text_field :send_from, class: "input", placeholder: "08:00", inputmode: "numeric", autocomplete: "off", pattern: "[0-2][0-9]:[0-5][0-9]" %></span>
      </li>
      <li class="ui-row">
        <%= form.label :send_until, "Until", class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.text_field :send_until, class: "input", placeholder: "19:00", inputmode: "numeric", autocomplete: "off", pattern: "[0-2][0-9]:[0-5][0-9]" %></span>
      </li>
      <li class="ui-row">
        <%= form.label :send_time_zone, "Time zone", class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.text_field :send_time_zone, class: "input", placeholder: agent.time_zone.presence || "America/Toronto",
              autocomplete: "off", spellcheck: false, autocapitalize: "none" %></span>
      </li>
    </ul>
    <div class="form__actions"><%= form.submit "Save sending hours", class: "button" %></div>
  <% end %>
  <p class="ui-group__help">
    <% if agent.sending_hours? && hours.errors.none? %>
      Mail from <%= agent.name %> to anyone outside this install goes only from <%= agent.send_from %> until <%= agent.send_until %>, <%= agent.send_time_zone %>.
      Allowed at another hour, it waits until <%= agent.send_from %>, shown in the thread with Don't send. Mail to this install's people, and the Always Bcc, go at any hour.
    <% else %>
      Hours, such as 08:00 until 19:00 in America/Toronto, outside which <%= agent.name %>'s mail to people outside this install waits until they open, even once allowed. None set: any hour. Only you see this.
    <% end %>
  </p>
  <% if agent.sending_hours? %>
    <div class="page__actions">
      <%= button_to "Remove", agent_sending_hours_path(agent), method: :delete, class: "button", form_class: "inline",
            data: { variant: "outline", turbo_confirm: "Let #{agent.name} send at any hour?" } %>
    </div>
  <% end %>
</section>
