<% content_for :title, @agent.name %>

<section class="page">
  <header class="page__header">
    <h1><%= @agent.name %></h1>
    <div class="page__actions">
      <%= link_to "Settings", @agent, class: "button", data: { variant: "ghost" } %>
      <%= button_to "New agent", agent_conversations_path(@agent), params: { request_id: SecureRandom.uuid },
            id: "new_conversation", class: "button", form_class: "inline" %>
    </div>
  </header>

  <%= render "conversations/filters", agent: @agent, list: @list %>

  <%# Thirty at a time. Each page ends with a frame that loads the next as it scrolls into view. -%>
  <div id="conversations" class="conversation-list" data-controller="list-nav" data-action="keydown->list-nav#move">
    <%= turbo_frame_tag "conversations_page_#{@page.number}", target: "_top" do %>
      <% if @conversations.any? %>
        <ul class="conversation-list__page">
          <%= render partial: "conversations/conversation", collection: @conversations, as: :conversation %>
        </ul>
        <% unless @page.last? %>
          <%= turbo_frame_tag "conversations_page_#{@page.next_param}", target: "_top", loading: :lazy,
                src: agent_conversations_path(@agent, @list.merge(page: @page.next_param)) %>
        <% end %>
      <% elsif @page.first? %>
        <%= render "conversations/empty_list", agent: @agent, list: @list %>
      <% end %>
    <% end %>
  </div>
</section>
