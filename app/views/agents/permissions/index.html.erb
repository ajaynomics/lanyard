<% content_for :title, "Permissions · #{@agent.name}" %>

<header class="settings__header"><h1>Permissions</h1></header>

<%# What asks however the person answered before: never "Always", and of those, what asks even where the install allows everything. -%>
<% asking = (@agent.tools(@agent.conversation&.connectors || []) + Tool::Catalog::ALWAYS + Tool::Catalog::SAVED_SIGN_INS).uniq.select { it.respond_to?(:always?) && it.asks == :approval } %>
<% never = asking.reject(&:always?).map { it.label.downcase_first } %>
<% every_time = asking.select(&:every_time?).reject(&:even_approving_everything?).map { it.label.downcase_first } %>
<% regardless = asking.select(&:even_approving_everything?).map { it.label.downcase_first } %>
<% reaching = asking.select { it.try(:reaches_others?) }.reject(&:even_approving_everything?).map { it.label.downcase_first } %>
<% with_guests = asking.select { it.try(:asks_with_guests?) }.map { it.label.downcase_first } %>
<% guests_line = "To #{with_guests.to_sentence(two_words_connector: ' or ', last_word_connector: ', or ')} with guests other than you, or emailing guests, it asks every time too." if with_guests.any? %>
<section class="ui-group" id="permissions" aria-labelledby="always_allowed">
  <h2 class="ui-group__title" id="always_allowed">Always allowed</h2>
  <% if @agent.permissions.any? %>
    <ul class="ui-group__rows">
      <% @agent.permissions.each do |permission| %>
        <% what = tool_label(permission.tool_name) %>
        <% whom = permission.every_call? ? "every time" : "with #{permission.recipient}" %>
        <li class="ui-row" id="<%= dom_id(permission) %>">
          <span class="ui-row__label"><%= what.upcase_first %>
            <span class="ui-row__detail"><%= whom.upcase_first %> · added <%= l permission.created_at.to_date, format: :long %></span>
          </span>
          <span class="ui-row__value">
            <%= button_to "Remove", agent_permission_path(@agent, permission), method: :delete, class: "button", form_class: "inline",
                  data: { variant: "ghost", size: "sm", turbo_confirm: "Ask again before #{what} #{whom}?" }, aria: { label: "Remove: #{what} #{whom}" } %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="settings__empty">
      <p>Nothing yet. When <%= @agent.name %> asks to do something, answer "Always" to let it do that again without asking, and it shows here.</p>
      <%= link_to "Go to #{@agent.name}", conversation_path(@agent.conversation), class: "button" %>
    </div>
  <% end %>
  <p class="ui-group__help">
    <% if DurableAssistants.config(:app, :approve_everything) %>
      This install approves everything: <%= @agent.name %> does all of it without asking you<%= ", even #{every_time.to_sentence}" if every_time.any? %>.
      <% if reaching.any? %>That includes what reaches other people or their accounts: <%= reaching.to_sentence %>.<% end %>
      <% if regardless.any? %>To <%= regardless.to_sentence %> it still asks every time.<% end %>
      <%= guests_line %>
      Each call is still recorded in its thread. It still asks you its questions, and asks you to sign in where only you can.
    <% elsif DurableAssistants.config(:app, :approvals) == "allow" %>
      This install allows everything: <%= @agent.name %> does all of it without asking you, even what is never "Always".
      <% if (every_time + regardless).any? %>To <%= (every_time + regardless).to_sentence %> it still asks every time.<% end %>
      <%= guests_line %>
      It still asks you its questions, and asks you to sign in where only you can.
    <% else %>
      Everything else that changes something outside <%= @agent.name %> asks you first. To <%= never.to_sentence %> it asks every time; these are never "Always".
    <% end %>
  </p>
</section>
