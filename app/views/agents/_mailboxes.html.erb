<%# Mailboxes the agent reads and never sends from, for the workspace's owner alone (Agents::MailboxesController). No password: only the vault entry's name. -%>
<% mailboxes = agent.mail_accounts.select { it.read_only? && it.persisted? }.sort_by(&:id) %>
<% mailbox = @mailbox || Agent::MailAccount.new(read_only: true, folder_names: Agent::MailAccount::Inbox::FOLDERS) %>
<section class="ui-group" id="mailboxes" aria-labelledby="channel_mailboxes">
  <h2 class="ui-group__title" id="channel_mailboxes">Read-only mailboxes</h2>
  <% if mailboxes.any? %>
    <ul class="ui-group__rows">
      <% mailboxes.each do |each| %>
        <li class="ui-row" id="<%= dom_id(each, :mailbox) %>">
          <span class="ui-row__label"><%= each.address %></span>
          <span class="ui-row__value">
            <%= each.imap_host %>:<%= each.imap_port %>, reading <%= each.folder_names %>
            <% if each.inbox_error %>
              <span class="flash" data-kind="alert" role="status">Couldn't read it: <%= each.inbox_error %> It tries again every minute.</span>
            <% end %>
            <%= button_to "Remove", agent_mailbox_path(agent, each), method: :delete, class: "button", form_class: "inline",
                  data: { variant: "outline", turbo_confirm: "Stop #{agent.name} reading #{each.address}?" } %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with model: mailbox, scope: :mailbox, url: agent_mailboxes_path(agent), method: :post, class: "ui-group" do |form| %>
    <% if mailbox.errors.any? %>
      <p class="flash" data-kind="alert" role="alert"><%= mailbox.errors.full_messages.to_sentence %></p>
    <% end %>
    <ul class="ui-group__rows">
      <li class="ui-row">
        <%= form.label :address, "Address", class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.email_field :address, class: "input", placeholder: "colleague@example.com", autocomplete: "off", spellcheck: false %></span>
      </li>
      <li class="ui-row">
        <%= form.label :imap_host, "Incoming server", class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.text_field :imap_host, class: "input", placeholder: "imap.example.com", autocomplete: "off", spellcheck: false, autocapitalize: "none" %></span>
      </li>
      <li class="ui-row">
        <%= form.label :imap_port, "Incoming port", class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.number_field :imap_port, class: "input", min: 1, max: 65_535, inputmode: "numeric" %></span>
      </li>
      <li class="ui-row">
        <%= form.label :vault_entry, "Saved sign-in", class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.text_field :vault_entry, class: "input", placeholder: "Its name in the password manager", autocomplete: "off", spellcheck: false %></span>
      </li>
      <li class="ui-row">
        <%= form.label :folder_names, "Folders", class: "ui-row__label" %>
        <span class="ui-row__value"><%= form.text_field :folder_names, class: "input", placeholder: Agent::MailAccount::Inbox::FOLDERS, autocomplete: "off", spellcheck: false %></span>
      </li>
    </ul>
    <div class="form__actions"><%= form.submit "Add a read-only mailbox", class: "button" %></div>
  <% end %>
  <p class="ui-group__help">
    A mailbox <%= agent.name %> reads and never sends, drafts or changes anything in, such as a colleague's whose work it took over. New mail in each folder, by the server's names for them, reaches it every minute as untrusted mail, saying where it was found; what is there already is not. Its replies go from its own address. The username and password are saved in the password manager, with the incoming server's name as its address, and shared with <%= agent.name %>. Only you see this.
  </p>
</section>
