<%# What a call will do, as a person reads it: each argument by its name, text as text (shadcn: Confirmation's details).
    Nothing is cut: a person approves the whole of it, and a long body's tail is where injected text would sit, so a long value scrolls instead. -%>
<%# locals: (values:) -%>
<dl class="ui-fields">
  <% values.to_h.each do |key, value| %>
    <dt><%= key.to_s.humanize %></dt>
    <dd>
      <% if value.is_a?(String) %>
        <span class="ui-fields__text"><%= value %></span>
      <% elsif value.is_a?(Array) && value.all? { it.is_a?(Numeric) || it.to_s.match?(/\A\S+\z/) } %>
        <%= value.join(", ") %>
      <%# Words, as an iMessage's bubbles: each whole and apart, so a person sees where one ends. -%>
      <% elsif value.is_a?(Array) && value.all?(String) %>
        <% value.each do |text| %><span class="ui-fields__text ui-fields__item"><%= text %></span><% end %>
      <% elsif value.is_a?(Hash) || value.is_a?(Array) %>
        <pre class="ui-fields__data"><%= JSON.pretty_generate(value) %></pre>
      <% else %>
        <%= value.to_s %>
      <% end %>
    </dd>
  <% end %>
</dl>
