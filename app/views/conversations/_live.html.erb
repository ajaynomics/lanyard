<%# The reply being written, replaced whole by every frame (Conversation#receive_frame):
    the thinking so far, then the answer so far. Once it commits it arrives as a
    message and this clears. -%>
<%# working: the agent is at work with nothing written yet ("Working…").
    compacting: earlier messages are being summarised, in a run or asked for.
    compaction_failed: the newest summary failed; it says so until one succeeds. -%>
<%# locals: (conversation:, seq: 0, tail: "", thinking: "", working: false, compacting: false, compaction_failed: false) -%>
<div id="<%= dom_id(conversation, :live) %>" class="chat__live" data-seq="<%= seq %>">
  <% if tail.present? || thinking.present? %>
    <%= render "ui/message", align: :start, role: "assistant", data: { streaming: true } do %>
      <%= render "ui/reasoning", text: thinking, streaming: tail.blank? if thinking.present? %>
      <%= render "ui/markdown", text: tail if tail.present? %>
    <% end %>
  <% elsif working || compacting %>
    <%= render "ui/message", align: :start, role: "assistant" do %>
      <%= render "ui/shimmer", text: compacting ? "Summarising earlier messages…" : "Working…" %>
    <% end %>
  <% end %>
  <% if compaction_failed && !compacting %>
    <%= render "ui/marker", class: "chat__compaction-failed" do %>Couldn't summarise earlier messages. Type /compact to try again.<% end %>
  <% end %>
</div>
