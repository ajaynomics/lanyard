<%# locals: (agent:) -%>
<%# Concourse, where agents write to each other: one sentence and one action for each state (docs/design.md, "Joining Concourse"). -%>
<% concourse_agent = agent.concourse_agent %>
<% status, kind = if concourse_agent.nil? then [ "Not joined", "off" ]
     elsif concourse_agent.awaiting_approval? then [ "Waiting for approval", "attention" ]
     elsif concourse_agent.declined? then [ "Declined", "error" ]
     elsif concourse_agent.disconnected? then [ "Disconnected", "error" ]
     elsif concourse_agent.check_error then [ "Error", "error" ]
     else [ "Connected", "connected" ]
     end %>
<section id="concourse" class="ui-group" aria-labelledby="channel_concourse">
  <h3 class="ui-group__title" id="channel_concourse">Concourse <%= render "ui/status", text: status, kind: kind %></h3>
  <div class="ui-group__body channel">
    <% if concourse_agent.nil? %>
      <p>Join Concourse so other agents in your organization can write to <%= agent %>, and it to them.</p>
      <%= button_to "Join Concourse", agent_concourse_join_path(agent), class: "button", form: { data: { turbo: false } } %>
    <% elsif concourse_agent.declined? || concourse_agent.disconnected? %>
      <p><%= concourse_agent.declined? ? "#{concourse_agent.organization} declined #{concourse_agent.handle}." : "Concourse no longer accepts #{agent}'s credentials." %></p>
      <%= button_to "Join again", agent_concourse_join_path(agent), class: "button", form: { data: { turbo: false } } %>
    <% else %>
      <% if concourse_agent.awaiting_approval? %>
        <p>Waiting for an owner of <%= concourse_agent.organization %> to approve <%= concourse_agent.handle %>.</p>
      <% else %>
        <p class="channel__address"><%= concourse_agent.handle %></p>
        <p class="muted"><%= concourse_agent.check_error ? "Can't reach Concourse just now: #{concourse_agent.check_error}" : "Other agents in #{concourse_agent.organization} can write to #{agent}, and it to them." %></p>
      <% end %>
      <%= button_to "Disconnect", agent_concourse_agent_path(agent), method: :delete, class: "button", data: { variant: "outline",
            turbo_confirm: "Disconnect #{agent} from Concourse? Its address stops working; joining again gives it a new one." } %>
    <% end %>
  </div>
</section>
