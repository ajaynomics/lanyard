<%# Where the thread ends, as pi's footer: how full the model's context is, how much of the prompt the
    cache served, how long it stays warm, and what the whole conversation has used. Replaced at the end
    of each run (Conversation#receive_frame); the cache's minutes count down in the page (cache_timer_controller),
    hidden while the agent works, when the cache is in use. -%>
<%# locals: (conversation:) -%>
<% reply = conversation.latest_reply %>
<div id="<%= dom_id(conversation, :usage) %>" class="chat__usage">
  <% if (meter = context_meter(conversation)) %>
    <p class="chat__context" title="When the agent reaches the summary point, earlier messages are summarised so it can go on."><%= meter %></p>
  <% end %>
  <% if (cache = cache_line(conversation, reply)) %>
    <p title="The share of what the model read that came from the prompt cache, which is faster and costs a tenth as much."><%= cache %></p>
  <% end %>
  <% if (expires = reply&.cache_expires_at) %>
    <% tokens = thousands(reply.usage["totalTokens"].to_i) %>
    <p class="chat__cache" data-level="<%= cache_level(expires, reply.cache_warning) %>"
       data-controller="cache-timer" data-cache-timer-until-value="<%= expires.iso8601 %>" data-cache-timer-tokens-value="<%= tokens %>"
       data-cache-timer-warning-value="<%= reply.cache_warning.to_i %>"
       title="The cache lasts <%= cache_window(reply.cache_ttl.to_i) %> from the last reply. Changing the model, thinking, instructions, skills or tools, or /compact, starts it over.">
      <%= cache_timer_text(expires, tokens, reply.cache_warning) %>
    </p>
  <% end %>
  <% if (usage = conversation.usage).present? && usage["totalTokens"].to_i.positive? %>
    <p>
      This agent: <%= number_with_delimiter(usage["totalTokens"]) %> tokens<% if usage["cost"] %>, <%= usage_cost(usage["cost"]) %> at API prices<% end %>.
      <% if usage["cost"] %>An estimate: an API key is billed at these prices; a subscription is not billed per token.<% end %>
    </p>
  <% end %>
  <% if (bytes = conversation.notes_file_bytes) %>
    <p class="chat__notes"><%= notes_file_line(bytes) %></p>
  <% end %>
</div>
