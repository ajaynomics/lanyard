<% content_for :title, "Permissions · #{@agent.name}" %>

<header class="settings__header"><h1>Permissions</h1></header>

<% asks_for_instructions = @agent.asks_own_instruction_change? %>
<%= render "settings/instruction_approval", scope: :agent, url: agent_path(@agent), choice: @agent.own_instruction_approval,
      inherited: "Inherit from workspace", inherited_approval: @agent.workspace.asks_own_instruction_change?, asks: asks_for_instructions %>

<section class="ui-group" aria-labelledby="sending_approvals">
  <h2 class="ui-group__title" id="sending_approvals">Sending approvals</h2>
  <ul class="ui-group__rows">
    <% Tool::AsksEverySend::SETTINGS.each do |tool_name, (flag, label)| %>
      <% source = @agent.workspace.asks_every_source(tool_name) %>
      <%= render "settings/switch_row", id: "agent_#{flag}", url: agent_path(@agent), on: source.present? || @agent.public_send(flag),
            param: "agent[#{flag}]", label: label, disabled: source.present?, note: ("Set for #{source}" if source) %>
      <%= render "agents/permissions/unasked", agent: @agent, tool_name: tool_name %>
    <% end %>
  </ul>
  <p class="ui-group__help">Each switch asks you before every send of that kind, even where this install approves everything. Saved recipient grants apply only when the send switch is off at every level. Concourse sends include replies to linked tasks. Campfire is unchanged.</p>
</section>
<% tool_settings = Tool::AsksEverySend::TOOL_SETTINGS %>
<% every_send = tool_settings.keys.select { @agent.asks_every_send?(it) } %>
<% required = every_send + (asks_for_instructions ? [ "change_yourself" ] : []) %>

<%# What asks however the person answered before: never "Always", and of those, what asks even where the install allows everything. -%>
<%# Tools looked up when needed (tool_search), its own or a connector's, count as much as those always ready. -%>
<% declared, lookup = @agent.toolset(@agent.conversation&.connectors || []) %>
<% offered = (@agent.own_tools + declared + lookup + Tool::Catalog::ALWAYS + Tool::Catalog::SAVED_SIGN_INS).uniq %>
<% asking = offered.reject { @agent.tool_off?(it.tool_name) || (it.tool_name == "change_yourself" && !asks_for_instructions) }
                   .select { it.respond_to?(:always?) && (it.asks == :approval || every_send.include?(it.tool_name)) } %>
<%# An "Always" from before its connector was set to ask before every write, which no longer counts. -%>
<% every_write = asking.flat_map { it.try(:members) || [ it ] }.select { it.try(:asks_every_write?) }.index_by(&:tool_name) %>
<%# What asks every time but for an "Always" with each of a call's recipients (Tool.always_with_recipients). -%>
<% scoped_tools = asking.select { it.try(:always_with_recipients?) && !it.always? && !every_send.include?(it.tool_name) } %>
<% scoped = scoped_tools.map { it.label.downcase_first } %>
<% scoped_line = "To #{scoped.to_sentence(two_words_connector: ' or ', last_word_connector: ', or ')} only an \"Always\" for every recipient of it, or for its chat, lets it go without asking; another recipient beside them asks." if scoped.any? %>
<% never = (asking - scoped_tools).select { !it.always? || required.include?(it.tool_name) }.map { it.label.downcase_first } %>
<% every_time = asking.select(&:every_time?).reject { it.even_approving_everything? || required.include?(it.tool_name) }.map { it.label.downcase_first } %>
<% regardless = asking.select { it.even_approving_everything? || required.include?(it.tool_name) }.map { it.label.downcase_first } %>
<% reaching = asking.select { it.try(:reaches_others?) }.reject { it.even_approving_everything? || required.include?(it.tool_name) }.map { it.label.downcase_first } %>
<% with_guests = asking.select { it.try(:asks_with_guests?) }.map { it.label.downcase_first } %>
<% guests_line = "To #{with_guests.to_sentence(two_words_connector: ' or ', last_word_connector: ', or ')} with guests other than you, or emailing guests, it asks every time too." if with_guests.any? %>
<% outside = asking.select { it.try(:asks_outside?) }.map { it.label.downcase_first } %>
<% outside_line = "To #{outside.to_sentence(two_words_connector: ' or ', last_word_connector: ', or ')} with anyone outside your own domain, or anyone with the link, it asks every time too." if outside.any? %>
<section class="ui-group" id="permissions" aria-labelledby="always_allowed">
  <h2 class="ui-group__title" id="always_allowed">Always allowed</h2>
  <% if @agent.permissions.any? %>
    <ul class="ui-group__rows">
      <% @agent.permissions.each do |permission| %>
        <% what = tool_label(permission.tool_name) %>
        <% whom = permission.every_call? ? "every time" : "with #{permission.recipient}" %>
        <% paused = every_write[permission.tool_name] %>
        <li class="ui-row" id="<%= dom_id(permission) %>">
          <span class="ui-row__label"><%= what.upcase_first %>
            <span class="ui-row__detail"><%= whom.upcase_first %> · added <%= l permission.created_at.to_date, format: :long %><%=
              if permission.tool_name == "change_yourself"
                " · not used: own-instruction approval is set separately"
              elsif permission.never_honoured?
                " · not used: it is only ever \"Always\" for a recipient"
              elsif every_send.include?(permission.tool_name)
                " · not used: #{@agent} is set to #{tool_settings.fetch(permission.tool_name).last.downcase_first}"
              elsif paused
                " · not used: #{paused.server} asks before every write"
              end %></span>
          </span>
          <span class="ui-row__value">
            <%= button_to "Remove", agent_permission_path(@agent, permission), method: :delete, class: "button", form_class: "inline",
                  data: { variant: "ghost", size: "sm", turbo_confirm: "Ask again before #{what} #{whom}?" }, aria: { label: "Remove: #{what} #{whom}" } %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="settings__empty">
      <p>Nothing yet. When <%= @agent.name %> asks to do something, answer "Always" to let it do that again without asking, and it shows here.</p>
      <%= link_to "Go to #{@agent.name}", conversation_path(@agent.conversation), class: "button" %>
    </div>
  <% end %>
  <%# Its approval policy: its workspace's, the install's where it chose none, or the install's for this agent (Agent#approvals). -%>
  <% policy = @agent.approvals %>
  <% whose = @agent.workspace.approval_policy && policy.name == @agent.workspace.approval_policy ? "Its workspace" : "This install" %>
  <p class="ui-group__help">
    <% if policy.everything? %>
      <%= whose %> approves everything: <%= @agent.name %> does all of it without asking you<%= ", even #{every_time.to_sentence}" if every_time.any? %>.
      <% if reaching.any? %>That includes what reaches other people or their accounts: <%= reaching.to_sentence %>.<% end %>
      <% if regardless.any? %>To <%= regardless.to_sentence %> it still asks every time.<% end %>
      <%= scoped_line %>
      <%= guests_line %>
      <%= outside_line %>
      Each call is still recorded in its thread. It still asks you its questions, and asks you to sign in where only you can.
    <% elsif policy.allow? %>
      <%= whose %> allows everything: <%= @agent.name %> does all of it without asking you, even what is never "Always".
      <% if (every_time + regardless).any? %>To <%= (every_time + regardless).to_sentence %> it still asks every time.<% end %>
      <%= scoped_line %>
      <%= guests_line %>
      <%= outside_line %>
      It still asks you its questions, and asks you to sign in where only you can.
    <% elsif policy.others? %>
      <%= whose %> asks first before what reaches other people<%= ": #{reaching.to_sentence}" if reaching.any? %> and before
      <%= @agent.name %> removes a routine. Own-instruction changes follow the setting above.
      <% if (every_time + regardless).any? %>To <%= (every_time + regardless).to_sentence %> it asks every time.<% end %>
      <%= scoped_line %>
      <%= guests_line %>
      <%= outside_line %>
      It still asks you its questions, and asks you to sign in where only you can.
    <% else %>
      Everything else that changes something outside <%= @agent.name %> asks you first. To <%= never.to_sentence %> it asks every time; these are never "Always".
      <%= scoped_line %>
    <% end %>
  </p>
</section>
