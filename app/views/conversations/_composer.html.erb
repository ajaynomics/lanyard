<%# The person's message box (shadcn: Prompt Input). Enter sends; Shift+Enter is a new line.
    While the agent works, Steer (and Enter) changes what it is doing now; Queue waits for it to finish.
    Pictures: the paperclip (on a phone it offers the camera and photos), paste, or drop onto the box.
    A message may be pictures alone.
    "/" at the start opens the list of commands, saved prompts and skills (command_menu_controller): Tab or a
    tap completes, the arrows move, Esc closes. Enter never picks from the list; it sends what is typed, a
    built-in command through its own form below. -%>
<%# Something shared from another app (Share) arrives as the draft, and its pictures are attached as if picked here,
    through the same checks (share.js); sending it lets the staged copies go (share_id). -%>
<%# locals: (conversation:, draft: nil, share: nil) -%>
<%= form_with url: conversation_submissions_path(conversation), id: "composer", class: "composer", multipart: true,
      data: { controller: "composer attachments command-menu", echo: true, composer_draft_key_value: "draft:#{conversation.id}",
              attachments_max_value: Conversation::IMAGES_PER_MESSAGE, attachments_bytes_value: Conversation::IMAGE_BYTES,
              action: "submit->composer#send paste->attachments#paste dragover->attachments#over dragleave->attachments#leave " \
                      "drop->attachments#drop turbo:submit-start->attachments#sent turbo:submit-end->attachments#settled" } do |form| %>
  <%= render "conversations/request_id" %>
  <% if share %>
    <%= hidden_field_tag :share_id, share.id, id: nil %>
    <%= javascript_import_module_tag "share" %>
    <%= tag.span hidden: true, data: { controller: "shared-pictures", shared_pictures_attachments_outlet: "#composer",
          shared_pictures_files_value: share.files.map { { url: rails_blob_path(it, disposition: :attachment, only_path: true), name: it.filename.to_s } } } %>
  <% end %>
  <p id="composer_error" class="composer__error" role="alert"></p>
  <div class="composer__attachments" data-attachments-target="list" hidden></div>
  <%= render "conversations/command_menu", conversation: conversation %>
  <div class="composer__row">
    <label class="button composer__attach" data-variant="ghost" data-size="icon" title="Attach pictures">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
      <span class="visually-hidden">Attach pictures</span>
      <%= form.file_field :images, multiple: true, accept: "image/*", class: "visually-hidden",
            data: { attachments_target: "input", action: "change->attachments#pick" } %>
    </label>
    <%# "Message" alone where the agent's name would wrap it on a phone (composer_controller). -%>
    <%= form.text_area :content, value: draft, rows: 1, placeholder: "Message #{conversation.agent}", class: "composer__input",
          aria: { label: "Message", autocomplete: "list", controls: "command_menu", expanded: "false" }, role: "combobox", autofocus: true,
          data: { composer_target: "input", command_menu_target: "input",
                  action: "keydown->command-menu#navigate keydown->composer#submitOnEnter keydown->composer#recall " \
                          "input->composer#resize input->composer#keepDraft input->command-menu#update blur->command-menu#close" } %>
    <%= form.button name: "when_busy", value: "followUp", class: "button composer__send composer__round",
          title: "Send (Enter). While #{conversation.agent} works: send when it has finished" do %>
      <span class="composer__idle"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg><span class="visually-hidden">Send</span></span><span class="composer__busy">Queue</span>
    <% end %>
    <%= form.button name: "when_busy", value: "steer", class: "button composer__steer composer__round", data: { composer_target: "steer" },
          aria: { label: "Steer" }, title: "Steer (Enter): tell #{conversation.agent} now, while it works" do %><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg><% end %>
    <%= button_tag type: "submit", form: "command_stop", class: "button composer__stop composer__round", aria: { label: "Stop" }, title: "Stop #{conversation.agent}" do %>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><rect x="5" y="5" width="14" height="14" rx="2.5"/></svg>
    <% end %>
  </div>
<% end %>

<%# The built-in commands' forms, which the composer fills in and submits. -%>
<div class="composer__commands" hidden>
  <%= form_with url: new_agent_path, method: :get, id: "command_new" do %><% end %>
  <%= form_with url: conversation_cancellations_path(conversation), id: "command_stop" do %>
    <%= hidden_field_tag :request_id, SecureRandom.uuid, id: nil %>
  <% end %>
  <%= form_with url: conversation_compactions_path(conversation), id: "command_compact" do %>
    <%= hidden_field_tag :request_id, SecureRandom.uuid, id: nil %>
    <%= hidden_field_tag :instructions, nil, id: nil, data: { command_argument: true } %>
  <% end %>
  <%# A download, not a page: Turbo stays out of it. -%>
  <%= form_with url: conversation_export_path(conversation, format: :jsonl), method: :get, id: "command_export", data: { turbo: false } do %><% end %>
  <% %w[ model thinking_level ].each do |field| %>
    <%= form_with model: conversation.agent, id: "command_#{field.delete_suffix('_level')}" do |form| %>
      <%= hidden_field_tag :command, field.delete_suffix("_level"), id: nil %>
      <%= form.hidden_field field, value: nil, id: nil, data: { command_argument: true } %>
    <% end %>
  <% end %>
</div>
